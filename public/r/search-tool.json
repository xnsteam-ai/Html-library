{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "search-tool",
  "title": "Search Tool",
  "description": "Grep-style results grouped by file, with line gutters, highlighted matches, and a search summary footer.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tool",
    "search",
    "results"
  ],
  "files": [
    {
      "path": "search-tool.html",
      "type": "html",
      "content": "<!--\n  Search Tool — results grouped by file, each group genuinely collapsible.\n  Native <details> per file; no JavaScript.\n-->\n<div class=\"mx-auto w-full max-w-2xl overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n  <div class=\"flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 dark:border-white/10 dark:bg-white/5\">\n    <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n    <code class=\"min-w-0 flex-1 truncate font-mono text-[12px] text-gray-800 dark:text-gray-200\">rg \"createSession\\(\" src/</code>\n    <span class=\"shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[10.5px] font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300\">4 matches</span>\n  </div>\n\n  <div class=\"divide-y divide-gray-100 dark:divide-white/5\">\n    <details open class=\"group/file\">\n      <summary class=\"flex cursor-pointer list-none items-center gap-2 px-3 py-1.5 transition hover:bg-gray-50 [&::-webkit-details-marker]:hidden dark:hover:bg-white/5\">\n        <svg class=\"h-3 w-3 text-gray-400 transition group-open/file:rotate-90 dark:text-gray-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <span class=\"font-mono text-[11.5px] text-gray-700 dark:text-gray-300\">src/server/session.ts</span>\n        <span class=\"text-[10.5px] text-gray-400 dark:text-gray-500\">2</span>\n      </summary>\n      <a href=\"#\" class=\"flex items-baseline gap-3 px-3 py-1 text-left transition hover:bg-gray-50 dark:hover:bg-white/5\">\n        <span class=\"w-8 shrink-0 text-right font-mono text-[11px] text-gray-300 dark:text-gray-600\">18</span>\n        <span class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">export function <mark class=\"rounded bg-yellow-100 px-0.5 text-gray-900 dark:bg-yellow-400/25 dark:text-yellow-100\">createSession(</mark>user: User) {</span>\n      </a>\n      <a href=\"#\" class=\"flex items-baseline gap-3 px-3 py-1 text-left transition hover:bg-gray-50 dark:hover:bg-white/5\">\n        <span class=\"w-8 shrink-0 text-right font-mono text-[11px] text-gray-300 dark:text-gray-600\">64</span>\n        <span class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">  const next = <mark class=\"rounded bg-yellow-100 px-0.5 text-gray-900 dark:bg-yellow-400/25 dark:text-yellow-100\">createSession(</mark>user)</span>\n      </a>\n    </details>\n\n    <details open class=\"group/file\">\n      <summary class=\"flex cursor-pointer list-none items-center gap-2 px-3 py-1.5 transition hover:bg-gray-50 [&::-webkit-details-marker]:hidden dark:hover:bg-white/5\">\n        <svg class=\"h-3 w-3 text-gray-400 transition group-open/file:rotate-90 dark:text-gray-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <span class=\"font-mono text-[11.5px] text-gray-700 dark:text-gray-300\">src/routes/login.ts</span>\n        <span class=\"text-[10.5px] text-gray-400 dark:text-gray-500\">1</span>\n      </summary>\n      <a href=\"#\" class=\"flex items-baseline gap-3 px-3 py-1 text-left transition hover:bg-gray-50 dark:hover:bg-white/5\">\n        <span class=\"w-8 shrink-0 text-right font-mono text-[11px] text-gray-300 dark:text-gray-600\">27</span>\n        <span class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">  const session = await <mark class=\"rounded bg-yellow-100 px-0.5 text-gray-900 dark:bg-yellow-400/25 dark:text-yellow-100\">createSession(</mark>user)</span>\n      </a>\n    </details>\n\n    <details class=\"group/file\">\n      <summary class=\"flex cursor-pointer list-none items-center gap-2 px-3 py-1.5 transition hover:bg-gray-50 [&::-webkit-details-marker]:hidden dark:hover:bg-white/5\">\n        <svg class=\"h-3 w-3 text-gray-400 transition group-open/file:rotate-90 dark:text-gray-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <span class=\"font-mono text-[11.5px] text-gray-700 dark:text-gray-300\">tests/session.test.ts</span>\n        <span class=\"text-[10.5px] text-gray-400 dark:text-gray-500\">1</span>\n      </summary>\n      <a href=\"#\" class=\"flex items-baseline gap-3 px-3 py-1 text-left transition hover:bg-gray-50 dark:hover:bg-white/5\">\n        <span class=\"w-8 shrink-0 text-right font-mono text-[11px] text-gray-300 dark:text-gray-600\">9</span>\n        <span class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">  it(\"rotates on <mark class=\"rounded bg-yellow-100 px-0.5 text-gray-900 dark:bg-yellow-400/25 dark:text-yellow-100\">createSession(</mark>)\", …</span>\n      </a>\n    </details>\n  </div>\n\n  <div class=\"border-t border-gray-200 px-3 py-1.5 dark:border-white/10\">\n    <span class=\"text-[11px] text-gray-400 dark:text-gray-500\">Searched 318 files in 0.12s</span>\n  </div>\n</div>\n"
    }
  ]
}
