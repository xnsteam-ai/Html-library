{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "empty-state",
  "title": "Empty State",
  "description": "A dashed placeholder with icon, copy and actions, plus a compact no-results row for search.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "empty",
    "placeholder",
    "zero-state"
  ],
  "files": [
    {
      "path": "empty-state.html",
      "type": "html",
      "content": "<!-- Empty State — full placeholder and a compact inline variant -->\n<div class=\"mx-auto w-full max-w-lg space-y-4\">\n  <div class=\"flex flex-col items-center rounded-xl border border-dashed border-gray-300 px-6 py-12 text-center dark:border-white/15\">\n    <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-gray-100 text-gray-400 dark:bg-white/10 dark:text-gray-600\">\n      <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7l2-3h14l2 3M3 7h18v12a2 2 0 01-2 2H5a2 2 0 01-2-2z\" /><path d=\"M9 12h6\" /></svg>\n    </span>\n    <h3 class=\"mt-3.5 text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">No components yet</h3>\n    <p class=\"mt-1 max-w-xs text-[13px] leading-relaxed text-gray-600 dark:text-gray-400\">\n      Add a folder under <code class=\"font-mono text-[12px]\">registry/</code> with a\n      <code class=\"font-mono text-[12px]\">component.html</code> and it shows up here.\n    </p>\n    <div class=\"mt-4 flex items-center gap-2\">\n      <button type=\"button\" class=\"rounded-lg bg-gray-900 px-3 py-1.5 text-[12.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Add a component</button>\n      <button type=\"button\" class=\"rounded-lg border border-gray-200 px-3 py-1.5 text-[12.5px] font-medium text-gray-700 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/10\">Read the docs</button>\n    </div>\n  </div>\n\n  <!-- Compact -->\n  <div class=\"flex items-center gap-3 rounded-xl border border-gray-200 px-3.5 py-3 dark:border-white/10\">\n    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400 dark:bg-white/10 dark:text-gray-600\">\n      <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n    </span>\n    <div class=\"min-w-0 flex-1\">\n      <p class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">No results for “drawer”</p>\n      <p class=\"text-[12px] text-gray-600 dark:text-gray-400\">Try a different name, or request it as an issue.</p>\n    </div>\n    <button type=\"button\" class=\"shrink-0 rounded-lg px-2.5 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10\">Clear</button>\n  </div>\n</div>\n"
    }
  ]
}
