{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "text-shimmer",
  "title": "Text Shimmer",
  "description": "A shimmering status label for pending work, plus a pulsing skeleton. Ships one scoped style block for the keyframes.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "loading",
    "animation",
    "status"
  ],
  "files": [
    {
      "path": "text-shimmer.html",
      "type": "html",
      "content": "<!--\n  Text Shimmer — animated \"thinking\" label.\n  Keyframes cannot be expressed as Tailwind utilities, so this file carries one\n  scoped <style> block. Class names are prefixed `hl-` to avoid collisions.\n-->\n<style>\n  @keyframes hl-shimmer {\n    0% {\n      background-position: 150% center;\n    }\n    100% {\n      background-position: -150% center;\n    }\n  }\n\n  .hl-shimmer {\n    background-size: 200% auto;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    animation: hl-shimmer 2.4s linear infinite;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hl-shimmer {\n      animation: none;\n    }\n  }\n</style>\n\n<div class=\"mx-auto flex w-full max-w-md flex-col items-start gap-4\">\n  <!-- With a pulsing glyph -->\n  <div class=\"flex items-center gap-2\">\n    <svg class=\"h-3.5 w-3.5 animate-pulse text-muted-foreground dark:text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1.5l1.6 8.9 6.3-4.8-4.8 6.3 8.9 1.6-8.9 1.6 4.8 6.3-6.3-4.8-1.6 8.9-1.6-8.9-6.3 4.8 4.8-6.3L-.5 13.5l8.9-1.6-4.8-6.3 6.3 4.8z\" /></svg>\n    <span class=\"hl-shimmer bg-gradient-to-r from-gray-400 via-gray-900 to-gray-400 text-[14px] font-medium dark:from-gray-600 dark:via-gray-100 dark:to-gray-600\">\n      Thinking…\n    </span>\n  </div>\n\n  <!-- Longer status line -->\n  <span class=\"hl-shimmer bg-gradient-to-r from-gray-400 via-gray-900 to-gray-400 text-[13px] dark:from-gray-600 dark:via-gray-100 dark:to-gray-600\">\n    Reading 12 files in src/server…\n  </span>\n\n  <!-- Skeleton shimmer using Tailwind's built-in pulse -->\n  <div class=\"w-full space-y-2\">\n    <div class=\"h-3 w-4/5 animate-pulse rounded bg-gray-200 dark:bg-white/10\"></div>\n    <div class=\"h-3 w-full animate-pulse rounded bg-gray-200 dark:bg-white/10\"></div>\n    <div class=\"h-3 w-2/3 animate-pulse rounded bg-gray-200 dark:bg-white/10\"></div>\n  </div>\n</div>\n"
    }
  ]
}
