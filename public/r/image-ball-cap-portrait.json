  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "portrait",
    "casual",
    "studio",
    "neutral"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Shoulder-length wavy auburn hair under a cap; head square, shoulders relaxed",
      "expression": "Neutral, level, unsmiling",
      "clothing": "Red and blue ball cap, white tee under a dark blazer"
    },
    "composition": {
      "shotType": "Medium close, head and shoulders",
      "angle": "Eye-level",
      "placement": "Centred",
      "distance": "Medium",
      "depthOfField": "Shallow; plain backdrop",
      "focus": "The eyes under the brim"
    },
    "framing": {
      "subjectScale": "Head and shoulders fill ~60% of frame width, lower two-thirds of height",
      "subjectBox": "Head x≈28–72%, y≈12–52%; shoulders widen to x≈8–92% by y≈75%",
      "anchors": "Eyeline at ~30% from top (partly shaded by the brim); chin ~48%",
      "edges": "Shoulders exit the bottom edge",
      "negativeSpace": "Upper ~12% clean grey backdrop as headroom"
    },
    "environment": {
      "setting": "Studio",
      "background": "Flat pale grey backdrop",
      "depth": "Subject only"
    },
    "lighting": {
      "quality": "Soft, even",
      "direction": "Broad frontal key, light fill",
      "temperature": "Neutral",
      "shadows": "Low contrast; soft brim shadow across the brow"
    },
    "camera": {
      "lens": "85mm",
      "quality": "Clean, natural skin tone, minimal grade",
      "artifacts": "None",
      "aesthetic": "Portrait, casual, neutral, studio"
    },
    "atmosphere": {
      "mood": "Plain and direct",
      "story": "A straightforward headshot in everyday clothes.",
      "micro": "Level gaze, no performance"
    }
  },
  "facets": {
    "style": "photo",
    "palette": "neutral",
    "subject": "people",
    "lighting": "soft",
    "aspect": 0.799
  },
  "files": [
    {
      "path": "image-ball-cap-portrait.html",
      "type": "html",
      "content": "<!--\n  Ball Cap Portrait — 959×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2081427511410614345-1.jpg\"\n    alt=\"Relaxed studio portrait in a ball cap and blazer\"\n    width=\"959\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Ball Cap Portrait · 959×1200</figcaption>\n</figure>\n"
    }
  ]
