{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "tool-group",
  "title": "Tool Group",
  "description": "A collapsible run of tool calls: summary header with stacked icons and timing, collapsed, expanded, and running children.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tool",
    "collapsible",
    "timeline"
  ],
  "files": [
    {
      "path": "tool-group.html",
      "type": "html",
      "content": "<!--\n  Tool Group — genuinely collapsible, no JavaScript.\n  Each level is a native <details>. The chevrons rotate via `group-open:`,\n  and the whole group collapses independently of its children.\n-->\n<details open class=\"group/run mx-auto w-full max-w-2xl overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n  <summary class=\"flex w-full cursor-pointer list-none items-center gap-2 bg-gray-50 px-3 py-2.5 text-left transition hover:bg-gray-100 [&::-webkit-details-marker]:hidden dark:bg-white/5 dark:hover:bg-white/10\">\n    <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-400 transition group-open/run:rotate-0 -rotate-90 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\" /></svg>\n    <span class=\"flex-1 text-[12.5px] font-medium text-gray-800 dark:text-gray-200\">Investigated the failing build</span>\n    <span class=\"flex -space-x-1\">\n      <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-white bg-gray-100 text-gray-600 dark:border-neutral-950 dark:bg-white/10 dark:text-gray-400\">\n        <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n      </span>\n      <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-white bg-gray-100 text-gray-600 dark:border-neutral-950 dark:bg-white/10 dark:text-gray-400\">\n        <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n      </span>\n      <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-white bg-gray-100 text-gray-600 dark:border-neutral-950 dark:bg-white/10 dark:text-gray-400\">\n        <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z\" /></svg>\n      </span>\n    </span>\n    <span class=\"shrink-0 text-[11px] text-gray-400 dark:text-gray-600\">3 steps · 8.1s</span>\n  </summary>\n\n  <div class=\"divide-y divide-gray-100 dark:divide-white/5\">\n    <!-- Child 1 -->\n    <details class=\"group/step\">\n      <summary class=\"flex w-full cursor-pointer list-none items-center gap-2.5 px-3 py-2 text-left transition hover:bg-gray-50 [&::-webkit-details-marker]:hidden dark:hover:bg-white/5\">\n        <svg class=\"h-3 w-3 shrink-0 text-gray-400 transition group-open/step:rotate-90 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-400 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n        <code class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">gh run view 41902 --log-failed</code>\n        <span class=\"shrink-0 text-[10.5px] text-gray-400 dark:text-gray-600\">1.4s</span>\n      </summary>\n      <pre class=\"mx-3 mb-2.5 overflow-x-auto rounded-lg bg-gray-50 px-3 py-2 font-mono text-[11px] leading-relaxed text-gray-600 dark:bg-white/5 dark:text-gray-400\">e2e  ✗ failed in 41s\n  Error: Unsupported engine for node@20.11.0</pre>\n    </details>\n\n    <!-- Child 2 -->\n    <details open class=\"group/step\">\n      <summary class=\"flex w-full cursor-pointer list-none items-center gap-2.5 px-3 py-2 text-left transition hover:bg-gray-50 [&::-webkit-details-marker]:hidden dark:hover:bg-white/5\">\n        <svg class=\"h-3 w-3 shrink-0 text-gray-400 transition group-open/step:rotate-90 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-400 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n        <code class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">rg \"engines\" package.json</code>\n        <span class=\"shrink-0 text-[10.5px] text-gray-400 dark:text-gray-600\">0.2s</span>\n      </summary>\n      <pre class=\"mx-3 mb-2.5 overflow-x-auto rounded-lg bg-gray-50 px-3 py-2 font-mono text-[11px] leading-relaxed text-gray-600 dark:bg-white/5 dark:text-gray-400\">14:  \"engines\": { \"node\": \"&gt;=20 &lt;22\" }</pre>\n    </details>\n\n    <!-- Running child -->\n    <div class=\"flex w-full items-center gap-2.5 px-3 py-2\">\n      <span class=\"h-3 w-3 shrink-0\"></span>\n      <span class=\"h-3.5 w-3.5 shrink-0 animate-spin rounded-full border-2 border-gray-200 border-t-gray-900 motion-reduce:animate-none dark:border-white/15 dark:border-t-white\"></span>\n      <code class=\"min-w-0 flex-1 truncate font-mono text-[11.5px] text-gray-600 dark:text-gray-400\">edit package.json</code>\n      <span class=\"shrink-0 text-[10.5px] text-gray-400 dark:text-gray-600\">running</span>\n    </div>\n  </div>\n</details>\n"
    }
  ]
}
