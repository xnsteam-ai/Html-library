{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "site-auth",
  "title": "Sign In",
  "description": "A split authentication page: social and credential sign-in with remember-me on one side, a dark testimonial panel with stats on the other.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "auth",
    "login",
    "split"
  ],
  "surface": "site",
  "files": [
    {
      "path": "site-auth.html",
      "type": "html",
      "content": "<!-- Site Auth — split sign-in page with testimonial panel, 1280×800 -->\r\n<div class=\"flex h-[800px] w-[1280px] overflow-hidden bg-white dark:bg-neutral-950\">\r\n  <!-- Form side -->\r\n  <div class=\"flex w-1/2 flex-col px-16 py-10\">\r\n    <span class=\"flex items-center gap-2\">\r\n      <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 text-[13px] font-bold text-white dark:bg-white dark:text-neutral-900\">H</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Halyard</span>\r\n    </span>\r\n\r\n    <div class=\"flex flex-1 flex-col justify-center\">\r\n      <div class=\"mx-auto w-full max-w-sm\">\r\n        <h1 class=\"text-[28px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Welcome back</h1>\r\n        <p class=\"mt-2 text-[14px] text-gray-500 dark:text-gray-400\">\r\n          Sign in to pick up where your team left off.\r\n        </p>\r\n\r\n        <!-- Social -->\r\n        <div class=\"mt-7 space-y-2.5\">\r\n          <button type=\"button\" class=\"flex w-full items-center justify-center gap-2.5 rounded-xl border border-gray-200 py-2.5 text-[14px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n            <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0012 2z\" /></svg>\r\n            Continue with GitHub\r\n          </button>\r\n          <button type=\"button\" class=\"flex w-full items-center justify-center gap-2.5 rounded-xl border border-gray-200 py-2.5 text-[14px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n            <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\" /><path d=\"M2 7l10 6 10-6\" /></svg>\r\n            Continue with email\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"my-6 flex items-center gap-3\">\r\n          <span class=\"h-px flex-1 bg-gray-200 dark:bg-white/10\"></span>\r\n          <span class=\"text-[12px] text-gray-400 dark:text-gray-500\">or</span>\r\n          <span class=\"h-px flex-1 bg-gray-200 dark:bg-white/10\"></span>\r\n        </div>\r\n\r\n        <!-- Credentials -->\r\n        <div class=\"space-y-4\">\r\n          <div>\r\n            <label for=\"auth-email\" class=\"mb-1.5 block text-[12.5px] font-medium text-gray-700 dark:text-gray-300\">Work email</label>\r\n            <input id=\"auth-email\" type=\"email\" placeholder=\"you@company.com\" class=\"w-full rounded-xl border border-gray-200 px-3.5 py-2.5 text-[14px] text-gray-900 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none dark:border-white/15 dark:bg-transparent dark:text-gray-100\" />\r\n          </div>\r\n          <div>\r\n            <div class=\"mb-1.5 flex items-baseline justify-between\">\r\n              <label for=\"auth-password\" class=\"text-[12.5px] font-medium text-gray-700 dark:text-gray-300\">Password</label>\r\n              <a href=\"#\" class=\"text-[12px] text-gray-500 dark:text-gray-400\">Forgot?</a>\r\n            </div>\r\n            <input id=\"auth-password\" type=\"password\" value=\"............\" class=\"w-full rounded-xl border border-gray-200 px-3.5 py-2.5 text-[14px] text-gray-900 focus:border-gray-400 focus:outline-none dark:border-white/15 dark:bg-transparent dark:text-gray-100\" />\r\n          </div>\r\n\r\n          <label class=\"flex items-center gap-2\">\r\n            <span class=\"flex h-4 w-4 items-center justify-center rounded border border-gray-900 bg-gray-900 dark:border-white dark:bg-white\">\r\n              <svg class=\"h-2.5 w-2.5 text-white dark:text-neutral-900\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            </span>\r\n            <span class=\"text-[13px] text-gray-600 dark:text-gray-300\">Keep me signed in for 30 days</span>\r\n          </label>\r\n\r\n          <button type=\"button\" class=\"w-full rounded-xl bg-gray-900 py-2.5 text-[14px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\r\n            Sign in\r\n          </button>\r\n        </div>\r\n\r\n        <p class=\"mt-6 text-center text-[13px] text-gray-500 dark:text-gray-400\">\r\n          New to Halyard?\r\n          <a href=\"#\" class=\"font-medium text-gray-900 underline underline-offset-2 dark:text-gray-100\">Create an account</a>\r\n        </p>\r\n      </div>\r\n    </div>\r\n\r\n    <p class=\"text-[11.5px] text-gray-400 dark:text-gray-500\">\r\n      By continuing you agree to the Terms and Privacy Policy.\r\n    </p>\r\n  </div>\r\n\r\n  <!-- Testimonial side -->\r\n  <div class=\"relative flex w-1/2 flex-col justify-between overflow-hidden bg-gray-900 p-16 dark:bg-neutral-900\">\r\n    <div class=\"absolute -right-16 -top-24 h-80 w-80 rounded-full bg-white/5\"></div>\r\n    <div class=\"absolute -bottom-28 -left-16 h-72 w-72 rounded-full bg-white/5\"></div>\r\n\r\n    <div class=\"relative\">\r\n      <span class=\"inline-flex rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium text-white/80\">Customer story</span>\r\n    </div>\r\n\r\n    <blockquote class=\"relative\">\r\n      <p class=\"text-[26px] font-medium leading-snug tracking-tight text-white\">\r\n        “We cut our release cycle from a fortnight to an afternoon. The preview URLs alone\r\n        replaced an entire staging environment.”\r\n      </p>\r\n      <footer class=\"mt-7 flex items-center gap-3\">\r\n        <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-white/15 text-[14px] font-semibold text-white\">TB</span>\r\n        <span>\r\n          <span class=\"block text-[14px] font-medium text-white\">Theo Baptiste</span>\r\n          <span class=\"block text-[12.5px] text-white/60\">VP Engineering, Northwind</span>\r\n        </span>\r\n      </footer>\r\n    </blockquote>\r\n\r\n    <div class=\"relative flex gap-10\">\r\n      <div>\r\n        <p class=\"text-[22px] font-semibold text-white\">14×</p>\r\n        <p class=\"text-[12px] text-white/60\">faster releases</p>\r\n      </div>\r\n      <div>\r\n        <p class=\"text-[22px] font-semibold text-white\">99.99%</p>\r\n        <p class=\"text-[12px] text-white/60\">deploy success</p>\r\n      </div>\r\n      <div>\r\n        <p class=\"text-[22px] font-semibold text-white\">3.2k</p>\r\n        <p class=\"text-[12px] text-white/60\">teams onboard</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\n"
    }
  ]
}
