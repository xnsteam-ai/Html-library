{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-casual-outdoor-portrait",
  "title": "Casual Outdoor Portrait",
  "description": "Relaxed outdoor portrait in casual streetwear",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "portrait",
    "casual",
    "lifestyle",
    "outdoor"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Head and shoulders turned slightly, long hair loose over one shoulder",
      "expression": "Warm, soft smile, eyes to camera",
      "clothing": "Light casual top; a small flower tucked at the ear"
    },
    "composition": {
      "shotType": "Medium close, head and shoulders",
      "angle": "Eye-level",
      "placement": "Centred",
      "distance": "Medium",
      "depthOfField": "Shallow; interior warm and soft behind",
      "focus": "The eyes"
    },
    "framing": {
      "subjectScale": "Head and shoulders fill ~55% of frame width, lower three-quarters",
      "subjectBox": "Head x≈28–72%, y≈12–55%; shoulders to x≈10–90% by y≈80%",
      "anchors": "Eyeline at ~30% from top; chin ~50%",
      "edges": "Shoulders exit the bottom edge",
      "negativeSpace": "Upper ~12% is soft warm interior"
    },
    "environment": {
      "setting": "Warm interior",
      "background": "Wooden and soft furnishing tones, unreadable detail",
      "depth": "Subject plus soft background"
    },
    "lighting": {
      "quality": "Soft, warm",
      "direction": "Window key from camera-left, gentle fill",
      "temperature": "Warm — amber ambient",
      "shadows": "Low contrast; soft modelling"
    },
    "camera": {
      "lens": "85mm",
      "quality": "Clean, warm, gently diffused grade",
      "artifacts": "Mild bloom",
      "aesthetic": "Portrait, warm, casual, natural light"
    },
    "atmosphere": {
      "mood": "Easy warmth",
      "story": "A relaxed portrait in a comfortable room.",
      "micro": "Genuine soft smile — nothing held"
    }
  },
  "files": [
    {
      "path": "image-casual-outdoor-portrait.html",
      "type": "html",
      "content": "<!--\n  Casual Outdoor Portrait — 900×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2053366127821254908-1.jpg\"\n    alt=\"Relaxed outdoor portrait in casual streetwear\"\n    width=\"900\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Casual Outdoor Portrait · 900×1200</figcaption>\n</figure>\n"
    }
  ]
}
