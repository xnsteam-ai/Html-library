      "path": "site-dashboard.html",
      "type": "html",
      "content": "<!-- Site Dashboard — app shell with sidebar, stat tiles, chart and table, 1280×800 -->\r\n<div class=\"flex h-[800px] w-[1280px] overflow-hidden bg-gray-50 dark:bg-neutral-950\">\r\n  <!-- Sidebar -->\r\n  <aside class=\"flex w-[228px] shrink-0 flex-col border-r border-gray-200 bg-white dark:border-white/10 dark:bg-neutral-900\">\r\n    <div class=\"flex items-center gap-2 px-5 py-4\">\r\n      <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 text-[13px] font-bold text-white dark:bg-white dark:text-neutral-900\">H</span>\r\n      <span class=\"text-[14.5px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Halyard</span>\r\n    </div>\r\n\r\n    <nav class=\"flex-1 space-y-0.5 px-3 py-2\">\r\n      <a href=\"#\" class=\"flex items-center gap-2.5 rounded-lg bg-gray-100 px-3 py-2 text-[13.5px] font-medium text-gray-900 dark:bg-white/10 dark:text-gray-100\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\" /><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\" /><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\" /><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\" /></svg>\r\n        Overview\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13.5px] text-gray-600 transition hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\r\n        Deployments\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13.5px] text-gray-600 transition hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\" /><path d=\"M7 15l4-4 3 3 5-6\" /></svg>\r\n        Analytics\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13.5px] text-gray-600 transition hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3\" /><path d=\"M2 20c0-3 3-5 7-5s7 2 7 5\" /><path d=\"M17 11h5M19.5 8.5v5\" /></svg>\r\n        Team\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13.5px] text-gray-600 transition hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\" /><path d=\"M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.7 1.7 0 008 19.4a1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H2a2 2 0 110-4h.1A1.7 1.7 0 004.6 8a1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V2a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H22a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z\" /></svg>\r\n        Settings\r\n      </a>\r\n    </nav>\r\n\r\n    <div class=\"flex items-center gap-2.5 border-t border-gray-200 px-4 py-3 dark:border-white/10\">\r\n      <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-violet-600 text-[12px] font-semibold text-white\">R</span>\r\n      <span class=\"min-w-0 flex-1\">\r\n        <span class=\"block truncate text-[13px] font-medium text-gray-900 dark:text-gray-100\">Rina Delgado</span>\r\n        <span class=\"block truncate text-[11px] text-gray-400 dark:text-gray-500\">Pro workspace</span>\r\n      </span>\r\n    </div>\r\n  </aside>\r\n\r\n  <!-- Main -->\r\n  <main class=\"flex-1 overflow-hidden\">\r\n    <header class=\"flex items-center justify-between border-b border-gray-200 bg-white px-7 py-4 dark:border-white/10 dark:bg-neutral-900\">\r\n      <div>\r\n        <h1 class=\"text-[18px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Overview</h1>\r\n        <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Last 30 days · production</p>\r\n      </div>\r\n      <div class=\"flex items-center gap-2\">\r\n        <button type=\"button\" class=\"rounded-lg border border-gray-200 px-3 py-1.5 text-[13px] font-medium text-gray-700 dark:border-white/15 dark:text-gray-200\">Export</button>\r\n        <button type=\"button\" class=\"rounded-lg bg-gray-900 px-3 py-1.5 text-[13px] font-medium text-white dark:bg-white dark:text-neutral-900\">New project</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"space-y-5 p-7\">\r\n      <!-- Stat tiles -->\r\n      <div class=\"grid grid-cols-4 gap-4\">\r\n        <div class=\"rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-neutral-900\">\r\n          <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Deployments</p>\r\n          <p class=\"mt-1 text-[24px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">1,284</p>\r\n          <p class=\"mt-1 flex items-center gap-1 text-[11.5px] font-medium text-emerald-600 dark:text-emerald-400\">\r\n            <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7M9 7h8v8\" /></svg>\r\n            18.2%\r\n          </p>\r\n        </div>\r\n        <div class=\"rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-neutral-900\">\r\n          <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Median build</p>\r\n          <p class=\"mt-1 text-[24px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">42s</p>\r\n          <p class=\"mt-1 flex items-center gap-1 text-[11.5px] font-medium text-emerald-600 dark:text-emerald-400\">\r\n            <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 7L7 17M15 17H7V9\" /></svg>\r\n            9.4%\r\n          </p>\r\n        </div>\r\n        <div class=\"rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-neutral-900\">\r\n          <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Success rate</p>\r\n          <p class=\"mt-1 text-[24px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">99.1%</p>\r\n          <p class=\"mt-1 text-[11.5px] text-gray-400 dark:text-gray-500\">11 failed runs</p>\r\n        </div>\r\n        <div class=\"rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-neutral-900\">\r\n          <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Bandwidth</p>\r\n          <p class=\"mt-1 text-[24px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">614 GB</p>\r\n          <div class=\"mt-2 h-1 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-white/10\">\r\n            <div class=\"h-full w-[61%] rounded-full bg-gray-900 dark:bg-white\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Chart -->\r\n      <div class=\"rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-neutral-900\">\r\n        <div class=\"mb-4 flex items-center justify-between\">\r\n          <h2 class=\"text-[14px] font-semibold text-gray-900 dark:text-gray-100\">Build duration</h2>\r\n          <div class=\"flex rounded-lg bg-gray-100 p-0.5 dark:bg-white/10\">\r\n            <span class=\"rounded-md px-2.5 py-1 text-[11.5px] text-gray-500 dark:text-gray-400\">7d</span>\r\n            <span class=\"rounded-md bg-white px-2.5 py-1 text-[11.5px] font-medium text-gray-900 shadow-sm dark:bg-neutral-800 dark:text-gray-100\">30d</span>\r\n            <span class=\"rounded-md px-2.5 py-1 text-[11.5px] text-gray-500 dark:text-gray-400\">90d</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"flex h-32 items-end gap-1.5\">\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 45%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 62%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 38%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 71%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 55%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 80%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 48%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 66%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 42%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 74%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-200 dark:bg-white/15\" style=\"height: 58%\"></span>\r\n          <span class=\"w-full rounded-t bg-gray-900 dark:bg-white\" style=\"height: 92%\"></span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Table -->\r\n      <div class=\"overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-neutral-900\">\r\n        <table class=\"w-full border-collapse text-left\">\r\n          <thead class=\"border-b border-gray-200 dark:border-white/10\">\r\n            <tr>\r\n              <th class=\"px-5 py-2.5 text-[11.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Branch</th>\r\n              <th class=\"px-5 py-2.5 text-[11.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Commit</th>\r\n              <th class=\"px-5 py-2.5 text-[11.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Duration</th>\r\n              <th class=\"px-5 py-2.5 text-[11.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Status</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody class=\"divide-y divide-gray-100 dark:divide-white/5\">\r\n            <tr>\r\n              <td class=\"px-5 py-2.5 text-[13px] font-medium text-gray-900 dark:text-gray-100\">main</td>\r\n              <td class=\"px-5 py-2.5 font-mono text-[12px] text-gray-500 dark:text-gray-400\">a91f3c2</td>\r\n              <td class=\"px-5 py-2.5 text-[13px] text-gray-600 dark:text-gray-300\">38s</td>\r\n              <td class=\"px-5 py-2.5\"><span class=\"rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">Ready</span></td>\r\n            </tr>\r\n            <tr>\r\n              <td class=\"px-5 py-2.5 text-[13px] font-medium text-gray-900 dark:text-gray-100\">feat/registry-cache</td>\r\n              <td class=\"px-5 py-2.5 font-mono text-[12px] text-gray-500 dark:text-gray-400\">7d40be1</td>\r\n              <td class=\"px-5 py-2.5 text-[13px] text-gray-600 dark:text-gray-300\">1m 04s</td>\r\n              <td class=\"px-5 py-2.5\"><span class=\"rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-400/10 dark:text-amber-300\">Building</span></td>\r\n            </tr>\r\n            <tr>\r\n              <td class=\"px-5 py-2.5 text-[13px] font-medium text-gray-900 dark:text-gray-100\">fix/e2e-node-22</td>\r\n              <td class=\"px-5 py-2.5 font-mono text-[12px] text-gray-500 dark:text-gray-400\">3ce9a08</td>\r\n              <td class=\"px-5 py-2.5 text-[13px] text-gray-600 dark:text-gray-300\">52s</td>\r\n              <td class=\"px-5 py-2.5\"><span class=\"rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-700 dark:bg-red-500/10 dark:text-red-400\">Failed</span></td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n  </main>\r\n</div>\n"
    }
  ]
