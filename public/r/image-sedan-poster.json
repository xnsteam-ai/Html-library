{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-sedan-poster",
  "title": "Sedan Poster",
  "description": "Studio automotive poster for a white sedan",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "poster",
    "automotive",
    "sedan",
    "product"
  ],
  "prompt": {
    "composition": {
      "shotType": "Automotive poster, three-quarter front",
      "angle": "Low, at wheel height",
      "placement": "Car lower-centre, wordmark large above",
      "distance": "Medium-far",
      "depthOfField": "Deep",
      "focus": "The grille and headlight"
    },
    "framing": {
      "subjectScale": "Car spans ~75% of frame width across the lower-middle band",
      "subjectBox": "Car x≈12–90%, y≈52–80%; wordmark x≈18–85%, y≈20–45%",
      "anchors": "Wordmark baseline at ~45%; car axis at ~65%",
      "edges": "Nothing cropped",
      "negativeSpace": "Top ~45% is type and flat blue field"
    },
    "environment": {
      "setting": "Studio / composite",
      "background": "Flat blue ground with a large wordmark",
      "depth": "Product plus typography"
    },
    "lighting": {
      "quality": "Soft with controlled speculars",
      "direction": "Broad overhead diffusion, edge light along the body",
      "temperature": "Cool blue with clean white bodywork",
      "shadows": "Moderate contrast; smooth gradients on the panels"
    },
    "camera": {
      "lens": "35mm automotive",
      "quality": "Clean, sharp, poster grade",
      "artifacts": "None",
      "aesthetic": "Poster, automotive, blue, brand"
    },
    "atmosphere": {
      "mood": "Composed",
      "story": "A saloon presented plainly and confidently."
    }
  },
  "files": [
    {
      "path": "image-sedan-poster.html",
      "type": "html",
      "content": "<!--\n  Sedan Poster — 900×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2059666896820277605-1.jpg\"\n    alt=\"Studio automotive poster for a white sedan\"\n    width=\"900\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Sedan Poster · 900×1200</figcaption>\n</figure>\n"
    }
  ]
}
