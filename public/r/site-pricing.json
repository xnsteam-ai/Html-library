    {
      "path": "site-pricing.html",
      "type": "html",
      "content": "<!-- Site Pricing — three tiers with billing toggle and FAQ strip, 1280×800 -->\n<div class=\"flex h-[800px] w-[1280px] flex-col justify-between overflow-hidden bg-white pb-8 dark:bg-neutral-950\">\n  <header class=\"flex items-center justify-between border-b border-gray-100 px-12 py-5 dark:border-white/5\">\n    <a href=\"#\" class=\"flex items-center gap-2 transition-all active:scale-95\">\n      <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--brand)] text-white\">\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      </span>\n      <span class=\"text-[15px] font-semibold tracking-tight text-foreground dark:text-gray-100\">Halyard</span>\n    </a>\n    <nav class=\"flex items-center gap-7\">\n      <a href=\"#\" class=\"text-[13.5px] text-muted-foreground transition-all hover:text-foreground active:scale-95 dark:text-muted-foreground dark:hover:text-gray-100\">Product</a>\n      <a href=\"#\" class=\"text-[13.5px] font-medium text-foreground transition-all active:scale-95 dark:text-gray-100\">Pricing</a>\n      <a href=\"#\" class=\"text-[13.5px] text-muted-foreground transition-all hover:text-foreground active:scale-95 dark:text-muted-foreground dark:hover:text-gray-100\">Docs</a>\n    </nav>\n    <a href=\"#\" class=\"rounded-lg bg-gray-900 px-3.5 py-2 text-[13.5px] font-medium text-white transition-all hover:bg-gray-800 active:scale-95 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Start free</a>\n  </header>\n\n  <div class=\"group/pricing mx-auto w-full max-w-6xl\">\n    <input type=\"radio\" name=\"site-pricing-billing\" id=\"site-pricing-monthly\" class=\"sr-only\" checked />\n    <input type=\"radio\" name=\"site-pricing-billing\" id=\"site-pricing-yearly\" class=\"sr-only\" />\n\n  <section class=\"px-12 pt-12 text-center\">\n    <h1 class=\"text-[38px] font-semibold tracking-[-0.02em] text-foreground dark:text-gray-100\">Simple, predictable pricing</h1>\n    <p class=\"mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n      Every plan includes unlimited preview deploys. Upgrade when your team does.\n    </p>\n\n    <!-- Billing toggle -->\n    <div class=\"mt-7 inline-flex items-center gap-3\">\n      <div class=\"flex rounded-full bg-gray-100 p-[3px] dark:bg-white/10\" role=\"radiogroup\" aria-label=\"Billing period\">\n        <label for=\"site-pricing-monthly\" class=\"cursor-pointer rounded-full px-4 py-1.5 text-[13px] font-medium text-muted-foreground transition-all active:scale-95 group-has-[#site-pricing-monthly:checked]/pricing:bg-white group-has-[#site-pricing-monthly:checked]/pricing:text-foreground group-has-[#site-pricing-monthly:checked]/pricing:shadow-sm dark:text-muted-foreground dark:group-has-[#site-pricing-monthly:checked]/pricing:bg-neutral-900 dark:group-has-[#site-pricing-monthly:checked]/pricing:text-gray-100\">Monthly</label>\n        <label for=\"site-pricing-yearly\" class=\"cursor-pointer rounded-full px-4 py-1.5 text-[13px] font-medium text-muted-foreground transition-all active:scale-95 group-has-[#site-pricing-yearly:checked]/pricing:bg-white group-has-[#site-pricing-yearly:checked]/pricing:text-foreground group-has-[#site-pricing-yearly:checked]/pricing:shadow-sm dark:text-muted-foreground dark:group-has-[#site-pricing-yearly:checked]/pricing:bg-neutral-900 dark:group-has-[#site-pricing-yearly:checked]/pricing:text-gray-100\">Yearly</label>\n      </div>\n      <span class=\"rounded-full bg-emerald-50 px-2.5 py-1 text-[11.5px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">Save 20%</span>\n    </div>\n  </section>\n\n  <!-- Tiers -->\n  <section class=\"mt-10 grid grid-cols-3 gap-5 px-12\">\n    <!-- Free -->\n    <div class=\"rounded-2xl border border-gray-200 p-6 text-center dark:border-white/10\">\n      <h2 class=\"text-[15px] font-semibold text-foreground dark:text-gray-100\">Hobby</h2>\n      <p class=\"mt-1 text-[13px] text-muted-foreground dark:text-muted-foreground\">For side projects and experiments.</p>\n      <p class=\"mt-5 flex items-baseline justify-center gap-1\">\n        <span class=\"text-[36px] font-semibold tracking-tight text-foreground dark:text-gray-100\">$0</span>\n        <span class=\"text-[13px] text-muted-foreground dark:text-muted-foreground\">/month</span>\n      </p>\n      <a href=\"#\" class=\"mt-5 block w-full rounded-xl border border-gray-200 py-2.5 text-center text-[13.5px] font-medium text-foreground transition-all hover:bg-gray-50 active:scale-95 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\n        Get started\n      </a>\n      <ul class=\"mx-auto mt-6 w-fit space-y-2.5 text-left\">\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          1 concurrent build\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          100 GB bandwidth\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          Community support\n        </li>\n      </ul>\n    </div>\n\n    <!-- Pro (featured) -->\n    <div class=\"relative rounded-2xl border-2 border-[var(--brand)] p-6 text-center shadow-sm\">\n      <span class=\"absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[var(--brand)] px-2.5 py-1 text-[11px] font-medium text-white\">Most popular</span>\n      <h2 class=\"text-[15px] font-semibold text-foreground dark:text-gray-100\">Pro</h2>\n      <p class=\"mt-1 text-[13px] text-muted-foreground dark:text-muted-foreground\">For teams shipping every day.</p>\n      <p class=\"mt-5 flex items-baseline justify-center gap-1\">\n        <span class=\"hidden text-[36px] font-semibold tracking-tight text-foreground group-has-[#site-pricing-monthly:checked]/pricing:inline dark:text-gray-100\">$24</span>\n        <span class=\"hidden text-[36px] font-semibold tracking-tight text-foreground group-has-[#site-pricing-yearly:checked]/pricing:inline dark:text-gray-100\">$19</span>\n        <span class=\"text-[13px] text-muted-foreground dark:text-muted-foreground\">/user /month</span>\n      </p>\n      <a href=\"#\" class=\"mt-5 block w-full rounded-xl bg-[var(--brand)] py-2.5 text-center text-[13.5px] font-medium text-white transition-all hover:opacity-90 active:scale-95\">\n        Start 14-day trial\n      </a>\n      <ul class=\"mx-auto mt-6 w-fit space-y-2.5 text-left\">\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          12 concurrent builds\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          1 TB bandwidth\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          Performance budgets\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          Priority support\n        </li>\n      </ul>\n    </div>\n\n    <!-- Enterprise -->\n    <div class=\"rounded-2xl border border-gray-200 p-6 text-center dark:border-white/10\">\n      <h2 class=\"text-[15px] font-semibold text-foreground dark:text-gray-100\">Enterprise</h2>\n      <p class=\"mt-1 text-[13px] text-muted-foreground dark:text-muted-foreground\">Compliance, SSO and a named contact.</p>\n      <p class=\"mt-5 flex items-baseline justify-center gap-1\">\n        <span class=\"text-[36px] font-semibold tracking-tight text-foreground dark:text-gray-100\">Custom</span>\n      </p>\n      <a href=\"#\" class=\"mt-5 block w-full rounded-xl border border-gray-200 py-2.5 text-center text-[13.5px] font-medium text-foreground transition-all hover:bg-gray-50 active:scale-95 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\n        Talk to sales\n      </a>\n      <ul class=\"mx-auto mt-6 w-fit space-y-2.5 text-left\">\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          Unlimited builds\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          SAML SSO &amp; audit log\n        </li>\n        <li class=\"flex gap-2.5 text-[13px] text-muted-foreground dark:text-muted-foreground\">\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-foreground dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n          99.99% uptime SLA\n        </li>\n      </ul>\n    </div>\n  </section>\n\n  </div>\n\n  <!-- FAQ strip -->\n  <section class=\"mx-auto flex w-full max-w-6xl items-center justify-between border-t border-gray-100 px-12 pt-6 dark:border-white/5\">\n    <p class=\"text-[13.5px] text-muted-foreground dark:text-muted-foreground\">\n      Questions about migrating an existing pipeline?\n    </p>\n    <a href=\"#\" class=\"text-[13.5px] font-medium text-foreground underline underline-offset-4 transition-all hover:text-muted-foreground active:scale-95 dark:text-gray-100 dark:hover:text-muted-foreground\">Read the FAQ</a>\n  </section>\n</div>\n"
    }
  ]
