    {
      "path": "site-pricing.html",
      "type": "html",
      "content": "<!-- Site Pricing — three tiers with billing toggle and FAQ strip, 1280×800 -->\r\n<div class=\"h-[800px] w-[1280px] overflow-hidden bg-white dark:bg-neutral-950\">\r\n  <header class=\"flex items-center justify-between border-b border-gray-100 px-12 py-5 dark:border-white/5\">\r\n    <span class=\"flex items-center gap-2\">\r\n      <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 text-[13px] font-bold text-white dark:bg-white dark:text-neutral-900\">H</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Halyard</span>\r\n    </span>\r\n    <nav class=\"flex items-center gap-7\">\r\n      <a href=\"#\" class=\"text-[13.5px] text-gray-600 dark:text-gray-400\">Product</a>\r\n      <a href=\"#\" class=\"text-[13.5px] font-medium text-gray-900 dark:text-gray-100\">Pricing</a>\r\n      <a href=\"#\" class=\"text-[13.5px] text-gray-600 dark:text-gray-400\">Docs</a>\r\n    </nav>\r\n    <a href=\"#\" class=\"rounded-lg bg-gray-900 px-3.5 py-2 text-[13.5px] font-medium text-white dark:bg-white dark:text-neutral-900\">Start free</a>\r\n  </header>\r\n\r\n  <section class=\"px-12 pt-12 text-center\">\r\n    <h1 class=\"text-[38px] font-semibold tracking-[-0.02em] text-gray-900 dark:text-gray-100\">Simple, predictable pricing</h1>\r\n    <p class=\"mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n      Every plan includes unlimited preview deploys. Upgrade when your team does.\r\n    </p>\r\n\r\n    <!-- Billing toggle -->\r\n    <div class=\"mt-7 inline-flex items-center gap-3\">\r\n      <div class=\"flex rounded-full bg-gray-100 p-[3px] dark:bg-white/10\">\r\n        <span class=\"rounded-full px-4 py-1.5 text-[13px] font-medium text-gray-500 dark:text-gray-400\">Monthly</span>\r\n        <span class=\"rounded-full bg-white px-4 py-1.5 text-[13px] font-medium text-gray-900 shadow-sm dark:bg-neutral-900 dark:text-gray-100\">Yearly</span>\r\n      </div>\r\n      <span class=\"rounded-full bg-emerald-50 px-2.5 py-1 text-[11.5px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">Save 20%</span>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Tiers -->\r\n  <section class=\"mt-10 grid grid-cols-3 gap-5 px-12\">\r\n    <!-- Free -->\r\n    <div class=\"rounded-2xl border border-gray-200 p-6 dark:border-white/10\">\r\n      <h2 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Hobby</h2>\r\n      <p class=\"mt-1 text-[13px] text-gray-500 dark:text-gray-400\">For side projects and experiments.</p>\r\n      <p class=\"mt-5 flex items-baseline gap-1\">\r\n        <span class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">$0</span>\r\n        <span class=\"text-[13px] text-gray-500 dark:text-gray-400\">/month</span>\r\n      </p>\r\n      <a href=\"#\" class=\"mt-5 block rounded-xl border border-gray-200 py-2.5 text-center text-[13.5px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n        Get started\r\n      </a>\r\n      <ul class=\"mt-6 space-y-2.5\">\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          1 concurrent build\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          100 GB bandwidth\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          Community support\r\n        </li>\r\n      </ul>\r\n    </div>\r\n\r\n    <!-- Pro (featured) -->\r\n    <div class=\"relative rounded-2xl border-2 border-gray-900 p-6 dark:border-white\">\r\n      <span class=\"absolute -top-3 left-6 rounded-full bg-gray-900 px-2.5 py-1 text-[11px] font-medium text-white dark:bg-white dark:text-neutral-900\">Most popular</span>\r\n      <h2 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Pro</h2>\r\n      <p class=\"mt-1 text-[13px] text-gray-500 dark:text-gray-400\">For teams shipping every day.</p>\r\n      <p class=\"mt-5 flex items-baseline gap-1\">\r\n        <span class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">$24</span>\r\n        <span class=\"text-[13px] text-gray-500 dark:text-gray-400\">/user /month</span>\r\n      </p>\r\n      <a href=\"#\" class=\"mt-5 block rounded-xl bg-gray-900 py-2.5 text-center text-[13.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\r\n        Start 14-day trial\r\n      </a>\r\n      <ul class=\"mt-6 space-y-2.5\">\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          12 concurrent builds\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          1 TB bandwidth\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          Performance budgets\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          Priority support\r\n        </li>\r\n      </ul>\r\n    </div>\r\n\r\n    <!-- Enterprise -->\r\n    <div class=\"rounded-2xl border border-gray-200 p-6 dark:border-white/10\">\r\n      <h2 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Enterprise</h2>\r\n      <p class=\"mt-1 text-[13px] text-gray-500 dark:text-gray-400\">Compliance, SSO and a named contact.</p>\r\n      <p class=\"mt-5 flex items-baseline gap-1\">\r\n        <span class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Custom</span>\r\n      </p>\r\n      <a href=\"#\" class=\"mt-5 block rounded-xl border border-gray-200 py-2.5 text-center text-[13.5px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n        Talk to sales\r\n      </a>\r\n      <ul class=\"mt-6 space-y-2.5\">\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          Unlimited builds\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          SAML SSO &amp; audit log\r\n        </li>\r\n        <li class=\"flex gap-2.5 text-[13px] text-gray-600 dark:text-gray-300\">\r\n          <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n          99.99% uptime SLA\r\n        </li>\r\n      </ul>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FAQ strip -->\r\n  <section class=\"mt-10 flex items-center justify-between border-t border-gray-100 px-12 pt-6 dark:border-white/5\">\r\n    <p class=\"text-[13.5px] text-gray-500 dark:text-gray-400\">\r\n      Questions about migrating an existing pipeline?\r\n    </p>\r\n    <a href=\"#\" class=\"text-[13.5px] font-medium text-gray-900 underline underline-offset-4 dark:text-gray-100\">Read the FAQ</a>\r\n  </section>\r\n</div>\n"
    }
  ]
}
