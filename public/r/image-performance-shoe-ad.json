{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-performance-shoe-ad",
  "title": "Performance Shoe Ad",
  "description": "High-contrast running shoe advertisement with bold display type",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "poster",
    "product",
    "footwear",
    "sport"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Runner mid-stride, body angled into the run",
      "expression": "Not readable at poster scale",
      "clothing": "Full running kit"
    },
    "composition": {
      "shotType": "Poster, figure plus product with dominant type",
      "angle": "Slightly low",
      "placement": "Figure upper, product and type stacked below",
      "distance": "Medium-far",
      "depthOfField": "Deep",
      "focus": "The shoe"
    },
    "environment": {
      "setting": "Graphic field",
      "background": "Flat saturated orange-red ground, heavy display lettering",
      "depth": "Subject plus typography"
    },
    "lighting": {
      "quality": "Hard, graphic",
      "direction": "Frontal key with strong separation",
      "temperature": "Very warm — single-hue orange",
      "shadows": "High contrast; clean cut-out edges"
    },
    "camera": {
      "lens": "35mm cut-out",
      "quality": "Poster-flat, high-saturation print grade",
      "artifacts": "None",
      "aesthetic": "Poster, footwear, sport, bold type"
    },
    "atmosphere": {
      "mood": "Driving",
      "story": "A running shoe sold on forward motion."
    }
  },
  "files": [
    {
      "path": "image-performance-shoe-ad.html",
      "type": "html",
      "content": "<!--\n  Performance Shoe Ad — 960×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2029294395384574292-1.jpg\"\n    alt=\"High-contrast running shoe advertisement with bold display type\"\n    width=\"960\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Performance Shoe Ad · 960×1200</figcaption>\n</figure>\n"
    }
  ]
}
