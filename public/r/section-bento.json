{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-bento",
  "title": "Bento Grid",
  "description": "A mixed-size feature grid: one large panel with a bar chart, three supporting tiles, and a wide closing tile.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "bento",
    "features",
    "grid"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-bento.html",
      "type": "html",
      "content": "<!-- Bento Section — mixed-size feature grid -->\n<section class=\"w-full bg-white px-6 py-24 dark:bg-neutral-950\">\n  <div class=\"mx-auto max-w-5xl\">\n    <div class=\"mx-auto max-w-xl text-center\">\n      <h2 class=\"text-[36px] font-semibold leading-tight tracking-[-0.02em] text-gray-900 dark:text-gray-100\">\n        Built for how you actually ship\n      </h2>\n      <p class=\"mt-4 text-[15.5px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n        Every panel is a real feature, not a screenshot of one.\n      </p>\n    </div>\n\n    <div class=\"mt-12 grid grid-cols-1 gap-4 md:grid-cols-3 md:grid-rows-2\">\n      <!-- Large tile -->\n      <div class=\"relative flex flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-7 md:col-span-2 md:row-span-2 dark:border-white/10 dark:bg-white/5\">\n        <div>\n          <h3 class=\"text-[18px] font-semibold text-gray-900 dark:text-gray-100\">Live build graph</h3>\n          <p class=\"mt-2 max-w-xs text-[13.5px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            Watch every step run in real time, with logs streaming as they happen.\n          </p>\n        </div>\n        <div class=\"mt-8 flex h-32 items-end gap-1.5\">\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 40%\"></span>\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 65%\"></span>\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 50%\"></span>\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 80%\"></span>\n          <span class=\"w-full rounded-t bg-gray-900 dark:bg-white\" style=\"height: 100%\"></span>\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 55%\"></span>\n          <span class=\"w-full rounded-t bg-gray-300 dark:bg-white/20\" style=\"height: 70%\"></span>\n        </div>\n      </div>\n\n      <!-- Small tile -->\n      <div class=\"rounded-2xl border border-gray-200 p-6 dark:border-white/10\">\n        <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n        </span>\n        <h3 class=\"mt-3.5 text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Preview per branch</h3>\n        <p class=\"mt-1.5 text-[13px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n          A shareable URL, ready before review starts.\n        </p>\n      </div>\n\n      <!-- Small tile with mini chart -->\n      <div class=\"rounded-2xl border border-gray-200 p-6 dark:border-white/10\">\n        <h3 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">99.99% uptime</h3>\n        <p class=\"mt-1.5 text-[13px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n          Across every region, every month.\n        </p>\n        <div class=\"mt-4 h-1.5 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-white/10\">\n          <div class=\"h-full w-[99%] rounded-full bg-emerald-500\"></div>\n        </div>\n      </div>\n\n      <!-- Wide tile -->\n      <div class=\"flex items-center justify-between rounded-2xl border border-gray-200 p-6 md:col-span-2 dark:border-white/10\">\n        <div>\n          <h3 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">One config, every environment</h3>\n          <p class=\"mt-1.5 max-w-xs text-[13px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            Staging and production stay identical by construction.\n          </p>\n        </div>\n        <span class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16M4 4h10l6 6v4\" /><path d=\"M14 4v6h6\" /></svg>\n        </span>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
