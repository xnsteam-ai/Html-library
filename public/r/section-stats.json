  "files": [
    {
      "path": "section-stats.html",
      "type": "html",
      "content": "<!-- Stats Section — a four-up metric row on a dark band -->\r\n<section class=\"w-full bg-gray-900 px-6 py-20 dark:bg-neutral-900\">\r\n  <div class=\"mx-auto max-w-5xl\">\r\n    <div class=\"mx-auto max-w-lg text-center\">\r\n      <h2 class=\"text-[28px] font-semibold tracking-tight text-white\">Numbers, not adjectives</h2>\r\n      <p class=\"mt-3 text-[14.5px] leading-relaxed text-white/50\">\r\n        Pulled from the last 90 days across every workspace on the platform.\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"mt-12 grid grid-cols-2 gap-8 md:grid-cols-4\">\r\n      <div class=\"text-center\">\r\n        <p class=\"text-[36px] font-semibold tracking-tight text-white\">14×</p>\r\n        <p class=\"mt-1 text-[13px] text-white/50\">Faster releases</p>\r\n      </div>\r\n      <div class=\"text-center\">\r\n        <p class=\"text-[36px] font-semibold tracking-tight text-white\">99.99%</p>\r\n        <p class=\"mt-1 text-[13px] text-white/50\">Deploy success rate</p>\r\n      </div>\r\n      <div class=\"text-center\">\r\n        <p class=\"text-[36px] font-semibold tracking-tight text-white\">3.2k</p>\r\n        <p class=\"mt-1 text-[13px] text-white/50\">Teams onboard</p>\r\n      </div>\r\n      <div class=\"text-center\">\r\n        <p class=\"text-[36px] font-semibold tracking-tight text-white\">42s</p>\r\n        <p class=\"mt-1 text-[13px] text-white/50\">Median build time</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\n"
    }
  ]
}
