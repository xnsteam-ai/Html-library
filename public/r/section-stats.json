  "files": [
    {
      "path": "section-stats.html",
      "type": "html",
      "content": "<!-- Stats Section — a four-up metric row -->\n<section class=\"w-full bg-white px-6 py-20 dark:bg-neutral-900\">\n  <div class=\"mx-auto max-w-5xl\">\n    <div class=\"mx-auto max-w-lg text-center\">\n      <h2 class=\"text-[28px] font-semibold tracking-tight text-gray-900 dark:text-white\">Numbers, not adjectives</h2>\n      <p class=\"mt-3 text-[14.5px] leading-relaxed text-gray-600 dark:text-white/50\">\n        Pulled from the last 90 days across every workspace on the platform.\n      </p>\n    </div>\n\n    <div class=\"mt-12 grid grid-cols-2 gap-8 md:grid-cols-4\">\n      <div class=\"text-center\">\n        <p class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-white\">14×</p>\n        <p class=\"mt-1 text-[13px] text-gray-600 dark:text-white/50\">Faster releases</p>\n      </div>\n      <div class=\"text-center\">\n        <p class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-white\">99.99%</p>\n        <p class=\"mt-1 text-[13px] text-gray-600 dark:text-white/50\">Deploy success rate</p>\n      </div>\n      <div class=\"text-center\">\n        <p class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-white\">3.2k</p>\n        <p class=\"mt-1 text-[13px] text-gray-600 dark:text-white/50\">Teams onboard</p>\n      </div>\n      <div class=\"text-center\">\n        <p class=\"text-[36px] font-semibold tracking-tight text-gray-900 dark:text-white\">42s</p>\n        <p class=\"mt-1 text-[13px] text-gray-600 dark:text-white/50\">Median build time</p>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
