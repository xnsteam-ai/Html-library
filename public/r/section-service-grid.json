{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-service-grid",
  "title": "Service Grid",
  "description": "A 2×2 directory of service categories, each a pastel panel with tag pills and an Explore footer, above a filter header with a live status dot.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "services",
    "directory",
    "cards",
    "grid"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-service-grid.html",
      "type": "html",
      "content": "<!--\n  Service Grid — a 2×2 directory of service categories.\n  Each card pairs a pastel panel (title, blurb, tag pills) with an \"Explore\"\n  footer. The tag pills and arrow are real buttons but carry no handlers, so\n  the section stays static markup.\n-->\n<section class=\"w-full bg-[#e3e7f0] py-16 dark:bg-neutral-950\">\n  <div class=\"mx-auto w-full max-w-5xl px-6\">\n    <!-- Header -->\n    <header class=\"mb-8 flex flex-col items-center justify-between gap-4 border-b border-slate-300/60 pb-6 sm:flex-row dark:border-white/10\">\n      <div>\n        <div class=\"mb-1 flex items-center gap-2\">\n          <span class=\"inline-block h-2.5 w-2.5 animate-pulse rounded-full bg-emerald-500 motion-reduce:animate-none\"></span>\n          <span class=\"text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400\">Directory Services</span>\n        </div>\n        <h2 class=\"text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100\">\n          Explore Professional Services\n        </h2>\n      </div>\n      <div class=\"w-full sm:w-auto\">\n        <div class=\"relative sm:w-64\">\n          <svg class=\"absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n          </svg>\n          <label for=\"sg-filter\" class=\"sr-only\">Filter services</label>\n          <input\n            id=\"sg-filter\"\n            type=\"text\"\n            placeholder=\"Filter tags or services…\"\n            class=\"w-full rounded-xl border border-slate-300/80 bg-white/80 py-2 pl-9 pr-4 text-sm shadow-sm outline-none transition-all placeholder:text-slate-400 focus:border-slate-800 focus:ring-2 focus:ring-slate-800/20 dark:border-white/15 dark:bg-white/5 dark:text-slate-100\"\n          />\n        </div>\n      </div>\n    </header>\n\n    <!-- 2×2 grid -->\n    <div class=\"grid w-full grid-cols-1 gap-5 sm:gap-6 md:grid-cols-2\">\n      <!-- Web Design -->\n      <div class=\"group flex flex-col justify-between rounded-[28px] border border-slate-100/80 bg-white p-3.5 shadow-sm transition-all duration-300 hover:shadow-xl sm:p-4 dark:border-white/10 dark:bg-neutral-900\">\n        <div class=\"flex min-h-[250px] flex-col justify-between rounded-[22px] bg-[#e2f2fe] p-6 transition-transform duration-300 group-hover:scale-[0.995] sm:p-7\">\n          <div>\n            <h3 class=\"mb-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[28px]\">Web Design</h3>\n            <p class=\"mb-6 max-w-xs text-sm font-normal leading-snug text-slate-700 sm:text-[15px]\">\n              Crafts engaging, user-friendly websites.\n            </p>\n          </div>\n          <div class=\"mt-auto flex flex-wrap gap-2.5\">\n            <button type=\"button\" class=\"rounded-full bg-[#c3e4ff] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Landing Page</button>\n            <button type=\"button\" class=\"rounded-full bg-[#c3e4ff] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Website</button>\n            <button type=\"button\" class=\"rounded-full bg-[#c3e4ff] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">One Page</button>\n          </div>\n        </div>\n        <div class=\"mt-1 flex items-center justify-between px-3 py-2.5\">\n          <span class=\"text-lg font-bold text-slate-900 dark:text-slate-100\">Explore</span>\n          <button type=\"button\" aria-label=\"Explore Web Design\" class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100/90 text-slate-900 shadow-sm transition-all duration-200 hover:bg-slate-900 hover:text-white group-hover:bg-slate-900 group-hover:text-white dark:bg-white/10 dark:text-slate-100\">\n            <svg class=\"h-5 w-5 stroke-[2.2]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n\n      <!-- Graphic Design -->\n      <div class=\"group flex flex-col justify-between rounded-[28px] border border-slate-100/80 bg-white p-3.5 shadow-sm transition-all duration-300 hover:shadow-xl sm:p-4 dark:border-white/10 dark:bg-neutral-900\">\n        <div class=\"flex min-h-[250px] flex-col justify-between rounded-[22px] bg-[#fdebd8] p-6 transition-transform duration-300 group-hover:scale-[0.995] sm:p-7\">\n          <div>\n            <h3 class=\"mb-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[28px]\">Graphic Design</h3>\n            <p class=\"mb-6 max-w-xs text-sm font-normal leading-snug text-slate-700 sm:text-[15px]\">\n              Creates impactful visuals and branding.\n            </p>\n          </div>\n          <div class=\"mt-auto flex flex-wrap gap-2.5\">\n            <button type=\"button\" class=\"rounded-full bg-[#fcd3b2] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Packaging</button>\n            <button type=\"button\" class=\"rounded-full bg-[#fcd3b2] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Brand Identity</button>\n            <button type=\"button\" class=\"rounded-full bg-[#fcd3b2] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Illustrations</button>\n            <button type=\"button\" class=\"rounded-full bg-[#fcd3b2] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Logo</button>\n          </div>\n        </div>\n        <div class=\"mt-1 flex items-center justify-between px-3 py-2.5\">\n          <span class=\"text-lg font-bold text-slate-900 dark:text-slate-100\">Explore</span>\n          <button type=\"button\" aria-label=\"Explore Graphic Design\" class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100/90 text-slate-900 shadow-sm transition-all duration-200 hover:bg-slate-900 hover:text-white group-hover:bg-slate-900 group-hover:text-white dark:bg-white/10 dark:text-slate-100\">\n            <svg class=\"h-5 w-5 stroke-[2.2]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n\n      <!-- Developers -->\n      <div class=\"group flex flex-col justify-between rounded-[28px] border border-slate-100/80 bg-white p-3.5 shadow-sm transition-all duration-300 hover:shadow-xl sm:p-4 dark:border-white/10 dark:bg-neutral-900\">\n        <div class=\"flex min-h-[250px] flex-col justify-between rounded-[22px] bg-[#ece3f7] p-6 transition-transform duration-300 group-hover:scale-[0.995] sm:p-7\">\n          <div>\n            <h3 class=\"mb-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[28px]\">Developers</h3>\n            <p class=\"mb-6 max-w-xs text-sm font-normal leading-snug text-slate-700 sm:text-[15px]\">\n              Builds functional and scalable solutions.\n            </p>\n          </div>\n          <div class=\"mt-auto flex flex-wrap gap-2.5\">\n            <button type=\"button\" class=\"rounded-full bg-[#decdf8] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Web Applications</button>\n            <button type=\"button\" class=\"rounded-full bg-[#decdf8] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Mobile Apps</button>\n            <button type=\"button\" class=\"rounded-full bg-[#decdf8] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Database</button>\n            <button type=\"button\" class=\"rounded-full bg-[#decdf8] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Add-ons</button>\n          </div>\n        </div>\n        <div class=\"mt-1 flex items-center justify-between px-3 py-2.5\">\n          <span class=\"text-lg font-bold text-slate-900 dark:text-slate-100\">Explore</span>\n          <button type=\"button\" aria-label=\"Explore Developers\" class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100/90 text-slate-900 shadow-sm transition-all duration-200 hover:bg-slate-900 hover:text-white group-hover:bg-slate-900 group-hover:text-white dark:bg-white/10 dark:text-slate-100\">\n            <svg class=\"h-5 w-5 stroke-[2.2]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n\n      <!-- Copywriting -->\n      <div class=\"group flex flex-col justify-between rounded-[28px] border border-slate-100/80 bg-white p-3.5 shadow-sm transition-all duration-300 hover:shadow-xl sm:p-4 dark:border-white/10 dark:bg-neutral-900\">\n        <div class=\"flex min-h-[250px] flex-col justify-between rounded-[22px] bg-[#dcf3e8] p-6 transition-transform duration-300 group-hover:scale-[0.995] sm:p-7\">\n          <div>\n            <h3 class=\"mb-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[28px]\">Copywriting</h3>\n            <p class=\"mb-6 max-w-xs text-sm font-normal leading-snug text-slate-700 sm:text-[15px]\">\n              Delivers persuasive and creative content.\n            </p>\n          </div>\n          <div class=\"mt-auto flex flex-wrap gap-2.5\">\n            <button type=\"button\" class=\"rounded-full bg-[#b3e8d0] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Blog Posts</button>\n            <button type=\"button\" class=\"rounded-full bg-[#b3e8d0] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Video Scripts</button>\n            <button type=\"button\" class=\"rounded-full bg-[#b3e8d0] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Sales Pages</button>\n            <button type=\"button\" class=\"rounded-full bg-[#b3e8d0] px-3.5 py-1.5 text-xs font-medium text-slate-800 transition-all hover:bg-slate-900 hover:text-white sm:text-[13px]\">Slogans</button>\n          </div>\n        </div>\n        <div class=\"mt-1 flex items-center justify-between px-3 py-2.5\">\n          <span class=\"text-lg font-bold text-slate-900 dark:text-slate-100\">Explore</span>\n          <button type=\"button\" aria-label=\"Explore Copywriting\" class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100/90 text-slate-900 shadow-sm transition-all duration-200 hover:bg-slate-900 hover:text-white group-hover:bg-slate-900 group-hover:text-white dark:bg-white/10 dark:text-slate-100\">\n            <svg class=\"h-5 w-5 stroke-[2.2]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
