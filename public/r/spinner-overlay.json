{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "spinner-overlay",
  "title": "Spinner Overlay",
  "description": "A blocking loading overlay with a spinner and label over blurred underlying content.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "spinner",
    "loading",
    "overlay"
  ],
  "files": [
    {
      "path": "spinner-overlay.html",
      "type": "html",
      "content": "<!-- Spinner Overlay — Fluent UI style loading overlay, restored with its own scoped theme -->\n<style>\n  .fso-root { --bg-app: #f5f5f5; --bg-surface: #ffffff; --text-primary: #242424; --border-color: #e0e0e0; --fluent-brand: #0f6cbd; --fluent-brand-alpha: rgba(15, 108, 189, 0.2); }\n  .dark .fso-root { --bg-app: #292929; --bg-surface: #333333; --text-primary: #ffffff; --border-color: #424242; --fluent-brand: #479ef5; --fluent-brand-alpha: rgba(71, 158, 245, 0.2); }\n  @keyframes fso-spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }\n  .fso-root .fso-ring { border: 2.5px solid var(--fluent-brand-alpha); border-top-color: var(--fluent-brand); border-radius: 50%; animation: fso-spin 1.3s cubic-bezier(0.53, 0.21, 0.29, 0.67) infinite; }\n</style>\n\n<div class=\"fso-root relative mx-auto w-full max-w-2xl overflow-hidden rounded-lg bg-[var(--bg-app)] p-6\">\n  <div class=\"grid grid-cols-2 gap-6 opacity-40 blur-[2px]\">\n    <div class=\"h-32 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)]\"></div>\n    <div class=\"h-32 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)]\"></div>\n    <div class=\"col-span-2 h-32 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)]\"></div>\n  </div>\n\n  <div class=\"absolute inset-0 flex items-center justify-center bg-[var(--bg-app)]/60 backdrop-blur-sm\">\n    <div class=\"flex flex-col items-center gap-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] px-10 py-8 shadow-lg\">\n      <div class=\"fso-ring h-9 w-9\"></div>\n      <span class=\"text-[13px] font-medium text-[var(--text-primary)]\">Loading data...</span>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
