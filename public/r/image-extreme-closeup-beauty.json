{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-extreme-closeup-beauty",
  "title": "Extreme Close-Up Beauty",
  "description": "Extreme close-up beauty portrait focused on the eyes and skin",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "portrait",
    "beauty",
    "close-up",
    "editorial"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Face filling the frame, hair pulled back, head square to camera",
      "expression": "Neutral, lips closed, direct",
      "clothing": "None visible — bare-skin beauty crop"
    },
    "composition": {
      "shotType": "Extreme close-up, brow to chin",
      "angle": "Eye-level, dead-on",
      "placement": "Centred, symmetrical",
      "distance": "Intimate",
      "depthOfField": "Shallow; ears and hairline soften",
      "focus": "The irises"
    },
    "environment": {
      "setting": "Studio",
      "background": "Flat neutral ground, barely visible",
      "depth": "Subject only"
    },
    "lighting": {
      "quality": "Soft, broad beauty light",
      "direction": "Frontal key above with fill below — twin catchlights",
      "temperature": "Neutral, true-to-skin",
      "shadows": "Low contrast; even, luminous skin"
    },
    "camera": {
      "lens": "100mm macro-leaning",
      "quality": "Extremely high skin and iris detail, natural texture retained",
      "artifacts": "None",
      "aesthetic": "Beauty, macro, natural, clean"
    },
    "atmosphere": {
      "mood": "Unflinching neutrality",
      "story": "A face recorded as accurately as possible.",
      "micro": "No performance at all — stillness is the point"
    }
  },
  "files": [
    {
      "path": "image-extreme-closeup-beauty.html",
      "type": "html",
      "content": "<!--\n  Extreme Close-Up Beauty — 709×1024 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2077207193120891224-1.jpg\"\n    alt=\"Extreme close-up beauty portrait focused on the eyes and skin\"\n    width=\"709\"\n    height=\"1024\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Extreme Close-Up Beauty · 709×1024</figcaption>\n</figure>\n"
    }
  ]
}
