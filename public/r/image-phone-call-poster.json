{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-phone-call-poster",
  "title": "Phone Call Poster",
  "description": "Red-toned product poster of a subject mid phone call",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "poster",
    "product",
    "tech",
    "portrait"
  ],
  "prompt": {
    "subject": {
      "age": "Adult male, apparent 30s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Half figure, phone held up beside the head, other hand gesturing",
      "expression": "Animated, mid-speech",
      "clothing": "Dark jacket over a light shirt"
    },
    "composition": {
      "shotType": "Poster, half figure plus product inset",
      "angle": "Eye-level",
      "placement": "Figure right, product render and type left",
      "distance": "Medium",
      "depthOfField": "Deep",
      "focus": "The phone product render"
    },
    "framing": {
      "subjectScale": "Figure occupies right ~50%; product and type the left",
      "subjectBox": "Figure x≈48–95%, y≈25–100%; device render x≈15–45%, y≈35–75%; wordmark x≈8–60%, y≈8–25%",
      "anchors": "Wordmark baseline at ~25%; device centre ~55%",
      "edges": "Figure exits the bottom edge",
      "negativeSpace": "Orange field carries the margins"
    },
    "environment": {
      "setting": "Studio / graphic composite",
      "background": "Saturated orange ground with large display type",
      "depth": "Subject plus product and typography"
    },
    "lighting": {
      "quality": "Soft key against a flat ground",
      "direction": "Frontal diffusion, light rim",
      "temperature": "Very warm — orange dominant",
      "shadows": "Moderate contrast; clean product speculars"
    },
    "camera": {
      "lens": "50mm",
      "quality": "Clean, saturated, advertising grade",
      "artifacts": "None",
      "aesthetic": "Poster, product, advertising, warm"
    },
    "atmosphere": {
      "mood": "Busy and current",
      "story": "A phone sold mid-conversation."
    }
  },
  "files": [
    {
      "path": "image-phone-call-poster.html",
      "type": "html",
      "content": "<!--\n  Phone Call Poster — 960×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2051135855889387697-1.jpg\"\n    alt=\"Red-toned product poster of a subject mid phone call\"\n    width=\"960\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Phone Call Poster · 960×1200</figcaption>\n</figure>\n"
    }
  ]
}
