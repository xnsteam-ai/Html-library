      "path": "section-team.html",
      "type": "html",
      "content": "<!-- Team Section — a four-up bio grid -->\n<section class=\"w-full bg-white px-6 py-24 dark:bg-neutral-950\">\n  <div class=\"mx-auto max-w-5xl\">\n    <div class=\"mx-auto max-w-lg text-center\">\n      <h2 class=\"text-[34px] font-semibold leading-tight tracking-[-0.02em] text-gray-900 dark:text-gray-100\">\n        The people behind the pipeline\n      </h2>\n      <p class=\"mt-4 text-[15px] leading-relaxed text-gray-500 dark:text-gray-400\">\n        Fourteen engineers, three time zones, one on-call rotation nobody dreads.\n      </p>\n    </div>\n\n    <div class=\"mt-12 grid grid-cols-2 gap-8 md:grid-cols-4\">\n      <div class=\"text-center\">\n        <span class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-indigo-500 text-[20px] font-semibold text-white\">EK</span>\n        <h3 class=\"mt-3.5 text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">Elena Koch</h3>\n        <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Co-founder, CEO</p>\n      </div>\n      <div class=\"text-center\">\n        <span class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-sky-500 to-cyan-500 text-[20px] font-semibold text-white\">TB</span>\n        <h3 class=\"mt-3.5 text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">Theo Baptiste</h3>\n        <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Co-founder, CTO</p>\n      </div>\n      <div class=\"text-center\">\n        <span class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-[20px] font-semibold text-white\">MR</span>\n        <h3 class=\"mt-3.5 text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">Marta Ruiz</h3>\n        <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Staff Engineer</p>\n      </div>\n      <div class=\"text-center\">\n        <span class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 text-[20px] font-semibold text-white\">PA</span>\n        <h3 class=\"mt-3.5 text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">Priya Anand</h3>\n        <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Design Engineering</p>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
