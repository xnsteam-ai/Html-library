{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "site-docs",
  "title": "Documentation",
  "description": "A three-column docs layout: search bar with shortcut, grouped nav, article with breadcrumb, code block, callout and options table, plus an on-this-page rail.",
  "category": "apps",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "docs",
    "layout",
    "reference"
  ],
  "surface": "site",
  "files": [
    {
      "path": "site-docs.html",
      "type": "html",
      "content": "<!-- Site Docs — three-column documentation layout, 1280×800 -->\n<div class=\"flex h-[800px] w-[1280px] flex-col overflow-hidden bg-white dark:bg-neutral-950\">\n  <!-- Top bar -->\n  <header class=\"flex items-center gap-6 border-b border-gray-200 px-6 py-3 dark:border-white/10\">\n    <span class=\"flex items-center gap-2\">\n      <span class=\"flex h-6 w-6 items-center justify-center rounded-md bg-gray-900 text-[11px] font-bold text-white dark:bg-white dark:text-neutral-900\">H</span>\n      <span class=\"text-[14px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Halyard docs</span>\n    </span>\n    <div class=\"relative w-72\">\n      <svg class=\"pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n      <input type=\"search\" placeholder=\"Search docs\" aria-label=\"Search docs\" class=\"w-full rounded-lg bg-gray-100 py-1.5 pl-8 pr-12 text-[13px] text-gray-900 placeholder:text-gray-400 focus:outline-none dark:bg-white/10 dark:text-gray-100\" />\n      <kbd class=\"absolute right-2 top-1/2 -translate-y-1/2 rounded border border-gray-200 px-1.5 font-mono text-[10px] text-gray-400 dark:border-white/15\">⌘K</kbd>\n    </div>\n    <nav class=\"ml-auto flex items-center gap-5\">\n      <a href=\"#\" class=\"text-[13px] text-gray-600 dark:text-gray-400\">Guides</a>\n      <a href=\"#\" class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Reference</a>\n      <a href=\"#\" class=\"text-[13px] text-gray-600 dark:text-gray-400\">Changelog</a>\n    </nav>\n  </header>\n\n  <div class=\"flex flex-1 overflow-hidden\">\n    <!-- Nav -->\n    <aside class=\"w-[220px] shrink-0 space-y-5 overflow-hidden border-r border-gray-200 px-5 py-5 dark:border-white/10\">\n      <div>\n        <p class=\"mb-1.5 text-[11px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Getting started</p>\n        <ul class=\"space-y-0.5\">\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">Introduction</a></li>\n          <li><a href=\"#\" class=\"block rounded-md bg-gray-100 px-2 py-1 text-[13px] font-medium text-gray-900 dark:bg-white/10 dark:text-gray-100\">Configuration</a></li>\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">Deployments</a></li>\n        </ul>\n      </div>\n      <div>\n        <p class=\"mb-1.5 text-[11px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Reference</p>\n        <ul class=\"space-y-0.5\">\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">CLI</a></li>\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">REST API</a></li>\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">Webhooks</a></li>\n          <li><a href=\"#\" class=\"block rounded-md px-2 py-1 text-[13px] text-gray-600 dark:text-gray-400\">Environment vars</a></li>\n        </ul>\n      </div>\n    </aside>\n\n    <!-- Article -->\n    <article class=\"flex-1 overflow-hidden px-10 py-8\">\n      <nav class=\"mb-3 flex items-center gap-1.5 text-[12px] text-gray-400 dark:text-gray-500\">\n        <span>Getting started</span>\n        <svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n        <span class=\"text-gray-600 dark:text-gray-300\">Configuration</span>\n      </nav>\n\n      <h1 class=\"text-[30px] font-semibold tracking-[-0.02em] text-gray-900 dark:text-gray-100\">Configuration</h1>\n      <p class=\"mt-3 max-w-2xl text-[15px] leading-relaxed text-gray-600 dark:text-gray-300\">\n        Halyard reads a single <code class=\"rounded bg-gray-100 px-1 py-0.5 font-mono text-[13.5px] text-gray-800 dark:bg-white/10 dark:text-gray-200\">halyard.config.ts</code>\n        at the root of your repository. Every field is optional — the defaults cover most projects.\n      </p>\n\n      <h2 class=\"mt-8 text-[18px] font-semibold text-gray-900 dark:text-gray-100\">Minimal example</h2>\n      <div class=\"mt-3 max-w-2xl overflow-hidden rounded-lg border border-gray-200 dark:border-white/10\">\n        <div class=\"flex items-center justify-between border-b border-gray-200 bg-gray-50 px-3 py-1.5 dark:border-white/10 dark:bg-white/5\">\n          <span class=\"font-mono text-[11px] text-gray-500 dark:text-gray-400\">halyard.config.ts</span>\n          <span class=\"text-[11px] text-gray-400 dark:text-gray-500\">Copy</span>\n        </div>\n        <pre class=\"overflow-x-auto p-3.5 font-mono text-[12.5px] leading-relaxed text-gray-800 dark:text-gray-200\"><code>export default {\n  build: { command: \"npm run build\", output: \"dist\" },\n  previews: { perBranch: true },\n}</code></pre>\n      </div>\n\n      <div class=\"mt-5 max-w-2xl rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5\">\n        <p class=\"flex gap-2 text-[13px] leading-relaxed text-gray-600 dark:text-gray-300\">\n          <svg class=\"mt-0.5 h-4 w-4 shrink-0 text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 16v-4M12 8h.01\" /></svg>\n          Config changes take effect on the next deploy — running builds keep the settings they started with.\n        </p>\n      </div>\n\n      <h2 class=\"mt-8 text-[18px] font-semibold text-gray-900 dark:text-gray-100\">Options</h2>\n      <div class=\"mt-3 max-w-2xl overflow-hidden rounded-lg border border-gray-200 dark:border-white/10\">\n        <table class=\"w-full border-collapse text-left\">\n          <thead class=\"bg-gray-50 dark:bg-white/5\">\n            <tr>\n              <th class=\"px-3.5 py-2 text-[12px] font-medium text-gray-600 dark:text-gray-300\">Field</th>\n              <th class=\"px-3.5 py-2 text-[12px] font-medium text-gray-600 dark:text-gray-300\">Type</th>\n              <th class=\"px-3.5 py-2 text-[12px] font-medium text-gray-600 dark:text-gray-300\">Default</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-gray-100 dark:divide-white/5\">\n            <tr>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-800 dark:text-gray-200\">build.command</td>\n              <td class=\"px-3.5 py-2 text-[12.5px] text-gray-500 dark:text-gray-400\">string</td>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-500 dark:text-gray-400\">\"npm run build\"</td>\n            </tr>\n            <tr>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-800 dark:text-gray-200\">build.output</td>\n              <td class=\"px-3.5 py-2 text-[12.5px] text-gray-500 dark:text-gray-400\">string</td>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-500 dark:text-gray-400\">\"dist\"</td>\n            </tr>\n            <tr>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-800 dark:text-gray-200\">previews.perBranch</td>\n              <td class=\"px-3.5 py-2 text-[12.5px] text-gray-500 dark:text-gray-400\">boolean</td>\n              <td class=\"px-3.5 py-2 font-mono text-[12px] text-gray-500 dark:text-gray-400\">true</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </article>\n\n    <!-- On this page -->\n    <aside class=\"w-[200px] shrink-0 px-5 py-8\">\n      <p class=\"mb-2 text-[11px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">On this page</p>\n      <ul class=\"space-y-1.5 border-l border-gray-200 dark:border-white/10\">\n        <li><a href=\"#\" class=\"-ml-px block border-l-2 border-gray-900 pl-3 text-[12.5px] font-medium text-gray-900 dark:border-white dark:text-gray-100\">Minimal example</a></li>\n        <li><a href=\"#\" class=\"-ml-px block border-l-2 border-transparent pl-3 text-[12.5px] text-gray-500 dark:text-gray-400\">Options</a></li>\n        <li><a href=\"#\" class=\"-ml-px block border-l-2 border-transparent pl-3 text-[12.5px] text-gray-500 dark:text-gray-400\">Environment overrides</a></li>\n      </ul>\n    </aside>\n  </div>\n</div>\n"
    }
  ]
}
