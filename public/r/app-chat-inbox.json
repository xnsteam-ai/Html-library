      "content": "<!-- App Chat Inbox — conversation list with search and unread states, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-white dark:bg-neutral-950\">\n <!-- Header -->\n <header class=\"px-5 pb-2 pt-2\">\n <div class=\"flex items-center justify-between\">\n <h1 class=\"text-[26px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Messages</h1>\n <button type=\"button\" class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-900 text-white dark:bg-white dark:text-neutral-900\" aria-label=\"New message\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\" /></svg>\n </button>\n </div>\n <div class=\"relative mt-3\">\n <svg class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n <input type=\"search\" placeholder=\"Search\" aria-label=\"Search messages\" class=\"w-full rounded-xl bg-gray-100 py-2.5 pl-9 pr-3 text-[14px] text-gray-900 placeholder:text-gray-500 dark:text-gray-400 focus:outline-none dark:bg-white/10 dark:text-gray-100 dark:placeholder:text-gray-500 dark:text-gray-400\" />\n </div>\n </header>\n\n <!-- Pinned -->\n <div class=\"px-5 pb-2 pt-2\">\n <p class=\"mb-2 text-[11.5px] font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400\">Pinned</p>\n <div class=\"flex gap-4\">\n <div class=\"flex flex-col items-center gap-1.5\">\n <span class=\"relative flex h-14 w-14 shrink-0\">\n <img src=\"https://i.pravatar.cc/112?img=32\" alt=\"Dana\" class=\"h-14 w-14 rounded-full object-cover\" />\n <span class=\"absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500 dark:border-neutral-950\"></span>\n </span>\n <span class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">Dana</span>\n </div>\n <div class=\"flex flex-col items-center gap-1.5\">\n <img src=\"https://i.pravatar.cc/112?img=59\" alt=\"Theo Baptiste\" class=\"h-14 w-14 rounded-full object-cover\" />\n <span class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">Theo</span>\n </div>\n <div class=\"flex flex-col items-center gap-1.5\">\n <span class=\"flex h-14 w-14 items-center justify-center rounded-full bg-violet-100 text-[16px] font-semibold text-violet-700 dark:bg-violet-500/20 dark:text-violet-300\">#</span>\n <span class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">design</span>\n </div>\n </div>\n </div>\n\n <!-- Conversations -->\n <ul class=\"flex-1 divide-y divide-gray-100 overflow-hidden dark:divide-white/5\">\n <li class=\"flex items-center gap-3 bg-gray-50 px-5 py-3 dark:bg-white/5\">\n <img src=\"https://i.pravatar.cc/88?img=16\" alt=\"Marta Ruiz\" class=\"h-11 w-11 shrink-0 rounded-full object-cover\" />\n <span class=\"min-w-0 flex-1\">\n <span class=\"flex items-baseline justify-between gap-2\">\n <span class=\"truncate text-[14.5px] font-semibold text-gray-900 dark:text-gray-100\">Marta Ruiz</span>\n <span class=\"shrink-0 text-[11.5px] text-gray-900 dark:text-gray-100\">09:32</span>\n </span>\n <span class=\"mt-0.5 flex items-center gap-2\">\n <span class=\"truncate text-[13px] font-medium text-gray-900 dark:text-gray-200\">Can you take a look at the migration before standup?</span>\n <span class=\"flex h-5 min-w-[20px] shrink-0 items-center justify-center rounded-full bg-gray-900 px-1.5 text-[10.5px] font-semibold text-white dark:bg-white dark:text-neutral-900\">3</span>\n </span>\n </span>\n </li>\n\n <li class=\"flex items-center gap-3 px-5 py-3\">\n <span class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gray-100 text-[13px] font-semibold text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-400\">#</span>\n <span class=\"min-w-0 flex-1\">\n <span class=\"flex items-baseline justify-between gap-2\">\n <span class=\"truncate text-[14.5px] font-medium text-gray-900 dark:text-gray-100\">design-review</span>\n <span class=\"shrink-0 text-[11.5px] text-gray-500 dark:text-gray-400\">08:55</span>\n </span>\n <span class=\"mt-0.5 block truncate text-[13px] text-gray-500 dark:text-gray-400\">Theo: pushed the revised spacing scale 👀</span>\n </span>\n </li>\n\n <li class=\"flex items-center gap-3 px-5 py-3\">\n <img src=\"https://i.pravatar.cc/88?img=45\" alt=\"Priya Anand\" class=\"h-11 w-11 shrink-0 rounded-full object-cover\" />\n <span class=\"min-w-0 flex-1\">\n <span class=\"flex items-baseline justify-between gap-2\">\n <span class=\"truncate text-[14.5px] font-medium text-gray-900 dark:text-gray-100\">Priya Anand</span>\n <span class=\"shrink-0 text-[11.5px] text-gray-500 dark:text-gray-400\">Yesterday</span>\n </span>\n <span class=\"mt-0.5 flex items-center gap-1.5\">\n <svg class=\"h-3 w-3 shrink-0 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 7L9 18l-4-4\" /><path d=\"M22 7l-9 11\" /></svg>\n <span class=\"truncate text-[13px] text-gray-500 dark:text-gray-400\">Sounds good — shipping it today</span>\n </span>\n </span>\n </li>\n\n <li class=\"flex items-center gap-3 px-5 py-3\">\n <img src=\"https://i.pravatar.cc/88?img=12\" alt=\"Jonas Klein\" class=\"h-11 w-11 shrink-0 rounded-full object-cover\" />\n <span class=\"min-w-0 flex-1\">\n <span class=\"flex items-baseline justify-between gap-2\">\n <span class=\"truncate text-[14.5px] font-medium text-gray-900 dark:text-gray-100\">Jonas Klein</span>\n <span class=\"shrink-0 text-[11.5px] text-gray-500 dark:text-gray-400\">Tuesday</span>\n </span>\n <span class=\"mt-0.5 block truncate text-[13px] text-gray-500 dark:text-gray-400\">Voice message · 0:42</span>\n </span>\n </li>\n\n <li class=\"flex items-center gap-3 px-5 py-3\">\n <img src=\"https://i.pravatar.cc/88?img=25\" alt=\"Sam Nakamura\" class=\"h-11 w-11 shrink-0 rounded-full object-cover\" />\n <span class=\"min-w-0 flex-1\">\n <span class=\"flex items-baseline justify-between gap-2\">\n <span class=\"truncate text-[14.5px] font-medium text-gray-900 dark:text-gray-100\">Sam Nakamura</span>\n <span class=\"shrink-0 text-[11.5px] text-gray-500 dark:text-gray-400\">Mar 11</span>\n </span>\n <span class=\"mt-0.5 block truncate text-[13px] text-gray-500 dark:text-gray-400\">Thanks for the review!</span>\n </span>\n </li>\n </ul>\n\n <!-- Tab bar -->\n <nav class=\"border-t border-gray-200 px-6 pb-5 pt-2.5 dark:border-white/10\">\n <div class=\"flex items-center justify-between\">\n <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-900 dark:text-gray-100\">\n <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M4 4h16a2 2 0 012 2v9a2 2 0 01-2 2H9l-5 4V6a2 2 0 012-2z\" /></svg>\n <span class=\"text-[10px] font-medium\">Chats</span>\n </button>\n <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-500 dark:text-gray-400\">\n <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 7v5l3 2\" /></svg>\n <span class=\"text-[10px]\">Calls</span>\n </button>\n <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-500 dark:text-gray-400\">\n <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.5\" /><path d=\"M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6\" /></svg>\n <span class=\"text-[10px]\">Contacts</span>\n </button>\n </div>\n </nav>\n</div>\n"
    }
  ]
