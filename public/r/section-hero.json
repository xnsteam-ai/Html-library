{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-hero",
  "title": "Hero",
  "description": "A centred marketing hero: announcement pill, large headline, supporting copy, dual calls to action, and avatar social proof.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "hero",
    "marketing",
    "landing"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-hero.html",
      "type": "html",
      "content": "<!-- Hero Section — announcement pill, headline, dual CTA, social proof -->\r\n<section class=\"w-full bg-white px-6 py-24 dark:bg-neutral-950\">\r\n  <div class=\"mx-auto flex max-w-4xl flex-col items-center text-center\">\r\n    <a href=\"#\" class=\"mb-7 flex items-center gap-2 rounded-full border border-gray-200 py-1 pl-1 pr-3 transition hover:border-gray-300 dark:border-white/10 dark:hover:border-white/20\">\r\n      <span class=\"rounded-full bg-gray-900 px-2 py-0.5 text-[11px] font-medium text-white dark:bg-white dark:text-neutral-900\">New</span>\r\n      <span class=\"text-[12.5px] text-gray-600 dark:text-gray-400\">Incremental builds are live</span>\r\n      <svg class=\"h-3 w-3 text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\r\n    </a>\r\n\r\n    <h1 class=\"max-w-3xl text-[56px] font-semibold leading-[1.05] tracking-[-0.02em] text-gray-900 dark:text-gray-100\">\r\n      Ship your interface,<br />not your build config\r\n    </h1>\r\n    <p class=\"mt-6 max-w-xl text-[18px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n      Compile, preview and deploy every branch automatically. No YAML archaeology, no surprise\r\n      regressions the morning after a release.\r\n    </p>\r\n\r\n    <div class=\"mt-9 flex flex-wrap items-center justify-center gap-3\">\r\n      <a href=\"#\" class=\"rounded-xl bg-gray-900 px-5 py-3 text-[14.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\r\n        Start building free\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2 rounded-xl border border-gray-200 px-5 py-3 text-[14.5px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\r\n        Read the docs\r\n      </a>\r\n    </div>\r\n\r\n    <div class=\"mt-8 flex items-center gap-3\">\r\n      <span class=\"flex -space-x-2\">\r\n        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-gray-900 text-[10px] font-semibold text-white dark:border-neutral-950 dark:bg-white dark:text-neutral-900\">EK</span>\r\n        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-blue-100 text-[10px] font-semibold text-blue-700 dark:border-neutral-950 dark:bg-blue-500/20 dark:text-blue-200\">AR</span>\r\n        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-emerald-100 text-[10px] font-semibold text-emerald-700 dark:border-neutral-950 dark:bg-emerald-500/20 dark:text-emerald-200\">MT</span>\r\n        <span class=\"flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-rose-100 text-[10px] font-semibold text-rose-700 dark:border-neutral-950 dark:bg-rose-500/20 dark:text-rose-200\">JK</span>\r\n      </span>\r\n      <span class=\"text-[13px] text-gray-500 dark:text-gray-400\">\r\n        Trusted by <span class=\"font-medium text-gray-900 dark:text-gray-100\">3,200+</span> engineering teams\r\n      </span>\r\n    </div>\r\n  </div>\r\n</section>\n"
    }
  ]
}
