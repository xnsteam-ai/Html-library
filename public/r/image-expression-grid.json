{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-expression-grid",
  "title": "Expression Grid",
  "description": "Nine-frame contact sheet of a single subject reacting",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "grid",
    "expressions",
    "contact sheet",
    "denim"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Same fair-haired figure across nine frames, hair and framing consistent, only the face changing",
      "expression": "Full range — laughing, surprised, pouting, deadpan, heart-hands",
      "clothing": "Light denim jacket over a white top, consistent across all nine"
    },
    "composition": {
      "shotType": "Nine-frame grid, matched head-and-shoulders crops",
      "angle": "Eye-level, identical per frame",
      "placement": "Centred in each cell",
      "distance": "Medium-close",
      "depthOfField": "Shallow, consistent across frames",
      "focus": "The face in each cell"
    },
    "environment": {
      "setting": "Studio",
      "background": "Flat pale backdrop, identical in every frame",
      "depth": "Subject only"
    },
    "lighting": {
      "quality": "Soft, even, unchanged between frames",
      "direction": "Broad frontal key, minimal shadow",
      "temperature": "Neutral-warm",
      "shadows": "Low contrast; consistent by design"
    },
    "camera": {
      "lens": "85mm",
      "quality": "Clean, even, catalogue-grade",
      "artifacts": "None",
      "aesthetic": "Contact sheet, reference, consistent, casting"
    },
    "atmosphere": {
      "mood": "Working range",
      "story": "One performer running through their expressions for a casting file.",
      "micro": "The point is the variation — keep each frame distinct"
    }
  },
  "files": [
    {
      "path": "image-expression-grid.html",
      "type": "html",
      "content": "<!--\n  Expression Grid — 1200×900 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2057485300818235561-1.jpg\"\n    alt=\"Nine-frame contact sheet of a single subject reacting\"\n    width=\"1200\"\n    height=\"900\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Expression Grid · 1200×900</figcaption>\n</figure>\n"
    }
  ]
}
