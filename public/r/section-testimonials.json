{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-testimonials",
  "title": "Testimonials",
  "description": "A working quote slider: three testimonials switched by clickable dot navigation, no JavaScript.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "testimonials",
    "slider",
    "social-proof"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-testimonials.html",
      "type": "html",
      "content": "<!--\n  Testimonials Section — a real slider. Three radio-selected quotes with\n  clickable dot navigation, driven by `group-has-[#id:checked]`.\n-->\n<section class=\"group/testimonials w-full bg-gray-50 px-6 py-24 dark:bg-white/5\">\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-0\" class=\"sr-only\" checked />\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-1\" class=\"sr-only\" />\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-2\" class=\"sr-only\" />\n\n  <div class=\"mx-auto max-w-3xl text-center\">\n    <p class=\"text-[12.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-muted-foreground\">Customer stories</p>\n\n    <div class=\"relative mt-8 min-h-[220px]\">\n      <div class=\"hidden group-has-[#section-testimonials-0:checked]/testimonials:block\">\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\n          “We cut our release cycle from a fortnight to an afternoon. The preview URLs alone\n          replaced an entire staging environment.”\n        </p>\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\n          <img src=\"https://i.pravatar.cc/88?img=59\" alt=\"Theo Baptiste\" class=\"h-11 w-11 rounded-full object-cover\" />\n          <span class=\"text-left\">\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Theo Baptiste</span>\n            <span class=\"block text-[12.5px] text-gray-600 dark:text-muted-foreground\">VP Engineering, Northwind</span>\n          </span>\n        </div>\n      </div>\n\n      <div class=\"hidden group-has-[#section-testimonials-1:checked]/testimonials:block\">\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\n          “Rollback used to mean paging someone at 2am. Now it's a dropdown. That alone paid for\n          the migration.”\n        </p>\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\n          <img src=\"https://i.pravatar.cc/88?img=16\" alt=\"Marta Ruiz\" class=\"h-11 w-11 rounded-full object-cover\" />\n          <span class=\"text-left\">\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Marta Ruiz</span>\n            <span class=\"block text-[12.5px] text-gray-600 dark:text-muted-foreground\">Staff Engineer, Corvus</span>\n          </span>\n        </div>\n      </div>\n\n      <div class=\"hidden group-has-[#section-testimonials-2:checked]/testimonials:block\">\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\n          “Onboarding a new engineer used to take a week of pipeline archaeology. Now it takes an\n          afternoon, because there's nothing bespoke left to learn.”\n        </p>\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\n          <img src=\"https://i.pravatar.cc/88?img=45\" alt=\"Priya Anand\" class=\"h-11 w-11 rounded-full object-cover\" />\n          <span class=\"text-left\">\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Priya Anand</span>\n            <span class=\"block text-[12.5px] text-gray-600 dark:text-muted-foreground\">CTO, Bellhop</span>\n          </span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mt-9 flex items-center justify-center gap-2\">\n      <label for=\"section-testimonials-0\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-0:checked]/testimonials:w-6 group-has-[#section-testimonials-0:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-0:checked]/testimonials:bg-white\" aria-label=\"Show first testimonial\"></label>\n      <label for=\"section-testimonials-1\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-1:checked]/testimonials:w-6 group-has-[#section-testimonials-1:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-1:checked]/testimonials:bg-white\" aria-label=\"Show second testimonial\"></label>\n      <label for=\"section-testimonials-2\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-2:checked]/testimonials:w-6 group-has-[#section-testimonials-2:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-2:checked]/testimonials:bg-white\" aria-label=\"Show third testimonial\"></label>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
