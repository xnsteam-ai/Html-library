{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-testimonials",
  "title": "Testimonials",
  "description": "A working quote slider: three testimonials switched by clickable dot navigation, no JavaScript.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "testimonials",
    "slider",
    "social-proof"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-testimonials.html",
      "type": "html",
      "content": "<!--\r\n  Testimonials Section — a real slider. Three radio-selected quotes with\r\n  clickable dot navigation, driven by `group-has-[#id:checked]`.\r\n-->\r\n<section class=\"group/testimonials w-full bg-gray-50 px-6 py-24 dark:bg-white/5\">\r\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-0\" class=\"sr-only\" checked />\r\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-1\" class=\"sr-only\" />\r\n  <input type=\"radio\" name=\"section-testimonials-active\" id=\"section-testimonials-2\" class=\"sr-only\" />\r\n\r\n  <div class=\"mx-auto max-w-3xl text-center\">\r\n    <p class=\"text-[12.5px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500\">Customer stories</p>\r\n\r\n    <div class=\"relative mt-8 min-h-[220px]\">\r\n      <div class=\"hidden group-has-[#section-testimonials-0:checked]/testimonials:block\">\r\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\r\n          “We cut our release cycle from a fortnight to an afternoon. The preview URLs alone\r\n          replaced an entire staging environment.”\r\n        </p>\r\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\r\n          <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-gray-900 text-[13px] font-semibold text-white dark:bg-white dark:text-neutral-900\">TB</span>\r\n          <span class=\"text-left\">\r\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Theo Baptiste</span>\r\n            <span class=\"block text-[12.5px] text-gray-500 dark:text-gray-400\">VP Engineering, Northwind</span>\r\n          </span>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"hidden group-has-[#section-testimonials-1:checked]/testimonials:block\">\r\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\r\n          “Rollback used to mean paging someone at 2am. Now it's a dropdown. That alone paid for\r\n          the migration.”\r\n        </p>\r\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\r\n          <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-violet-600 text-[13px] font-semibold text-white\">MR</span>\r\n          <span class=\"text-left\">\r\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Marta Ruiz</span>\r\n            <span class=\"block text-[12.5px] text-gray-500 dark:text-gray-400\">Staff Engineer, Corvus</span>\r\n          </span>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"hidden group-has-[#section-testimonials-2:checked]/testimonials:block\">\r\n        <p class=\"text-[26px] font-medium leading-snug tracking-tight text-gray-900 dark:text-gray-100\">\r\n          “Onboarding a new engineer used to take a week of pipeline archaeology. Now it takes an\r\n          afternoon, because there's nothing bespoke left to learn.”\r\n        </p>\r\n        <div class=\"mt-7 flex items-center justify-center gap-3\">\r\n          <span class=\"flex h-11 w-11 items-center justify-center rounded-full bg-emerald-600 text-[13px] font-semibold text-white\">PA</span>\r\n          <span class=\"text-left\">\r\n            <span class=\"block text-[14px] font-medium text-gray-900 dark:text-gray-100\">Priya Anand</span>\r\n            <span class=\"block text-[12.5px] text-gray-500 dark:text-gray-400\">CTO, Bellhop</span>\r\n          </span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"mt-9 flex items-center justify-center gap-2\">\r\n      <label for=\"section-testimonials-0\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-0:checked]/testimonials:w-6 group-has-[#section-testimonials-0:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-0:checked]/testimonials:bg-white\" aria-label=\"Show first testimonial\"></label>\r\n      <label for=\"section-testimonials-1\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-1:checked]/testimonials:w-6 group-has-[#section-testimonials-1:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-1:checked]/testimonials:bg-white\" aria-label=\"Show second testimonial\"></label>\r\n      <label for=\"section-testimonials-2\" class=\"h-2 w-2 cursor-pointer rounded-full bg-gray-300 transition group-has-[#section-testimonials-2:checked]/testimonials:w-6 group-has-[#section-testimonials-2:checked]/testimonials:bg-gray-900 dark:bg-white/20 dark:group-has-[#section-testimonials-2:checked]/testimonials:bg-white\" aria-label=\"Show third testimonial\"></label>\r\n    </div>\r\n  </div>\r\n</section>\n"
    }
  ]
}
