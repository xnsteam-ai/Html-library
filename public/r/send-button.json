{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "send-button",
  "title": "Send Button",
  "description": "Send affordance in four states: idle, disabled, generating (stop), and a labelled variant with a keyboard hint.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "button",
    "send",
    "states"
  ],
  "files": [
    {
      "path": "send-button.html",
      "type": "html",
      "content": "<!-- Send Button — idle, disabled, busy (stop) and labelled variants -->\n<div class=\"mx-auto flex w-full max-w-md flex-wrap items-center justify-center gap-6\">\n  <!-- Idle -->\n  <div class=\"flex flex-col items-center gap-2\">\n    <button type=\"button\" class=\"flex h-8 w-8 items-center justify-center rounded-full bg-gray-900 text-white transition hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200 dark:focus-visible:ring-white dark:focus-visible:ring-offset-neutral-950\" aria-label=\"Send message\">\n      <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\" /></svg>\n    </button>\n    <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">Idle</span>\n  </div>\n\n  <!-- Disabled -->\n  <div class=\"flex flex-col items-center gap-2\">\n    <button type=\"button\" disabled class=\"flex h-8 w-8 cursor-not-allowed items-center justify-center rounded-full bg-gray-200 text-muted-foreground dark:bg-white/10 dark:text-muted-foreground\" aria-label=\"Send message\">\n      <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\" /></svg>\n    </button>\n    <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">Disabled</span>\n  </div>\n\n  <!-- Busy / stop -->\n  <div class=\"flex flex-col items-center gap-2\">\n    <button type=\"button\" class=\"flex h-8 w-8 items-center justify-center rounded-full bg-gray-900 text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\" aria-label=\"Stop generating\">\n      <span class=\"h-2.5 w-2.5 rounded-[2px] bg-current\"></span>\n    </button>\n    <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">Generating</span>\n  </div>\n\n  <!-- Labelled -->\n  <div class=\"flex flex-col items-center gap-2\">\n    <button type=\"button\" class=\"flex items-center gap-1.5 rounded-full bg-gray-900 px-3.5 py-1.5 text-[13px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\n      Send\n      <span class=\"rounded border border-white/25 px-1 font-mono text-[10px] leading-4 dark:border-black/20\">↵</span>\n    </button>\n    <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">With hint</span>\n  </div>\n</div>\n"
    }
  ]
}
