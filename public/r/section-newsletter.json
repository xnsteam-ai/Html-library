{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-newsletter",
  "title": "Newsletter",
  "description": "A real email subscribe form with native required validation, an icon tile and a supporting line.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "newsletter",
    "form",
    "email"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-newsletter.html",
      "type": "html",
      "content": "<!-- Newsletter Section — a real subscribe form -->\n<section class=\"w-full bg-gray-50 px-6 py-20 dark:bg-white/5\">\n  <div class=\"mx-auto max-w-xl text-center\">\n    <span class=\"mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-gray-900 text-white dark:bg-white dark:text-neutral-900\">\n      <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\" /><path d=\"M2 7l10 6 10-6\" /></svg>\n    </span>\n    <h2 class=\"mt-5 text-[26px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">\n      Ship notes, once a week\n    </h2>\n    <p class=\"mt-2.5 text-[14.5px] leading-relaxed text-gray-600 dark:text-gray-400\">\n      What changed, what broke, and what we learned fixing it. No fluff, unsubscribe any time.\n    </p>\n\n    <form class=\"mx-auto mt-7 flex max-w-sm items-center gap-2\">\n      <label for=\"section-newsletter-email\" class=\"sr-only\">Email address</label>\n      <input\n        id=\"section-newsletter-email\"\n        type=\"email\"\n        required\n        placeholder=\"you@company.com\"\n        class=\"min-w-0 flex-1 rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-[14px] text-gray-900 placeholder:text-gray-400 focus:border-gray-400 focus:outline-none dark:border-white/15 dark:bg-neutral-950 dark:text-gray-100 dark:placeholder:text-gray-600\"\n      />\n      <button type=\"submit\" class=\"shrink-0 rounded-xl bg-gray-900 px-4 py-2.5 text-[14px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\n        Subscribe\n      </button>\n    </form>\n    <p class=\"mt-3 text-[12px] text-gray-400 dark:text-gray-600\">Read by 8,400+ engineers.</p>\n  </div>\n</section>\n"
    }
  ]
}
