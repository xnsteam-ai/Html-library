{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "mode-selector",
  "title": "Mode Selector",
  "description": "Segmented controls for switching agent modes — a full-width pill group and a compact bordered variant.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tabs",
    "segmented",
    "toggle"
  ],
  "files": [
    {
      "path": "mode-selector.html",
      "type": "html",
      "content": "<!--\n  Mode Selector — working segmented controls, no JavaScript.\n  Each segment is a radio input inside its label; the label styles itself from\n  its own input via `peer-checked:`. Keyboard arrow-keys work natively because\n  these are real radio groups.\n-->\n<div class=\"mx-auto w-full max-w-md space-y-5\">\n  <!-- Icon + label segments -->\n  <div class=\"flex rounded-full bg-gray-100 p-[3px] dark:bg-white/10\" role=\"radiogroup\" aria-label=\"Agent mode\">\n    <label class=\"flex-1\">\n      <input type=\"radio\" name=\"mode-selector-agent\" class=\"peer sr-only\" checked />\n      <span class=\"flex cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] font-medium text-gray-500 transition hover:text-gray-800 peer-checked:bg-white peer-checked:text-gray-900 peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-gray-900 dark:text-gray-400 dark:hover:text-gray-200 dark:peer-checked:bg-neutral-900 dark:peer-checked:text-gray-100 dark:peer-focus-visible:ring-white\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-8 9 8M5 10v10h14V10\" /></svg>\n        Chat\n      </span>\n    </label>\n    <label class=\"flex-1\">\n      <input type=\"radio\" name=\"mode-selector-agent\" class=\"peer sr-only\" />\n      <span class=\"flex cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] font-medium text-gray-500 transition hover:text-gray-800 peer-checked:bg-white peer-checked:text-gray-900 peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-gray-900 dark:text-gray-400 dark:hover:text-gray-200 dark:peer-checked:bg-neutral-900 dark:peer-checked:text-gray-100 dark:peer-focus-visible:ring-white\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 18l6-6-6-6M8 6l-6 6 6 6\" /></svg>\n        Code\n      </span>\n    </label>\n    <label class=\"flex-1\">\n      <input type=\"radio\" name=\"mode-selector-agent\" class=\"peer sr-only\" />\n      <span class=\"flex cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1.5 text-[13px] font-medium text-gray-500 transition hover:text-gray-800 peer-checked:bg-white peer-checked:text-gray-900 peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-gray-900 dark:text-gray-400 dark:hover:text-gray-200 dark:peer-checked:bg-neutral-900 dark:peer-checked:text-gray-100 dark:peer-focus-visible:ring-white\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3 8-8\" /><path d=\"M20 12v7a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h9\" /></svg>\n        Plan\n      </span>\n    </label>\n  </div>\n\n  <!-- Compact bordered variant -->\n  <div class=\"inline-flex rounded-lg border border-gray-200 p-0.5 dark:border-white/10\" role=\"radiogroup\" aria-label=\"Permission mode\">\n    <label>\n      <input type=\"radio\" name=\"mode-selector-permission\" class=\"peer sr-only\" />\n      <span class=\"block cursor-pointer rounded-md px-2.5 py-1 text-[12px] font-medium text-gray-500 transition hover:text-gray-900 peer-checked:bg-gray-900 peer-checked:text-white dark:text-gray-400 dark:hover:text-gray-100 dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">Ask</span>\n    </label>\n    <label>\n      <input type=\"radio\" name=\"mode-selector-permission\" class=\"peer sr-only\" checked />\n      <span class=\"block cursor-pointer rounded-md px-2.5 py-1 text-[12px] font-medium text-gray-500 transition hover:text-gray-900 peer-checked:bg-gray-900 peer-checked:text-white dark:text-gray-400 dark:hover:text-gray-100 dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">Auto</span>\n    </label>\n    <label>\n      <input type=\"radio\" name=\"mode-selector-permission\" class=\"peer sr-only\" />\n      <span class=\"block cursor-pointer rounded-md px-2.5 py-1 text-[12px] font-medium text-gray-500 transition hover:text-gray-900 peer-checked:bg-gray-900 peer-checked:text-white dark:text-gray-400 dark:hover:text-gray-100 dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">Read only</span>\n    </label>\n  </div>\n</div>\n"
    }
  ]
}
