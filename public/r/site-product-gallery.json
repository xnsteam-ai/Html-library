{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "site-product-gallery",
  "title": "Product Gallery",
  "description": "A marketing header over a grid of square product cards with pricing.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "ecommerce",
    "gallery",
    "products"
