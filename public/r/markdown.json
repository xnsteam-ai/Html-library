{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "markdown",
  "title": "Markdown",
  "description": "Typography for rendered agent output: headings, lists, inline code, a titled code block, blockquote, table, and links.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "typography",
    "prose",
    "output"
  ],
  "files": [
    {
      "path": "markdown.html",
      "type": "html",
      "content": "<!-- Markdown — typography for rendered agent output (no plugin required) -->\n<article class=\"mx-auto w-full max-w-2xl text-[14.5px] leading-relaxed text-foreground dark:text-gray-200\">\n  <h2 class=\"mb-2 text-[19px] font-semibold tracking-tight text-foreground dark:text-gray-100\">Streaming the response</h2>\n  <p class=\"mb-4\">\n    The handler currently buffers the whole payload before writing. Switching to a stream keeps memory flat and lets the client render the\n    <span class=\"rounded bg-gray-100 px-1 py-0.5 font-mono text-[13px] text-foreground dark:bg-white/10 dark:text-gray-200\">first token</span>\n    immediately.\n  </p>\n\n  <h3 class=\"mb-2 mt-6 text-[15.5px] font-semibold text-foreground dark:text-gray-100\">What changes</h3>\n  <ul class=\"mb-4 space-y-1.5 pl-5\">\n    <li class=\"list-disc marker:text-muted-foreground dark:marker:text-muted-foreground\">Return a <span class=\"rounded bg-gray-100 px-1 py-0.5 font-mono text-[13px] text-foreground dark:bg-white/10 dark:text-gray-200\">ReadableStream</span> instead of a string</li>\n    <li class=\"list-disc marker:text-muted-foreground dark:marker:text-muted-foreground\">Flush on every chunk boundary</li>\n    <li class=\"list-disc marker:text-muted-foreground dark:marker:text-muted-foreground\">Keep the error envelope identical for non-2xx paths</li>\n  </ul>\n\n  <ol class=\"mb-4 space-y-1.5 pl-5\">\n    <li class=\"list-decimal marker:text-muted-foreground dark:marker:text-muted-foreground\">Wrap the source in a transform stream</li>\n    <li class=\"list-decimal marker:text-muted-foreground dark:marker:text-muted-foreground\">Set <span class=\"rounded bg-gray-100 px-1 py-0.5 font-mono text-[13px] text-foreground dark:bg-white/10 dark:text-gray-200\">Transfer-Encoding: chunked</span></li>\n  </ol>\n\n  <!-- Code block -->\n  <div class=\"mb-4 overflow-hidden rounded-lg border border-gray-200 dark:border-white/10\">\n    <div class=\"flex items-center justify-between border-b border-gray-200 bg-gray-50 px-3 py-1.5 dark:border-white/10 dark:bg-white/5\">\n      <span class=\"font-mono text-[11px] text-muted-foreground dark:text-muted-foreground\">handler.ts</span>\n      <button type=\"button\" class=\"flex items-center gap-1 rounded px-1.5 py-0.5 text-[11px] text-muted-foreground transition hover:bg-gray-200 hover:text-foreground dark:text-muted-foreground dark:hover:bg-white/10 dark:hover:text-gray-200\">\n        <svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\" /><path d=\"M5 15V5a2 2 0 012-2h10\" /></svg>\n        Copy\n      </button>\n    </div>\n    <pre class=\"overflow-x-auto bg-white p-3 font-mono text-[12.5px] leading-relaxed text-foreground dark:bg-neutral-950 dark:text-gray-200\"><code>export async function GET(req: Request) {\n  const stream = source.pipeThrough(new TextEncoderStream())\n  return new Response(stream, {\n    headers: { \"content-type\": \"text/event-stream\" },\n  })\n}</code></pre>\n  </div>\n\n  <blockquote class=\"mb-4 border-l-2 border-gray-300 pl-3 text-muted-foreground italic dark:border-white/20 dark:text-muted-foreground\">\n    Buffered responses were capped at 8 MB — streaming removes that ceiling entirely.\n  </blockquote>\n\n  <!-- Table -->\n  <div class=\"mb-4 overflow-x-auto rounded-lg border border-gray-200 dark:border-white/10\">\n    <table class=\"w-full border-collapse text-left text-[13px]\">\n      <thead class=\"bg-gray-50 dark:bg-white/5\">\n        <tr>\n          <th class=\"px-3 py-2 font-medium text-muted-foreground dark:text-muted-foreground\">Metric</th>\n          <th class=\"px-3 py-2 font-medium text-muted-foreground dark:text-muted-foreground\">Before</th>\n          <th class=\"px-3 py-2 font-medium text-muted-foreground dark:text-muted-foreground\">After</th>\n        </tr>\n      </thead>\n      <tbody class=\"divide-y divide-gray-200 dark:divide-white/10\">\n        <tr>\n          <td class=\"px-3 py-2 text-muted-foreground dark:text-muted-foreground\">Time to first byte</td>\n          <td class=\"px-3 py-2 text-muted-foreground dark:text-muted-foreground\">1.9 s</td>\n          <td class=\"px-3 py-2 font-medium text-foreground dark:text-gray-100\">40 ms</td>\n        </tr>\n        <tr>\n          <td class=\"px-3 py-2 text-muted-foreground dark:text-muted-foreground\">Peak memory</td>\n          <td class=\"px-3 py-2 text-muted-foreground dark:text-muted-foreground\">210 MB</td>\n          <td class=\"px-3 py-2 font-medium text-foreground dark:text-gray-100\">28 MB</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <hr class=\"my-5 border-gray-200 dark:border-white/10\" />\n\n  <p class=\"text-[13px] text-muted-foreground dark:text-muted-foreground\">\n    See the <a href=\"#\" class=\"font-medium text-foreground underline underline-offset-2 hover:text-muted-foreground dark:text-gray-100 dark:hover:text-muted-foreground/70\">streaming guide</a> for the client side.\n  </p>\n</article>\n"
    }
  ]
}
