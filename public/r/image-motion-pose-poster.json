{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-motion-pose-poster",
  "title": "Motion Pose Poster",
  "description": "Dance-style motion pose in white, shot against a plain backdrop",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "poster",
    "dance",
    "motion",
    "editorial"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Full figure mid-movement, one leg lifted, arms extended for balance",
      "expression": "Not readable — head turned away",
      "clothing": "All-white loose two-piece"
    },
    "composition": {
      "shotType": "Poster, full figure with lowercase display type",
      "angle": "Eye-level",
      "placement": "Figure right, type left",
      "distance": "Far",
      "depthOfField": "Deep",
      "focus": "The figure silhouette"
    },
    "framing": {
      "subjectScale": "Figure spans ~40% of frame width, right of centre, full height",
      "subjectBox": "Figure x≈45–88%, y≈12–95%; lowercase wordmark x≈8–45%, y≈18–35%",
      "anchors": "Wordmark baseline at ~35%; figure centre ~55%",
      "edges": "Nothing cropped — figure held inside the frame",
      "negativeSpace": "Left ~40% is empty white — the dominant negative space"
    },
    "environment": {
      "setting": "Studio",
      "background": "Flat white ground, nothing else",
      "depth": "Subject plus typography"
    },
    "lighting": {
      "quality": "Soft, high-key",
      "direction": "Broad frontal diffusion, near-shadowless",
      "temperature": "Neutral white on white",
      "shadows": "Very low contrast; the figure reads by edge alone"
    },
    "camera": {
      "lens": "50mm",
      "quality": "Clean, minimal, high-key grade",
      "artifacts": "None",
      "aesthetic": "Poster, minimal, movement, high-key"
    },
    "atmosphere": {
      "mood": "Light and abstract",
      "story": "A body used as a graphic mark."
    }
  },
  "files": [
    {
      "path": "image-motion-pose-poster.html",
      "type": "html",
      "content": "<!--\n  Motion Pose Poster — 800×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2050144215137726964-1.jpg\"\n    alt=\"Dance-style motion pose in white, shot against a plain backdrop\"\n    width=\"800\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Motion Pose Poster · 800×1200</figcaption>\n</figure>\n"
    }
  ]
}
