    {
      "path": "site-ide-shell.html",
      "type": "html",
      "content": "<!-- Site IDE Shell — restored with its own scoped Studio theme -->\n<style>\n  .sis-root {\n    --bg-app: #f4f4f6; --bg-surface: #ffffff; --bg-sidebar: #f8f8fa;\n    --text-primary: #171717; --text-secondary: #555555; --text-muted: #999999;\n    --border-color: rgba(0,0,0,.08); --bg-hover: rgba(0,0,0,.04); --bg-active: rgba(0,0,0,.06);\n    --btn-secondary-bg: #e5e5e5;\n  }\n  .dark .sis-root {\n    --bg-app: #141414; --bg-surface: #1e1e1e; --bg-sidebar: #191919;\n    --text-primary: #e8e8e8; --text-secondary: #999999; --text-muted: #555555;\n    --border-color: rgba(255,255,255,.07); --bg-hover: rgba(255,255,255,.04); --bg-active: rgba(255,255,255,.08);\n    --btn-secondary-bg: #333333;\n  }\n</style>\n\n<div class=\"sis-root flex h-[800px] w-[1280px] flex-col overflow-hidden bg-[var(--bg-app)] text-[13px]\">\n  <header class=\"flex h-11 shrink-0 items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-surface)] px-2\">\n    <nav class=\"flex h-full items-center\">\n      <span class=\"flex h-full items-center px-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]\">File</span>\n      <span class=\"flex h-full items-center px-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]\">Edit</span>\n      <span class=\"flex h-full items-center px-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]\">View</span>\n      <span class=\"flex h-full items-center px-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]\">Window</span>\n      <span class=\"flex h-full items-center px-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]\">Help</span>\n    </nav>\n    <div class=\"flex items-center gap-2 px-2\">\n      <div class=\"flex w-60 items-center gap-2 rounded-md border border-[var(--border-color)] bg-[var(--bg-app)] px-2.5 py-1 text-[12px] text-[var(--text-muted)]\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n        Search files and commands…\n      </div>\n      <span class=\"rounded bg-[var(--btn-secondary-bg)] px-2.5 py-1 text-[12px] font-medium text-[var(--text-primary)]\">Share</span>\n    </div>\n  </header>\n\n  <div class=\"flex flex-1 min-h-0 bg-[var(--bg-app)]\">\n    <aside class=\"flex w-60 shrink-0 flex-col overflow-y-auto bg-[var(--bg-sidebar)]\">\n      <div class=\"px-4 py-3 pb-1\">\n        <h2 class=\"text-[11px] font-semibold uppercase tracking-wider text-[var(--text-secondary)]\">Explorer</h2>\n      </div>\n      <div class=\"flex flex-col py-2 text-[13px]\">\n        <div class=\"flex items-center gap-1.5 px-3 py-1 text-[var(--text-primary)]\">\n          <svg class=\"h-3.5 w-3.5 text-[var(--text-muted)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\" /></svg>\n          <svg class=\"h-4 w-4 text-[var(--text-secondary)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z\" /></svg>\n          src\n        </div>\n        <div class=\"flex items-center gap-1.5 py-1 pl-6 pr-3 text-[var(--text-primary)]\">\n          <svg class=\"h-3.5 w-3.5 text-[var(--text-muted)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\" /></svg>\n          <svg class=\"h-4 w-4 text-[var(--text-secondary)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z\" /></svg>\n          components\n        </div>\n        <div class=\"flex items-center gap-2 border-l-[3px] border-blue-500 bg-[var(--bg-active)] py-1 pl-9 pr-3 text-[var(--text-primary)]\">\n          <svg class=\"h-4 w-4 text-[var(--text-secondary)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /><path d=\"M9 13l2 2 4-4\" /></svg>\n          AppShell.tsx\n        </div>\n        <div class=\"flex items-center gap-2 border-l-[3px] border-transparent py-1 pl-9 pr-3 text-[var(--text-secondary)]\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          TopNav.tsx\n        </div>\n        <div class=\"flex items-center gap-2 border-l-[3px] border-transparent py-1 pl-9 pr-3 text-[var(--text-secondary)]\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          SideNav.tsx\n        </div>\n        <div class=\"mt-1 flex items-center gap-1.5 px-3 py-1 text-[var(--text-secondary)]\">\n          <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 6l6 6-6 6\" /></svg>\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z\" /></svg>\n          public\n        </div>\n        <div class=\"flex items-center gap-2 py-1 pl-6 pr-3 text-[var(--text-secondary)]\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          package.json\n        </div>\n        <div class=\"flex items-center gap-2 py-1 pl-6 pr-3 text-[var(--text-secondary)]\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          README.md\n        </div>\n      </div>\n    </aside>\n\n    <main class=\"flex min-w-0 flex-1 flex-col rounded-tl-md border-l border-t border-[var(--border-color)] bg-[var(--bg-surface)]\">\n      <div class=\"flex h-10 shrink-0 items-end gap-1 border-b border-[var(--border-color)] bg-[var(--bg-app)] px-2 pt-2\">\n        <div class=\"flex min-w-[120px] items-center gap-2 rounded-t-md border border-b-0 border-[var(--border-color)] border-t-[3px] border-t-blue-500 bg-[var(--bg-surface)] px-4 py-1.5 text-[12px] font-medium text-[var(--text-primary)]\">\n          <svg class=\"h-3.5 w-3.5 text-[var(--text-secondary)]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          AppShell.tsx\n        </div>\n        <div class=\"flex min-w-[120px] items-center gap-2 rounded-t-md px-4 py-1.5 text-[12px] text-[var(--text-secondary)]\">\n          <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          TopNav.tsx\n        </div>\n        <div class=\"flex min-w-[120px] items-center gap-2 rounded-t-md px-4 py-1.5 text-[12px] text-[var(--text-secondary)]\">\n          <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n          theme.ts\n        </div>\n      </div>\n\n      <div class=\"flex-1 overflow-y-auto p-6\">\n        <div class=\"flex max-w-[800px] flex-col gap-2 font-mono\">\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 38%\"></div></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 62%\"></div></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 54%\"></div></div>\n          <div class=\"h-3.5\"></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 46%\"></div></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 70%\"></div></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 58%\"></div></div>\n          <div class=\"flex h-3.5 items-center gap-3\"><div class=\"h-full w-5 rounded bg-[var(--bg-hover)]\"></div><div class=\"h-full rounded bg-[var(--bg-hover)]\" style=\"width: 34%\"></div></div>\n        </div>\n      </div>\n    </main>\n  </div>\n</div>\n"
    }
  ]
}
