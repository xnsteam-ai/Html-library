{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "tabs",
  "title": "Tabs",
  "description": "Three tab patterns — underline with a count badge, pill group, and vertical tabs beside a panel.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tabs",
    "navigation",
    "segmented"
  ],
  "files": [
    {
      "path": "tabs.html",
      "type": "html",
      "content": "<!--\n  Tabs — working tabs that actually switch panels, no JavaScript.\n  Radio inputs hold the state; labels are the tab strip; panels reveal\n  themselves with `group-has-[#id:checked]`. Arrow-key navigation is native.\n-->\n<div class=\"mx-auto w-full max-w-lg space-y-7\">\n  <!-- Underline, with panels -->\n  <div class=\"group/underline\">\n    <input type=\"radio\" name=\"tabs-underline\" id=\"tabs-underline-preview\" class=\"sr-only\" checked />\n    <input type=\"radio\" name=\"tabs-underline\" id=\"tabs-underline-code\" class=\"sr-only\" />\n    <input type=\"radio\" name=\"tabs-underline\" id=\"tabs-underline-usage\" class=\"sr-only\" />\n\n    <div class=\"flex gap-5 border-b border-gray-200 dark:border-white/10\" role=\"tablist\" aria-label=\"Section\">\n      <label for=\"tabs-underline-preview\" class=\"-mb-px cursor-pointer border-b-2 border-transparent pb-2 text-[13px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-underline-preview:checked]/underline:border-gray-900 group-has-[#tabs-underline-preview:checked]/underline:text-gray-900 dark:text-muted-foreground dark:hover:text-gray-200 dark:group-has-[#tabs-underline-preview:checked]/underline:border-white dark:group-has-[#tabs-underline-preview:checked]/underline:text-gray-100\">Preview</label>\n      <label for=\"tabs-underline-code\" class=\"-mb-px cursor-pointer border-b-2 border-transparent pb-2 text-[13px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-underline-code:checked]/underline:border-gray-900 group-has-[#tabs-underline-code:checked]/underline:text-gray-900 dark:text-muted-foreground dark:hover:text-gray-200 dark:group-has-[#tabs-underline-code:checked]/underline:border-white dark:group-has-[#tabs-underline-code:checked]/underline:text-gray-100\">Code</label>\n      <label for=\"tabs-underline-usage\" class=\"-mb-px flex cursor-pointer items-center gap-1.5 border-b-2 border-transparent pb-2 text-[13px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-underline-usage:checked]/underline:border-gray-900 group-has-[#tabs-underline-usage:checked]/underline:text-gray-900 dark:text-muted-foreground dark:hover:text-gray-200 dark:group-has-[#tabs-underline-usage:checked]/underline:border-white dark:group-has-[#tabs-underline-usage:checked]/underline:text-gray-100\">\n        Usage\n        <span class=\"rounded-full bg-gray-100 px-1.5 text-[10px] text-gray-600 dark:bg-white/10 dark:text-muted-foreground\">3</span>\n      </label>\n    </div>\n\n    <div class=\"hidden pt-3 text-[13px] leading-relaxed text-gray-600 group-has-[#tabs-underline-preview:checked]/underline:block dark:text-muted-foreground\">\n      The rendered component, shown exactly as it will appear in your page.\n    </div>\n    <div class=\"hidden pt-3 group-has-[#tabs-underline-code:checked]/underline:block\">\n      <pre class=\"overflow-x-auto rounded-lg bg-gray-50 p-3 font-mono text-[12px] leading-relaxed text-gray-700 dark:bg-white/5 dark:text-muted-foreground\"><code>&lt;button class=\"rounded-lg bg-gray-900 px-3.5 py-2\"&gt;\n  Primary\n&lt;/button&gt;</code></pre>\n    </div>\n    <div class=\"hidden pt-3 text-[13px] leading-relaxed text-gray-600 group-has-[#tabs-underline-usage:checked]/underline:block dark:text-muted-foreground\">\n      Used in 3 places — the composer toolbar, the settings drawer, and the empty state.\n    </div>\n  </div>\n\n  <!-- Pill -->\n  <div class=\"group/pill\">\n    <input type=\"radio\" name=\"tabs-pill\" id=\"tabs-pill-all\" class=\"sr-only\" checked />\n    <input type=\"radio\" name=\"tabs-pill\" id=\"tabs-pill-agent\" class=\"sr-only\" />\n    <input type=\"radio\" name=\"tabs-pill\" id=\"tabs-pill-ui\" class=\"sr-only\" />\n\n    <div class=\"inline-flex rounded-full bg-gray-100 p-[3px] dark:bg-white/10\" role=\"tablist\" aria-label=\"View\">\n      <label for=\"tabs-pill-all\" class=\"cursor-pointer rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-pill-all:checked]/pill:bg-white group-has-[#tabs-pill-all:checked]/pill:text-gray-900 group-has-[#tabs-pill-all:checked]/pill:shadow-sm dark:text-muted-foreground dark:group-has-[#tabs-pill-all:checked]/pill:bg-neutral-900 dark:group-has-[#tabs-pill-all:checked]/pill:text-gray-100\">All</label>\n      <label for=\"tabs-pill-agent\" class=\"cursor-pointer rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-pill-agent:checked]/pill:bg-white group-has-[#tabs-pill-agent:checked]/pill:text-gray-900 group-has-[#tabs-pill-agent:checked]/pill:shadow-sm dark:text-muted-foreground dark:group-has-[#tabs-pill-agent:checked]/pill:bg-neutral-900 dark:group-has-[#tabs-pill-agent:checked]/pill:text-gray-100\">Agent</label>\n      <label for=\"tabs-pill-ui\" class=\"cursor-pointer rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:text-gray-800 group-has-[#tabs-pill-ui:checked]/pill:bg-white group-has-[#tabs-pill-ui:checked]/pill:text-gray-900 group-has-[#tabs-pill-ui:checked]/pill:shadow-sm dark:text-muted-foreground dark:group-has-[#tabs-pill-ui:checked]/pill:bg-neutral-900 dark:group-has-[#tabs-pill-ui:checked]/pill:text-gray-100\">UI</label>\n    </div>\n\n    <p class=\"hidden pt-2.5 text-[13px] text-gray-600 group-has-[#tabs-pill-all:checked]/pill:block dark:text-muted-foreground\">Showing all 38 components.</p>\n    <p class=\"hidden pt-2.5 text-[13px] text-gray-600 group-has-[#tabs-pill-agent:checked]/pill:block dark:text-muted-foreground\">Showing 19 agent elements.</p>\n    <p class=\"hidden pt-2.5 text-[13px] text-gray-600 group-has-[#tabs-pill-ui:checked]/pill:block dark:text-muted-foreground\">Showing 8 UI elements.</p>\n  </div>\n\n  <!-- Vertical -->\n  <div class=\"group/vertical flex gap-5\">\n    <input type=\"radio\" name=\"tabs-vertical\" id=\"tabs-vertical-general\" class=\"sr-only\" checked />\n    <input type=\"radio\" name=\"tabs-vertical\" id=\"tabs-vertical-registry\" class=\"sr-only\" />\n    <input type=\"radio\" name=\"tabs-vertical\" id=\"tabs-vertical-appearance\" class=\"sr-only\" />\n\n    <div class=\"flex w-40 shrink-0 flex-col gap-0.5\" role=\"tablist\" aria-orientation=\"vertical\" aria-label=\"Settings\">\n      <label for=\"tabs-vertical-general\" class=\"cursor-pointer rounded-lg px-2.5 py-1.5 text-left text-[13px] font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-800 group-has-[#tabs-vertical-general:checked]/vertical:bg-gray-100 group-has-[#tabs-vertical-general:checked]/vertical:text-gray-900 dark:text-muted-foreground dark:hover:bg-white/5 dark:group-has-[#tabs-vertical-general:checked]/vertical:bg-white/10 dark:group-has-[#tabs-vertical-general:checked]/vertical:text-gray-100\">General</label>\n      <label for=\"tabs-vertical-registry\" class=\"cursor-pointer rounded-lg px-2.5 py-1.5 text-left text-[13px] font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-800 group-has-[#tabs-vertical-registry:checked]/vertical:bg-gray-100 group-has-[#tabs-vertical-registry:checked]/vertical:text-gray-900 dark:text-muted-foreground dark:hover:bg-white/5 dark:group-has-[#tabs-vertical-registry:checked]/vertical:bg-white/10 dark:group-has-[#tabs-vertical-registry:checked]/vertical:text-gray-100\">Registry</label>\n      <label for=\"tabs-vertical-appearance\" class=\"cursor-pointer rounded-lg px-2.5 py-1.5 text-left text-[13px] font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-800 group-has-[#tabs-vertical-appearance:checked]/vertical:bg-gray-100 group-has-[#tabs-vertical-appearance:checked]/vertical:text-gray-900 dark:text-muted-foreground dark:hover:bg-white/5 dark:group-has-[#tabs-vertical-appearance:checked]/vertical:bg-white/10 dark:group-has-[#tabs-vertical-appearance:checked]/vertical:text-gray-100\">Appearance</label>\n    </div>\n\n    <div class=\"flex-1 rounded-xl border border-gray-200 p-3.5 dark:border-white/10\">\n      <p class=\"hidden text-[13px] leading-relaxed text-gray-600 group-has-[#tabs-vertical-general:checked]/vertical:block dark:text-muted-foreground\">Workspace name, default branch and time zone.</p>\n      <p class=\"hidden text-[13px] leading-relaxed text-gray-600 group-has-[#tabs-vertical-registry:checked]/vertical:block dark:text-muted-foreground\">Which registry URL to publish to, and who may write to it.</p>\n      <p class=\"hidden text-[13px] leading-relaxed text-gray-600 group-has-[#tabs-vertical-appearance:checked]/vertical:block dark:text-muted-foreground\">Theme, density and whether previews follow the system setting.</p>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
