{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-customer-stories",
  "title": "Customer Stories",
  "description": "A two-column case-study grid pairing a square brand-locked thumbnail with a headline, summary and inline link. Thumbnails are real photos.",
