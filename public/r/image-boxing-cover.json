{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-boxing-cover",
  "title": "Boxing Cover",
  "description": "Sports magazine cover with heavy display typography",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "cover",
    "magazine",
    "sport",
    "typography"
  ],
  "files": [
    {
      "path": "image-boxing-cover.html",
      "type": "html",
      "content": "<!--\n  Boxing Cover — 800×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2063475042831245525-1.jpg\"\n    alt=\"Sports magazine cover with heavy display typography\"\n    width=\"800\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600\">Boxing Cover · 800×1200</figcaption>\n</figure>\n"
    }
  ]
}
