{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "site-landing",
  "title": "Landing Page",
  "description": "A marketing home: nav bar, announcement pill, large hero with dual calls to action, logo social proof, and a three-column feature row.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "marketing",
    "hero",
    "landing"
  ],
  "surface": "site",
  "files": [
    {
      "path": "site-landing.html",
      "type": "html",
      "content": "<!-- Site Landing — marketing hero with nav, social proof and feature row, 1280×800 -->\r\n<div class=\"h-[800px] w-[1280px] overflow-hidden bg-white dark:bg-neutral-950\">\r\n  <!-- Nav -->\r\n  <header class=\"flex items-center justify-between border-b border-gray-100 px-12 py-5 dark:border-white/5\">\r\n    <div class=\"flex items-center gap-10\">\r\n      <span class=\"flex items-center gap-2\">\r\n        <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-gray-900 text-[13px] font-bold text-white dark:bg-white dark:text-neutral-900\">H</span>\r\n        <span class=\"text-[15px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Halyard</span>\r\n      </span>\r\n      <nav class=\"flex items-center gap-7\">\r\n        <a href=\"#\" class=\"text-[13.5px] text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100\">Product</a>\r\n        <a href=\"#\" class=\"text-[13.5px] text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100\">Pricing</a>\r\n        <a href=\"#\" class=\"text-[13.5px] text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100\">Docs</a>\r\n        <a href=\"#\" class=\"text-[13.5px] text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100\">Changelog</a>\r\n      </nav>\r\n    </div>\r\n    <div class=\"flex items-center gap-3\">\r\n      <a href=\"#\" class=\"text-[13.5px] font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100\">Sign in</a>\r\n      <a href=\"#\" class=\"rounded-lg bg-gray-900 px-3.5 py-2 text-[13.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Start free</a>\r\n    </div>\r\n  </header>\r\n\r\n  <!-- Hero -->\r\n  <section class=\"flex flex-col items-center px-12 pt-16 text-center\">\r\n    <span class=\"mb-6 flex items-center gap-2 rounded-full border border-gray-200 py-1 pl-1 pr-3 dark:border-white/10\">\r\n      <span class=\"rounded-full bg-gray-900 px-2 py-0.5 text-[11px] font-medium text-white dark:bg-white dark:text-neutral-900\">New</span>\r\n      <span class=\"text-[12.5px] text-gray-600 dark:text-gray-400\">Incremental deploys are live</span>\r\n      <svg class=\"h-3 w-3 text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\r\n    </span>\r\n\r\n    <h1 class=\"max-w-3xl text-[52px] font-semibold leading-[1.08] tracking-[-0.02em] text-gray-900 dark:text-gray-100\">\r\n      Ship your interface,<br />not your build config\r\n    </h1>\r\n    <p class=\"mt-5 max-w-xl text-[17px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n      Halyard compiles, previews and deploys every branch automatically. No YAML archaeology, no\r\n      surprise regressions.\r\n    </p>\r\n\r\n    <div class=\"mt-8 flex items-center gap-3\">\r\n      <a href=\"#\" class=\"rounded-xl bg-gray-900 px-5 py-3 text-[14.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\r\n        Start building free\r\n      </a>\r\n      <a href=\"#\" class=\"flex items-center gap-2 rounded-xl border border-gray-200 px-5 py-3 text-[14.5px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\r\n        Read the docs\r\n      </a>\r\n    </div>\r\n\r\n    <!-- Social proof -->\r\n    <div class=\"mt-12 flex items-center gap-8 opacity-60\">\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-700 dark:text-gray-300\">Northwind</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-700 dark:text-gray-300\">Alteryx</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-700 dark:text-gray-300\">Bellhop</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-700 dark:text-gray-300\">Corvus</span>\r\n      <span class=\"text-[15px] font-semibold tracking-tight text-gray-700 dark:text-gray-300\">Sundial</span>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Feature row -->\r\n  <section class=\"mt-14 grid grid-cols-3 gap-6 border-t border-gray-100 px-12 pt-10 dark:border-white/5\">\r\n    <div>\r\n      <span class=\"mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2L4.5 13H11l-1 9 8.5-11H12z\" /></svg>\r\n      </span>\r\n      <h3 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Builds in seconds</h3>\r\n      <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n        Content-addressed caching means only what changed gets rebuilt.\r\n      </p>\r\n    </div>\r\n    <div>\r\n      <span class=\"mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 4v6c0 4.4-3.4 7.6-8 8-4.6-.4-8-3.6-8-8V7z\" /><path d=\"M9.5 12l2 2 3.5-4\" /></svg>\r\n      </span>\r\n      <h3 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Preview every branch</h3>\r\n      <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n        A real URL per pull request, torn down when you merge.\r\n      </p>\r\n    </div>\r\n    <div>\r\n      <span class=\"mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100 text-gray-700 dark:bg-white/10 dark:text-gray-200\">\r\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\" /><path d=\"M7 15l4-4 3 3 5-6\" /></svg>\r\n      </span>\r\n      <h3 class=\"text-[15px] font-semibold text-gray-900 dark:text-gray-100\">Regressions caught early</h3>\r\n      <p class=\"mt-1.5 text-[13.5px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n        Bundle size and Core Web Vitals diffed against your base branch.\r\n      </p>\r\n    </div>\r\n  </section>\r\n</div>\n"
    }
  ]
}
