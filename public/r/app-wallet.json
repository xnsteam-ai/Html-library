      "content": "<!-- App Wallet — balance card, quick actions, transactions, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-gray-50 dark:bg-neutral-950\">\n <!-- Header -->\n <header class=\"flex items-center justify-between px-5 py-3\">\n <div>\n <p class=\"text-[12.5px] text-gray-500 dark:text-gray-400\">Good morning</p>\n <h1 class=\"text-[19px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Rina</h1>\n </div>\n <button type=\"button\" class=\"relative rounded-full border border-gray-200 bg-white p-2 text-gray-500 dark:text-gray-400 dark:border-white/10 dark:bg-neutral-900 dark:text-gray-400\" aria-label=\"Notifications\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M18 8a6 6 0 10-12 0c0 7-3 8-3 8h18s-3-1-3-8M13.7 21a2 2 0 01-3.4 0\" /></svg>\n <span class=\"absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-rose-500\"></span>\n </button>\n </header>\n\n <div class=\"flex-1 space-y-4 overflow-hidden px-5\">\n <!-- Balance card -->\n <div class=\"relative overflow-hidden rounded-3xl bg-gray-900 p-5 dark:bg-neutral-900\">\n <div class=\"absolute -right-8 -top-10 h-36 w-36 rounded-full bg-white/10\"></div>\n <div class=\"absolute -bottom-14 -left-6 h-32 w-32 rounded-full bg-white/5\"></div>\n <div class=\"relative\">\n <p class=\"text-[12.5px] text-white/60\">Total balance</p>\n <p class=\"mt-1 text-[32px] font-semibold tracking-tight text-white\">$12,480.65</p>\n <div class=\"mt-4 flex items-center justify-between\">\n <span class=\"font-mono text-[13px] tracking-widest text-white/70\">•••• 5690</span>\n <span class=\"flex items-center gap-1 rounded-full bg-emerald-400/15 px-2 py-0.5 text-[11px] font-medium text-emerald-300\">\n <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7M9 7h8v8\" /></svg>\n 4.3%\n </span>\n </div>\n </div>\n </div>\n\n <!-- Quick actions -->\n <div class=\"grid grid-cols-4 gap-2\">\n <button type=\"button\" class=\"flex flex-col items-center gap-1.5 rounded-2xl bg-white py-3 dark:bg-neutral-900\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-200\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\" /></svg>\n </span>\n <span class=\"text-[11px] font-medium text-gray-500 dark:text-gray-400\">Send</span>\n </button>\n <button type=\"button\" class=\"flex flex-col items-center gap-1.5 rounded-2xl bg-white py-3 dark:bg-neutral-900\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-200\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M19 12l-7 7-7-7\" /></svg>\n </span>\n <span class=\"text-[11px] font-medium text-gray-500 dark:text-gray-400\">Request</span>\n </button>\n <button type=\"button\" class=\"flex flex-col items-center gap-1.5 rounded-2xl bg-white py-3 dark:bg-neutral-900\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-200\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n </span>\n <span class=\"text-[11px] font-medium text-gray-500 dark:text-gray-400\">Swap</span>\n </button>\n <button type=\"button\" class=\"flex flex-col items-center gap-1.5 rounded-2xl bg-white py-3 dark:bg-neutral-900\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-200\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"1.4\" /><circle cx=\"19\" cy=\"12\" r=\"1.4\" /><circle cx=\"5\" cy=\"12\" r=\"1.4\" /></svg>\n </span>\n <span class=\"text-[11px] font-medium text-gray-500 dark:text-gray-400\">More</span>\n </button>\n </div>\n\n <!-- Transactions -->\n <div class=\"rounded-2xl bg-white dark:bg-neutral-900\">\n <div class=\"flex items-center justify-between px-4 pb-1 pt-3.5\">\n <h2 class=\"text-[14px] font-semibold text-gray-900 dark:text-gray-100\">Recent</h2>\n <a href=\"#\" class=\"text-[12.5px] font-medium text-gray-500 dark:text-gray-400\">See all</a>\n </div>\n <ul class=\"divide-y divide-gray-100 dark:divide-white/5\">\n <li class=\"flex items-center gap-3 px-4 py-3\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M19 12l-7 7-7-7\" /></svg>\n </span>\n <span class=\"min-w-0 flex-1\">\n <span class=\"block truncate text-[13.5px] font-medium text-gray-900 dark:text-gray-100\">Payout · Stripe</span>\n <span class=\"block text-[11.5px] text-gray-500 dark:text-gray-400\">Today, 08:12</span>\n </span>\n <span class=\"text-[13.5px] font-semibold text-emerald-600 dark:text-emerald-400\">+$2,400.00</span>\n </li>\n <li class=\"flex items-center gap-3 px-4 py-3\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:text-gray-400 dark:bg-white/10 dark:text-gray-400\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9h18M3 9l2-4h14l2 4M5 9v10a2 2 0 002 2h10a2 2 0 002-2V9\" /></svg>\n </span>\n <span class=\"min-w-0 flex-1\">\n <span class=\"block truncate text-[13.5px] font-medium text-gray-900 dark:text-gray-100\">Whole Foods</span>\n <span class=\"block text-[11.5px] text-gray-500 dark:text-gray-400\">Yesterday, 18:40</span>\n </span>\n <span class=\"text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">−$86.20</span>\n </li>\n <li class=\"flex items-center gap-3 px-4 py-3\">\n <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300\">\n <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\" /><path d=\"M2 10h20\" /></svg>\n </span>\n <span class=\"min-w-0 flex-1\">\n <span class=\"block truncate text-[13.5px] font-medium text-gray-900 dark:text-gray-100\">Figma · Annual</span>\n <span class=\"block text-[11.5px] text-gray-500 dark:text-gray-400\">Mar 12</span>\n </span>\n <span class=\"text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">−$144.00</span>\n </li>\n </ul>\n </div>\n </div>\n"
    }
