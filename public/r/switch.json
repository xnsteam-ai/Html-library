{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "switch",
  "title": "Switch",
  "description": "A real toggle switch in on, off and disabled states, driven entirely by a hidden checkbox and CSS.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "switch",
    "toggle",
    "form"
  ],
  "files": [
    {
      "path": "switch.html",
      "type": "html",
      "content": "<!--\n  Switch — Fluent UI style toggle, restored with its own scoped theme.\n  A real working switch: the visible track/thumb is a <label> wrapping a\n  hidden checkbox, `peer-checked` drives the checked state — no JavaScript.\n-->\n<style>\n  .fsw-root { --bg-surface: #ffffff; --text-primary: #242424; --border-color: #e0e0e0; --fluent-brand: #0f6cbd; --fluent-switch-bg: #ffffff; --fluent-switch-border: #616161; --fluent-switch-thumb: #616161; }\n  .dark .fsw-root { --bg-surface: #333333; --text-primary: #ffffff; --border-color: #424242; --fluent-brand: #479ef5; --fluent-switch-bg: #333333; --fluent-switch-border: #d1d1d1; --fluent-switch-thumb: #d1d1d1; }\n</style>\n\n<div class=\"fsw-root mx-auto w-full max-w-sm rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-8 shadow-sm\">\n  <h2 class=\"mb-8 text-[15px] font-semibold text-[var(--text-primary)]\">Standard Switches</h2>\n\n  <div class=\"flex flex-col gap-6\">\n    <div class=\"flex items-center justify-between\">\n      <span class=\"cursor-pointer select-none text-[14px] font-medium text-[var(--text-primary)]\">Wi-Fi</span>\n      <label class=\"fsw-track relative inline-flex h-5 w-10 shrink-0 cursor-pointer items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)] transition-colors\">\n        <input type=\"checkbox\" class=\"peer sr-only\" />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent transition-colors peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] transition-transform peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n\n    <div class=\"flex items-center justify-between\">\n      <span class=\"cursor-pointer select-none text-[14px] font-medium text-[var(--text-primary)]\">Bluetooth</span>\n      <label class=\"fsw-track relative inline-flex h-5 w-10 shrink-0 cursor-pointer items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)] transition-colors\">\n        <input type=\"checkbox\" class=\"peer sr-only\" checked />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent transition-colors peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] transition-transform peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n\n    <div class=\"flex items-center justify-between opacity-40\">\n      <span class=\"select-none text-[14px] font-medium text-[var(--text-primary)]\">Airplane mode</span>\n      <label class=\"fsw-track relative inline-flex h-5 w-10 shrink-0 cursor-not-allowed items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)]\">\n        <input type=\"checkbox\" class=\"peer sr-only\" disabled />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
