{
  "$schema": "https://xnsteam-ai.github.io/html-library/r/schema.json",
  "name": "bash-tool",
  "title": "Bash Tool",
  "description": "Terminal tool calls: command header, scrollable output, exit-status pill, duration footer, and a failed variant.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tool",
    "terminal",
    "output"
  ],
  "files": [
    {
      "path": "bash-tool.html",
      "type": "html",
      "content": "<!-- Bash Tool — command card with output, exit status and a failed variant -->\n<div class=\"mx-auto w-full max-w-2xl space-y-3\">\n  <!-- Success -->\n  <div class=\"overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n    <div class=\"flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 dark:border-white/10 dark:bg-white/5\">\n      <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n      <code class=\"min-w-0 flex-1 truncate font-mono text-[12px] text-gray-800 dark:text-gray-200\">npm run test -- --reporter=dot</code>\n      <span class=\"flex shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10.5px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">\n        <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n        exit 0\n      </span>\n    </div>\n    <pre class=\"max-h-52 overflow-auto bg-white px-3 py-2.5 font-mono text-[11.5px] leading-relaxed text-gray-600 dark:bg-neutral-950 dark:text-gray-400\">····················\n Test Files  18 passed (18)\n      Tests  214 passed (214)\n   Duration  6.42s</pre>\n    <div class=\"flex items-center justify-between border-t border-gray-200 px-3 py-1.5 dark:border-white/10\">\n      <span class=\"text-[11px] text-gray-400 dark:text-gray-500\">6.4s · 4 lines</span>\n      <button type=\"button\" class=\"flex items-center gap-1 rounded px-1.5 py-0.5 text-[11px] text-gray-500 transition hover:bg-gray-100 hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-gray-200\">\n        <svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\" /><path d=\"M5 15V5a2 2 0 012-2h10\" /></svg>\n        Copy output\n      </button>\n    </div>\n  </div>\n\n  <!-- Failure -->\n  <div class=\"overflow-hidden rounded-xl border border-red-200 dark:border-red-500/25\">\n    <div class=\"flex items-center gap-2 border-b border-red-200 bg-red-50/70 px-3 py-2 dark:border-red-500/25 dark:bg-red-500/10\">\n      <svg class=\"h-3.5 w-3.5 shrink-0 text-red-500 dark:text-red-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n      <code class=\"min-w-0 flex-1 truncate font-mono text-[12px] text-gray-800 dark:text-gray-200\">pnpm build --filter web</code>\n      <span class=\"shrink-0 rounded-full bg-red-100 px-2 py-0.5 text-[10.5px] font-medium text-red-700 dark:bg-red-500/15 dark:text-red-300\">exit 1</span>\n    </div>\n    <pre class=\"max-h-40 overflow-auto bg-white px-3 py-2.5 font-mono text-[11.5px] leading-relaxed text-red-600 dark:bg-neutral-950 dark:text-red-400\">error TS2345: Argument of type 'string | undefined'\n  is not assignable to parameter of type 'string'.\n  src/server/session.ts:42:18</pre>\n  </div>\n</div>\n"
    }
  ]
}
