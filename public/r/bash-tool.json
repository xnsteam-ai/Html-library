{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "bash-tool",
  "title": "Bash Tool",
  "description": "Terminal tool calls: command header, scrollable output, exit-status pill, duration footer, and a failed variant.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "tool",
    "terminal",
    "output"
  ],
  "files": [
    {
      "path": "bash-tool.html",
      "type": "html",
      "content": "<!--\n  Bash Tool — collapsible command output, no JavaScript.\n  Each card is a native <details>: click the command header to fold the\n  output away. The chevron rotates via `group-open:`.\n-->\n<div class=\"mx-auto w-full max-w-2xl space-y-3\">\n  <!-- Success -->\n  <details open class=\"group/bash overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n    <summary class=\"flex cursor-pointer list-none items-center gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 transition hover:bg-gray-100 [&::-webkit-details-marker]:hidden dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10\">\n      <svg class=\"h-3 w-3 shrink-0 text-muted-foreground transition group-open/bash:rotate-90 dark:text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n      <svg class=\"h-3.5 w-3.5 shrink-0 text-muted-foreground dark:text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n      <code class=\"min-w-0 flex-1 truncate font-mono text-[12px] text-foreground dark:text-gray-200\">npm run test -- --reporter=dot</code>\n      <span class=\"flex shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10.5px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">\n        <svg class=\"h-2.5 w-2.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\n        exit 0\n      </span>\n    </summary>\n    <pre class=\"max-h-52 overflow-auto bg-white px-3 py-2.5 font-mono text-[11.5px] leading-relaxed text-muted-foreground dark:bg-neutral-950 dark:text-muted-foreground\">····················\n Test Files  18 passed (18)\n      Tests  214 passed (214)\n   Duration  6.42s</pre>\n    <div class=\"flex items-center justify-between border-t border-gray-200 px-3 py-1.5 dark:border-white/10\">\n      <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">6.4s · 4 lines</span>\n      <span class=\"text-[11px] text-muted-foreground dark:text-muted-foreground\">exit 0</span>\n    </div>\n  </details>\n\n  <!-- Failure, collapsed by default -->\n  <details class=\"group/bash overflow-hidden rounded-xl border border-red-200 dark:border-red-500/25\">\n    <summary class=\"flex cursor-pointer list-none items-center gap-2 bg-red-50/70 px-3 py-2 transition hover:bg-red-100/70 [&::-webkit-details-marker]:hidden dark:bg-red-500/10 dark:hover:bg-red-500/15\">\n      <svg class=\"h-3 w-3 shrink-0 text-red-400 transition group-open/bash:rotate-90\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n      <svg class=\"h-3.5 w-3.5 shrink-0 text-red-500 dark:text-red-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n      <code class=\"min-w-0 flex-1 truncate font-mono text-[12px] text-foreground dark:text-gray-200\">pnpm build --filter web</code>\n      <span class=\"shrink-0 rounded-full bg-red-100 px-2 py-0.5 text-[10.5px] font-medium text-red-700 dark:bg-red-500/15 dark:text-red-300\">exit 1</span>\n    </summary>\n    <pre class=\"max-h-40 overflow-auto border-t border-red-200 bg-white px-3 py-2.5 font-mono text-[11.5px] leading-relaxed text-red-600 dark:border-red-500/25 dark:bg-neutral-950 dark:text-red-400\">error TS2345: Argument of type 'string | undefined'\n  is not assignable to parameter of type 'string'.\n  src/server/session.ts:42:18</pre>\n  </details>\n</div>\n"
    }
  ]
}
