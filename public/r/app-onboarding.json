  "files": [
    {
      "path": "app-onboarding.html",
      "type": "html",
      "content": "<!-- App Onboarding — welcome screen with paged hero, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-white dark:bg-neutral-950\">\n  <!-- Status bar -->\n  <div class=\"flex items-center justify-between px-6 pb-1 pt-3.5\">\n    <span class=\"text-[13px] font-semibold text-gray-900 dark:text-gray-100\">9:41</span>\n    <div class=\"flex items-center gap-1.5 text-gray-900 dark:text-gray-100\">\n      <svg class=\"h-3 w-4\" viewBox=\"0 0 18 12\" fill=\"currentColor\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\" /><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"1\" /><rect x=\"10\" y=\"2\" width=\"3\" height=\"10\" rx=\"1\" /><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\" opacity=\"0.35\" /></svg>\n      <svg class=\"h-3 w-4\" viewBox=\"0 0 16 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"><path d=\"M1 4.5a10 10 0 0114 0M3.5 7.5a6.5 6.5 0 019 0M7 10.5l1 1 1-1\" /></svg>\n      <svg class=\"h-3 w-6\" viewBox=\"0 0 26 12\" fill=\"none\"><rect x=\"0.5\" y=\"0.5\" width=\"21\" height=\"11\" rx=\"3\" stroke=\"currentColor\" opacity=\"0.4\" /><rect x=\"2\" y=\"2\" width=\"15\" height=\"8\" rx=\"1.5\" fill=\"currentColor\" /><path d=\"M23 4v4a2.5 2.5 0 000-4z\" fill=\"currentColor\" opacity=\"0.5\" /></svg>\n    </div>\n  </div>\n\n  <!-- Hero -->\n  <div class=\"flex flex-1 flex-col items-center justify-center px-8\">\n    <div class=\"relative mb-10 flex h-56 w-56 items-center justify-center\">\n      <div class=\"absolute inset-0 rounded-full bg-gradient-to-br from-orange-100 via-rose-100 to-violet-100 dark:from-orange-500/20 dark:via-rose-500/15 dark:to-violet-500/20\"></div>\n      <div class=\"absolute inset-8 rounded-full bg-gradient-to-tr from-white to-gray-50 shadow-sm dark:from-neutral-900 dark:to-neutral-800\"></div>\n      <svg class=\"relative h-16 w-16 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1.5l1.6 8.9 6.3-4.8-4.8 6.3 8.9 1.6-8.9 1.6 4.8 6.3-6.3-4.8-1.6 8.9-1.6-8.9-6.3 4.8 4.8-6.3L-.5 13.5l8.9-1.6-4.8-6.3 6.3 4.8z\" /></svg>\n    </div>\n\n    <h1 class=\"text-center text-[28px] font-semibold leading-tight tracking-tight text-gray-900 dark:text-gray-100\">\n      Everything you build,<br />in one place\n    </h1>\n    <p class=\"mt-3 text-center text-[15px] leading-relaxed text-gray-500 dark:text-gray-400\">\n      Track projects, ship faster, and keep your team in sync — without the busywork.\n    </p>\n\n    <!-- Page dots -->\n    <div class=\"mt-8 flex items-center gap-1.5\">\n      <span class=\"h-1.5 w-6 rounded-full bg-gray-900 dark:bg-white\"></span>\n      <span class=\"h-1.5 w-1.5 rounded-full bg-gray-300 dark:bg-white/25\"></span>\n      <span class=\"h-1.5 w-1.5 rounded-full bg-gray-300 dark:bg-white/25\"></span>\n    </div>\n  </div>\n\n  <!-- Actions -->\n  <div class=\"space-y-3 px-6 pb-3\">\n    <button type=\"button\" class=\"w-full rounded-2xl bg-gray-900 py-4 text-[15px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">\n      Get started\n    </button>\n    <button type=\"button\" class=\"flex w-full items-center justify-center gap-2 rounded-2xl border border-gray-200 py-4 text-[15px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">\n      <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0012 2z\" /></svg>\n      Continue with GitHub\n    </button>\n    <p class=\"pt-1 text-center text-[12px] text-gray-400 dark:text-gray-500\">\n      Already have an account?\n      <a href=\"#\" class=\"font-medium text-gray-900 dark:text-gray-100\">Sign in</a>\n    </p>\n  </div>\n\n  <!-- Home indicator -->\n  <div class=\"flex justify-center pb-2 pt-1\">\n    <span class=\"h-1 w-32 rounded-full bg-gray-900/80 dark:bg-white/60\"></span>\n  </div>\n</div>\n"
    }
  ]
}
