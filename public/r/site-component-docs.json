{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "site-component-docs",
  "title": "Component Docs",
  "description": "A design-system component reference: category nav tree, live stage preview, best-practices table, examples, and an on-this-page rail.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
