  "surface": "site",
  "files": [
    {
      "path": "site-component-docs.html",
      "type": "html",
      "content": "<!-- Site Component Docs — restored with its own scoped Astryx theme -->\n<style>\n  .scd-root {\n    --bg-app: #f4f4f6; --bg-surface-raised: #ffffff; --bg-hover: rgba(0,0,0,.04);\n    --border-color: rgba(0,0,0,.08); --text-primary: #171717; --text-secondary: #555555; --text-muted: #999999;\n    --code-bg: #f8f9fa; --code-border: #e2e8f0;\n    --badge-success-bg: rgba(34,197,94,.1); --badge-success-fg: #15803d;\n    --badge-error-bg: rgba(239,68,68,.1); --badge-error-fg: #b91c1c;\n  }\n  .dark .scd-root {\n    --bg-app: #141414; --bg-surface-raised: #222222; --bg-hover: rgba(255,255,255,.04);\n    --border-color: rgba(255,255,255,.07); --text-primary: #e8e8e8; --text-secondary: #999999; --text-muted: #555555;\n    --code-bg: #1a1a1a; --code-border: rgba(255,255,255,.08);\n    --badge-success-bg: rgba(34,197,94,.15); --badge-success-fg: #4ade80;\n    --badge-error-bg: rgba(239,68,68,.15); --badge-error-fg: #f87171;\n  }\n</style>\n\n<div class=\"scd-root flex h-[800px] w-[1280px] flex-col overflow-hidden bg-[var(--bg-app)]\">\n  <header class=\"flex items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-surface-raised)] px-6 py-3\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--bg-hover)] text-sm font-bold text-[var(--text-primary)]\">A</span>\n      <div>\n        <h2 class=\"text-[13.5px] font-semibold text-[var(--text-primary)]\">Astryx Design System</h2>\n        <p class=\"text-[11px] text-[var(--text-muted)]\">v2.4.0 · Component Documentation</p>\n      </div>\n    </div>\n    <div class=\"flex w-72 items-center gap-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-app)] px-3 py-1.5 text-[12px] text-[var(--text-muted)]\">\n      <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n      <span>Search documentation...</span>\n      <span class=\"ml-auto rounded border border-[var(--border-color)] px-1 text-[10px]\">⌘K</span>\n    </div>\n  </header>\n\n  <div class=\"flex flex-1 min-h-0\">\n    <aside class=\"flex w-60 shrink-0 flex-col gap-6 overflow-y-auto border-r border-[var(--border-color)] bg-[var(--bg-surface-raised)] p-4\">\n      <div>\n        <p class=\"mb-1 px-2.5 text-[11px] font-semibold uppercase tracking-wider text-[var(--text-muted)]\">Core</p>\n        <div class=\"flex flex-col gap-0.5 text-[13px]\">\n          <span class=\"rounded-md bg-[var(--bg-hover)] px-2.5 py-1.5 font-semibold text-[var(--text-primary)]\">Button</span>\n          <span class=\"rounded-md px-2.5 py-1.5 text-[var(--text-secondary)]\">Avatar</span>\n          <span class=\"rounded-md px-2.5 py-1.5 text-[var(--text-secondary)]\">Badge</span>\n          <span class=\"rounded-md px-2.5 py-1.5 text-[var(--text-secondary)]\">Banner</span>\n          <span class=\"rounded-md px-2.5 py-1.5 text-[var(--text-secondary)]\">Card</span>\n          <span class=\"rounded-md px-2.5 py-1.5 text-[var(--text-secondary)]\">Dialog</span>\n        </div>\n      </div>\n      <div>\n        <p class=\"mb-1 px-2.5 text-[11px] font-semibold uppercase tracking-wider text-[var(--text-muted)]\">Typography</p>\n        <div class=\"flex flex-col gap-0.5 text-[13px] text-[var(--text-secondary)]\">\n          <span class=\"rounded-md px-2.5 py-1.5\">Heading</span>\n          <span class=\"rounded-md px-2.5 py-1.5\">Text</span>\n        </div>\n      </div>\n      <div>\n        <p class=\"mb-1 px-2.5 text-[11px] font-semibold uppercase tracking-wider text-[var(--text-muted)]\">Layout</p>\n        <div class=\"flex flex-col gap-0.5 text-[13px] text-[var(--text-secondary)]\">\n          <span class=\"rounded-md px-2.5 py-1.5\">AppShell</span>\n          <span class=\"rounded-md px-2.5 py-1.5\">Grid</span>\n          <span class=\"rounded-md px-2.5 py-1.5\">Section</span>\n          <span class=\"rounded-md px-2.5 py-1.5\">Stack</span>\n        </div>\n      </div>\n    </aside>\n\n    <main class=\"flex flex-1 justify-center overflow-y-auto p-10\">\n      <div class=\"flex w-full max-w-2xl flex-col gap-8\">\n        <div class=\"border-b border-[var(--border-color)] pb-5\">\n          <h1 class=\"text-[32px] font-bold tracking-tight text-[var(--text-primary)]\">Button</h1>\n          <p class=\"mt-1 text-[12px] text-[var(--text-muted)]\">March 30, 2026 · Updated 5:40 p.m. PST</p>\n        </div>\n\n        <div class=\"flex min-h-[160px] items-center justify-center rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface-raised)] p-10 shadow-sm\">\n          <button type=\"button\" class=\"flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface-raised)] px-3.5 py-1.5 text-[13px] font-medium text-[var(--text-primary)] shadow-sm\">\n            <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\" /></svg>\n            Button\n            <span class=\"rounded bg-blue-500/10 px-1.5 py-0.5 text-[10px] font-semibold text-blue-500\">New</span>\n          </button>\n        </div>\n\n        <section class=\"flex flex-col gap-3\">\n          <h2 class=\"text-[18px] font-bold text-[var(--text-primary)]\">Usage</h2>\n          <p class=\"text-[14px] leading-relaxed text-[var(--text-secondary)]\">Buttons provide visual cues for actions and events. Use a Button when a user needs to submit a form, start a new task, or trigger a new UI element to appear on the page.</p>\n        </section>\n\n        <section class=\"flex flex-col gap-3\">\n          <h3 class=\"text-[15px] font-semibold text-[var(--text-primary)]\">Best practices</h3>\n          <div class=\"overflow-hidden rounded-xl border border-[var(--border-color)] text-[12.5px]\">\n            <table class=\"w-full border-collapse text-left\">\n              <tbody class=\"divide-y divide-[var(--border-color)]\">\n                <tr>\n                  <td class=\"w-24 px-4 py-2.5\"><span class=\"rounded px-2 py-0.5 text-[11px] font-semibold\" style=\"background:var(--badge-success-bg);color:var(--badge-success-fg)\">Do</span></td>\n                  <td class=\"px-4 py-2.5 text-[var(--text-secondary)]\">Each surface should only have one primary button.</td>\n                </tr>\n                <tr>\n                  <td class=\"px-4 py-2.5\"><span class=\"rounded px-2 py-0.5 text-[11px] font-semibold\" style=\"background:var(--badge-error-bg);color:var(--badge-error-fg)\">Don't</span></td>\n                  <td class=\"px-4 py-2.5 text-[var(--text-secondary)]\">Overuse colored buttons — it creates visual confusion.</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </section>\n\n        <section class=\"flex flex-col gap-4 border-t border-[var(--border-color)] pt-5\">\n          <h2 class=\"text-[18px] font-bold text-[var(--text-primary)]\">Examples</h2>\n          <div class=\"overflow-hidden rounded-xl border border-[var(--border-color)] shadow-sm\">\n            <div class=\"flex items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-hover)] px-4 py-2.5\">\n              <span class=\"text-[12.5px] font-semibold text-[var(--text-primary)]\">Semantics</span>\n              <span class=\"rounded border border-[var(--border-color)] px-2 py-1 text-[11px] text-[var(--text-muted)]\">Copy</span>\n            </div>\n            <div class=\"flex min-h-[100px] items-center justify-center gap-2 bg-[var(--bg-app)] p-8\">\n              <button type=\"button\" class=\"rounded-lg px-3 py-1.5 text-[13px] font-medium text-[var(--text-secondary)]\">Flat</button>\n              <button type=\"button\" class=\"rounded-lg border border-[var(--border-color)] px-3 py-1.5 text-[13px] font-medium text-[var(--text-primary)]\">Default</button>\n              <button type=\"button\" class=\"rounded-lg bg-[var(--text-primary)] px-3 py-1.5 text-[13px] font-medium text-[var(--bg-app)]\">Primary</button>\n              <button type=\"button\" class=\"rounded-lg bg-red-600/10 px-3 py-1.5 text-[13px] font-medium text-red-500\">Destructive</button>\n            </div>\n          </div>\n        </section>\n      </div>\n    </main>\n\n    <aside class=\"flex w-48 shrink-0 flex-col gap-3 border-l border-[var(--border-color)] bg-[var(--bg-surface-raised)] p-6\">\n      <span class=\"text-[11px] font-semibold uppercase tracking-wider text-[var(--text-muted)]\">On this page</span>\n      <div class=\"flex flex-col gap-1 text-[12.5px]\">\n        <span class=\"border-l-2 border-[var(--text-primary)] pl-2.5 font-medium text-[var(--text-primary)]\">Usage</span>\n        <span class=\"border-l-2 border-transparent pl-2.5 text-[var(--text-muted)]\">Best practices</span>\n        <span class=\"border-l-2 border-transparent pl-2.5 text-[var(--text-muted)]\">Examples</span>\n      </div>\n    </aside>\n  </div>\n</div>\n"
    }
  ]
}
