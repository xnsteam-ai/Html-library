{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "radio-card-group",
  "title": "Radio Card Group",
  "description": "Selectable plan cards backed by native radio inputs — checked, hover and disabled states are driven entirely by CSS, so selection works without JavaScript.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "radio",
    "form",
    "selection",
    "pricing"
  ],
  "files": [
    {
      "path": "radio-card-group.html",
      "type": "html",
      "content": "<!--\n  Radio Card Group — selectable plan cards.\n  Selection is real: each card wraps a native radio input. The marker uses\n  `peer-checked` (direct sibling) and the card shell / inner dot use the\n  id-qualified `has-[#id:checked]` form, so the control works with no\n  JavaScript. Ids are prefixed `rcg-` so several screens can share a page.\n-->\n<div class=\"mx-auto w-full max-w-2xl\">\n  <fieldset>\n    <legend class=\"mb-3 text-[13px] font-medium text-gray-900 dark:text-gray-100\">Choose a plan</legend>\n\n    <div class=\"grid grid-cols-1 gap-3 sm:grid-cols-2\">\n      <!-- Starter — selected by default -->\n      <label\n        for=\"rcg-starter\"\n        class=\"group/starter relative flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:bg-gray-50 has-[#rcg-starter:checked]:border-gray-900 has-[#rcg-starter:checked]:ring-1 has-[#rcg-starter:checked]:ring-gray-900 dark:border-white/15 dark:bg-neutral-900 dark:hover:bg-white/5 dark:has-[#rcg-starter:checked]:border-white dark:has-[#rcg-starter:checked]:ring-white\"\n      >\n        <input id=\"rcg-starter\" type=\"radio\" name=\"rcg-plan\" class=\"peer sr-only\" checked />\n        <span\n          class=\"mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-gray-300 transition peer-checked:border-gray-900 peer-checked:bg-gray-900 dark:border-white/25 dark:peer-checked:border-white dark:peer-checked:bg-white\"\n        >\n          <span class=\"h-1.5 w-1.5 rounded-full bg-white opacity-0 transition group-has-[#rcg-starter:checked]/starter:opacity-100 dark:bg-neutral-900\"></span>\n        </span>\n        <span class=\"grid gap-0.5\">\n          <span class=\"text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">Starter</span>\n          <span class=\"text-[12px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            Perfect for side projects and learning.\n          </span>\n          <span class=\"mt-1.5 text-[13px] font-semibold text-gray-900 dark:text-gray-100\">$9/month</span>\n        </span>\n      </label>\n\n      <!-- Pro -->\n      <label\n        for=\"rcg-pro\"\n        class=\"group/pro relative flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:bg-gray-50 has-[#rcg-pro:checked]:border-gray-900 has-[#rcg-pro:checked]:ring-1 has-[#rcg-pro:checked]:ring-gray-900 dark:border-white/15 dark:bg-neutral-900 dark:hover:bg-white/5 dark:has-[#rcg-pro:checked]:border-white dark:has-[#rcg-pro:checked]:ring-white\"\n      >\n        <input id=\"rcg-pro\" type=\"radio\" name=\"rcg-plan\" class=\"peer sr-only\" />\n        <span\n          class=\"mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-gray-300 transition peer-checked:border-gray-900 peer-checked:bg-gray-900 dark:border-white/25 dark:peer-checked:border-white dark:peer-checked:bg-white\"\n        >\n          <span class=\"h-1.5 w-1.5 rounded-full bg-white opacity-0 transition group-has-[#rcg-pro:checked]/pro:opacity-100 dark:bg-neutral-900\"></span>\n        </span>\n        <span class=\"grid gap-0.5\">\n          <span class=\"flex items-center gap-1.5 text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">\n            Pro\n            <span class=\"rounded-full bg-gray-900 px-1.5 py-0.5 text-[10px] font-medium text-white dark:bg-white dark:text-neutral-900\">\n              Popular\n            </span>\n          </span>\n          <span class=\"text-[12px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            For teams shipping to production.\n          </span>\n          <span class=\"mt-1.5 text-[13px] font-semibold text-gray-900 dark:text-gray-100\">$29/month</span>\n        </span>\n      </label>\n\n      <!-- Scale -->\n      <label\n        for=\"rcg-scale\"\n        class=\"group/scale relative flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:bg-gray-50 has-[#rcg-scale:checked]:border-gray-900 has-[#rcg-scale:checked]:ring-1 has-[#rcg-scale:checked]:ring-gray-900 dark:border-white/15 dark:bg-neutral-900 dark:hover:bg-white/5 dark:has-[#rcg-scale:checked]:border-white dark:has-[#rcg-scale:checked]:ring-white\"\n      >\n        <input id=\"rcg-scale\" type=\"radio\" name=\"rcg-plan\" class=\"peer sr-only\" />\n        <span\n          class=\"mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-gray-300 transition peer-checked:border-gray-900 peer-checked:bg-gray-900 dark:border-white/25 dark:peer-checked:border-white dark:peer-checked:bg-white\"\n        >\n          <span class=\"h-1.5 w-1.5 rounded-full bg-white opacity-0 transition group-has-[#rcg-scale:checked]/scale:opacity-100 dark:bg-neutral-900\"></span>\n        </span>\n        <span class=\"grid gap-0.5\">\n          <span class=\"text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">Scale</span>\n          <span class=\"text-[12px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            Higher limits and priority support.\n          </span>\n          <span class=\"mt-1.5 text-[13px] font-semibold text-gray-900 dark:text-gray-100\">$99/month</span>\n        </span>\n      </label>\n\n      <!-- Enterprise — disabled -->\n      <label\n        for=\"rcg-enterprise\"\n        class=\"relative flex cursor-not-allowed items-start gap-3 rounded-xl border border-gray-200 bg-gray-50 p-4 opacity-60 dark:border-white/10 dark:bg-white/5\"\n      >\n        <input id=\"rcg-enterprise\" type=\"radio\" name=\"rcg-plan\" class=\"sr-only\" disabled />\n        <span class=\"mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-gray-300 dark:border-white/20\"></span>\n        <span class=\"grid gap-0.5\">\n          <span class=\"text-[13.5px] font-semibold text-gray-900 dark:text-gray-100\">Enterprise</span>\n          <span class=\"text-[12px] leading-relaxed text-gray-600 dark:text-muted-foreground\">\n            Contact sales for custom terms.\n          </span>\n          <span class=\"mt-1.5 text-[13px] font-semibold text-gray-600 dark:text-muted-foreground\">Talk to us</span>\n        </span>\n      </label>\n    </div>\n  </fieldset>\n</div>\n"
    }
  ]
}
