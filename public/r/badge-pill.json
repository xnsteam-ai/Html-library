{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "badge-pill",
  "title": "Badge Pill",
  "description": "shadcn-style semantic badge variants — default, secondary, outline and destructive — for labelling status inside a larger component.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "badge",
    "label",
    "variants",
    "status"
  ],
  "files": [
    {
      "path": "badge-pill.html",
      "type": "html",
      "content": "<!--\n  Badge Pill — shadcn-style semantic variants: default, secondary, outline\n  and destructive, each with a focus ring for keyboard use inside a\n  focusable parent (e.g. wrapped in a button or link).\n-->\n<div class=\"mx-auto w-full max-w-lg\">\n  <div class=\"flex flex-wrap items-center gap-2\">\n    <span class=\"inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border border-transparent bg-gray-900 px-2 text-xs font-medium text-white transition-all dark:bg-white dark:text-neutral-900\">\n      Default\n    </span>\n    <span class=\"inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border border-transparent bg-gray-100 px-2 text-xs font-medium text-gray-700 transition-all dark:bg-white/10 dark:text-gray-300\">\n      Secondary\n    </span>\n    <span class=\"inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border border-gray-200 px-2 text-xs font-medium text-gray-900 transition-all dark:border-white/15 dark:text-gray-100\">\n      Outline\n    </span>\n    <span class=\"inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border border-transparent bg-red-50 px-2 text-xs font-medium text-red-600 transition-all dark:bg-red-500/15 dark:text-red-400\">\n      Destructive\n    </span>\n  </div>\n</div>\n"
    }
  ]
}
