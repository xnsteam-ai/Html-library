{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "prompt-composer",
  "title": "Prompt Composer",
  "description": "A rounded message box with an inline toolbar — attachment, agent and model pickers on the left, send on the right. The shell lights up on focus-within.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "textarea",
    "composer",
    "toolbar",
    "form"
  ],
  "files": [
    {
      "path": "prompt-composer.html",
      "type": "html",
      "content": "<!--\n  Prompt Composer — a rounded message box with an inline toolbar.\n  The textarea, model pickers and send button are real controls; the focus ring\n  is driven by `focus-within` so the whole shell lights up as you type.\n-->\n<div class=\"mx-auto w-full max-w-[640px]\">\n  <form\n    class=\"overflow-hidden rounded-[24px] border border-gray-200 bg-white transition focus-within:border-gray-300 focus-within:ring-1 focus-within:ring-gray-100 dark:border-white/15 dark:bg-neutral-900 dark:focus-within:border-white/25 dark:focus-within:ring-white/10\"\n  >\n    <label for=\"pc-message\" class=\"sr-only\">Message</label>\n    <textarea\n      id=\"pc-message\"\n      rows=\"1\"\n      placeholder=\"Send a message…\"\n      class=\"block w-full resize-none bg-transparent px-4 pb-2 pt-4 text-[15px] leading-relaxed text-gray-800 outline-none placeholder:text-gray-400 dark:text-gray-100 dark:placeholder:text-gray-600\"\n    ></textarea>\n\n    <div class=\"flex items-center justify-between px-3 pb-3 pt-1\">\n      <!-- Left controls -->\n      <div class=\"flex items-center gap-0.5\">\n        <button\n          type=\"button\"\n          class=\"rounded-lg p-1.5 text-gray-400 transition hover:bg-gray-50 hover:text-gray-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-200 dark:hover:bg-white/10 dark:hover:text-gray-200 dark:focus-visible:ring-white/20\"\n          aria-label=\"Add attachment\"\n        >\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 5v14M5 12h14\" />\n          </svg>\n        </button>\n\n        <button\n          type=\"button\"\n          class=\"flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-[13px] text-gray-600 transition hover:bg-gray-50 hover:text-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-200 dark:text-muted-foreground dark:hover:bg-white/10 dark:hover:text-gray-100 dark:focus-visible:ring-white/20\"\n          aria-haspopup=\"listbox\"\n          aria-expanded=\"false\"\n        >\n          <svg class=\"text-gray-400 dark:text-muted-foreground\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z\" />\n          </svg>\n          Agent\n          <svg class=\"ml-0.5 text-gray-400 opacity-70 dark:text-muted-foreground\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polyline points=\"6 9 12 15 18 9\" />\n          </svg>\n        </button>\n\n        <button\n          type=\"button\"\n          class=\"flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-[13px] text-gray-600 transition hover:bg-gray-50 hover:text-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-200 dark:text-muted-foreground dark:hover:bg-white/10 dark:hover:text-gray-100 dark:focus-visible:ring-white/20\"\n          aria-haspopup=\"listbox\"\n          aria-expanded=\"false\"\n        >\n          Sonnet 4.6\n          <svg class=\"ml-0.5 text-gray-400 opacity-70 dark:text-muted-foreground\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polyline points=\"6 9 12 15 18 9\" />\n          </svg>\n        </button>\n      </div>\n\n      <!-- Send -->\n      <button\n        type=\"submit\"\n        class=\"mr-1 flex h-[30px] w-[30px] items-center justify-center rounded-full bg-gray-100 text-gray-400 transition hover:bg-gray-200 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-200 dark:bg-white/10 dark:text-muted-foreground dark:hover:bg-white/20 dark:hover:text-gray-100 dark:focus-visible:ring-white/20\"\n        aria-label=\"Send message\"\n      >\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 19V5M5 12l7-7 7 7\" />\n        </svg>\n      </button>\n    </div>\n  </form>\n</div>\n"
    }
  ]
}
