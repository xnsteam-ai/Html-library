{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "app-feed",
  "title": "Content Feed",
  "description": "A discovery feed: category chips, a featured card with a real photo, compact list rows with author avatars, and a four-item tab bar.",
  "category": "apps",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "feed",
    "list",
    "tab-bar"
  ],
  "surface": "app",
  "files": [
    {
      "path": "app-feed.html",
      "type": "html",
      "content": "<!-- App Feed — social/content feed with tab bar, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-white dark:bg-neutral-950\">\n  <!-- Header -->\n  <header class=\"flex items-center justify-between px-5 py-3\">\n    <h1 class=\"text-[22px] font-semibold tracking-tight text-foreground dark:text-gray-100\">Discover</h1>\n    <div class=\"flex items-center gap-1\">\n      <button type=\"button\" class=\"rounded-full p-2 text-muted-foreground transition hover:bg-gray-100 dark:text-muted-foreground dark:hover:bg-white/10\" aria-label=\"Search\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n      </button>\n      <img src=\"https://i.pravatar.cc/64?img=36\" alt=\"Rina Delgado\" class=\"ml-1 h-8 w-8 rounded-full object-cover\" />\n    </div>\n  </header>\n\n  <!-- Category chips -->\n  <div class=\"flex gap-2 overflow-hidden px-5 pb-3\" role=\"radiogroup\" aria-label=\"Category\">\n    <label><input type=\"radio\" name=\"app-feed-category\" class=\"peer sr-only\" checked /><span class=\"block cursor-pointer whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-muted-foreground transition peer-checked:bg-gray-900 peer-checked:text-white dark:bg-white/10 dark:text-muted-foreground dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">For you</span></label>\n    <label><input type=\"radio\" name=\"app-feed-category\" class=\"peer sr-only\" /><span class=\"block cursor-pointer whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-muted-foreground transition peer-checked:bg-gray-900 peer-checked:text-white dark:bg-white/10 dark:text-muted-foreground dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">Design</span></label>\n    <label><input type=\"radio\" name=\"app-feed-category\" class=\"peer sr-only\" /><span class=\"block cursor-pointer whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-muted-foreground transition peer-checked:bg-gray-900 peer-checked:text-white dark:bg-white/10 dark:text-muted-foreground dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">Engineering</span></label>\n    <label><input type=\"radio\" name=\"app-feed-category\" class=\"peer sr-only\" /><span class=\"block cursor-pointer whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-muted-foreground transition peer-checked:bg-gray-900 peer-checked:text-white dark:bg-white/10 dark:text-muted-foreground dark:peer-checked:bg-white dark:peer-checked:text-neutral-900\">AI</span></label>\n  </div>\n\n  <!-- Feed -->\n  <div class=\"flex-1 space-y-5 overflow-hidden px-5 pt-1\">\n    <!-- Featured card -->\n    <article>\n      <div class=\"relative mb-3 h-44 overflow-hidden rounded-2xl\">\n        <img\n          src=\"https://images.unsplash.com/photo-1581287053822-fd7bf4f4bfec?q=80&w=800&auto=format&fit=crop\"\n          alt=\"UI design workspace\"\n          class=\"h-full w-full object-cover\"\n        />\n        <span class=\"absolute left-3 top-3 rounded-full bg-black/25 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur\">Featured</span>\n        <div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/50 to-transparent p-4\">\n          <h2 class=\"text-[17px] font-semibold leading-snug text-white\">Designing interfaces that explain themselves</h2>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <img src=\"https://i.pravatar.cc/48?img=5\" alt=\"Elena Koch\" class=\"h-6 w-6 rounded-full object-cover\" />\n        <span class=\"text-[12.5px] text-muted-foreground dark:text-muted-foreground\">Elena Koch · 6 min read</span>\n      </div>\n    </article>\n\n    <!-- List items -->\n    <article class=\"flex gap-3\">\n      <img\n        src=\"https://images.unsplash.com/photo-1547027072-332f09bd6bb3?q=80&w=200&auto=format&fit=crop\"\n        alt=\"Abstract layered code visual\"\n        class=\"h-[72px] w-[72px] shrink-0 rounded-xl object-cover\"\n      />\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-foreground dark:text-gray-100\">The quiet cost of premature abstraction</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">Every layer you add today is a layer someone reads at 2am.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-muted-foreground dark:text-muted-foreground\">Marta Ruiz · 4 min</span>\n      </div>\n    </article>\n\n    <article class=\"flex gap-3\">\n      <img\n        src=\"https://images.unsplash.com/photo-1559028006-448665bd7c7f?q=80&w=200&auto=format&fit=crop\"\n        alt=\"Design system UI components\"\n        class=\"h-[72px] w-[72px] shrink-0 rounded-xl object-cover\"\n      />\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-foreground dark:text-gray-100\">Shipping a design system nobody fights</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">Adoption is a distribution problem, not a component problem.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-muted-foreground dark:text-muted-foreground\">Theo Baptiste · 9 min</span>\n      </div>\n    </article>\n\n    <article class=\"flex gap-3\">\n      <img\n        src=\"https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=200&auto=format&fit=crop\"\n        alt=\"Code editor close-up\"\n        class=\"h-[72px] w-[72px] shrink-0 rounded-xl object-cover\"\n      />\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-foreground dark:text-gray-100\">What we learned rewriting the editor</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">Three rewrites, one lesson: measure before you migrate.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-muted-foreground dark:text-muted-foreground\">Priya Anand · 12 min</span>\n      </div>\n    </article>\n  </div>\n\n  <!-- Tab bar -->\n  <nav class=\"border-t border-gray-200 bg-white/90 px-6 pb-5 pt-2.5 backdrop-blur dark:border-white/10 dark:bg-neutral-950/90\">\n    <div class=\"flex items-center justify-between\">\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-foreground dark:text-gray-100\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 11l9-8 9 8v9a2 2 0 01-2 2h-4v-7h-6v7H5a2 2 0 01-2-2z\" /></svg>\n        <span class=\"text-[10px] font-medium\">Home</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-muted-foreground dark:text-muted-foreground\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n        <span class=\"text-[10px]\">Search</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-muted-foreground dark:text-muted-foreground\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 21l-7-4-7 4V5a2 2 0 012-2h10a2 2 0 012 2z\" /></svg>\n        <span class=\"text-[10px]\">Saved</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-muted-foreground dark:text-muted-foreground\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.5\" /><path d=\"M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6\" /></svg>\n        <span class=\"text-[10px]\">Profile</span>\n      </button>\n    </div>\n    <div class=\"mt-2 flex justify-center\">\n      <span class=\"h-1 w-32 rounded-full bg-gray-900/80 dark:bg-white/60\"></span>\n    </div>\n  </nav>\n</div>\n"
    }
  ]
}
