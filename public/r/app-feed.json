{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "app-feed",
  "title": "Content Feed",
  "description": "A discovery feed: category chips, a featured card with gradient artwork, compact list rows, and a four-item tab bar.",
  "category": "apps",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "feed",
    "list",
    "tab-bar"
  ],
  "surface": "app",
  "files": [
    {
      "path": "app-feed.html",
      "type": "html",
      "content": "<!-- App Feed — social/content feed with tab bar, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-white dark:bg-neutral-950\">\n  <!-- Status bar -->\n  <div class=\"flex items-center justify-between px-6 pb-1 pt-3.5\">\n    <span class=\"text-[13px] font-semibold text-gray-900 dark:text-gray-100\">9:41</span>\n    <div class=\"flex items-center gap-1.5 text-gray-900 dark:text-gray-100\">\n      <svg class=\"h-3 w-4\" viewBox=\"0 0 18 12\" fill=\"currentColor\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\" /><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"1\" /><rect x=\"10\" y=\"2\" width=\"3\" height=\"10\" rx=\"1\" /><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\" opacity=\"0.35\" /></svg>\n      <svg class=\"h-3 w-6\" viewBox=\"0 0 26 12\" fill=\"none\"><rect x=\"0.5\" y=\"0.5\" width=\"21\" height=\"11\" rx=\"3\" stroke=\"currentColor\" opacity=\"0.4\" /><rect x=\"2\" y=\"2\" width=\"15\" height=\"8\" rx=\"1.5\" fill=\"currentColor\" /></svg>\n    </div>\n  </div>\n\n  <!-- Header -->\n  <header class=\"flex items-center justify-between px-5 py-3\">\n    <h1 class=\"text-[22px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Discover</h1>\n    <div class=\"flex items-center gap-1\">\n      <button type=\"button\" class=\"rounded-full p-2 text-gray-600 transition hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10\" aria-label=\"Search\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n      </button>\n      <span class=\"ml-1 flex h-8 w-8 items-center justify-center rounded-full bg-violet-600 text-[12px] font-semibold text-white\">R</span>\n    </div>\n  </header>\n\n  <!-- Category chips -->\n  <div class=\"flex gap-2 overflow-hidden px-5 pb-3\">\n    <span class=\"whitespace-nowrap rounded-full bg-gray-900 px-3.5 py-1.5 text-[12.5px] font-medium text-white dark:bg-white dark:text-neutral-900\">For you</span>\n    <span class=\"whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300\">Design</span>\n    <span class=\"whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300\">Engineering</span>\n    <span class=\"whitespace-nowrap rounded-full bg-gray-100 px-3.5 py-1.5 text-[12.5px] font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300\">AI</span>\n  </div>\n\n  <!-- Feed -->\n  <div class=\"flex-1 space-y-5 overflow-hidden px-5 pt-1\">\n    <!-- Featured card -->\n    <article>\n      <div class=\"relative mb-3 h-44 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-400 via-violet-400 to-fuchsia-400 dark:from-indigo-500/60 dark:via-violet-500/50 dark:to-fuchsia-500/60\">\n        <span class=\"absolute left-3 top-3 rounded-full bg-black/25 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur\">Featured</span>\n        <div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/50 to-transparent p-4\">\n          <h2 class=\"text-[17px] font-semibold leading-snug text-white\">Designing interfaces that explain themselves</h2>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <span class=\"flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300\">EK</span>\n        <span class=\"text-[12.5px] text-gray-600 dark:text-gray-400\">Elena Koch · 6 min read</span>\n      </div>\n    </article>\n\n    <!-- List items -->\n    <article class=\"flex gap-3\">\n      <div class=\"h-[72px] w-[72px] shrink-0 rounded-xl bg-gradient-to-br from-amber-200 to-orange-300 dark:from-amber-500/40 dark:to-orange-500/40\"></div>\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-gray-900 dark:text-gray-100\">The quiet cost of premature abstraction</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-gray-500 dark:text-gray-400\">Every layer you add today is a layer someone reads at 2am.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-gray-400 dark:text-gray-500\">Marta Ruiz · 4 min</span>\n      </div>\n    </article>\n\n    <article class=\"flex gap-3\">\n      <div class=\"h-[72px] w-[72px] shrink-0 rounded-xl bg-gradient-to-br from-sky-200 to-cyan-300 dark:from-sky-500/40 dark:to-cyan-500/40\"></div>\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-gray-900 dark:text-gray-100\">Shipping a design system nobody fights</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-gray-500 dark:text-gray-400\">Adoption is a distribution problem, not a component problem.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-gray-400 dark:text-gray-500\">Theo Baptiste · 9 min</span>\n      </div>\n    </article>\n\n    <article class=\"flex gap-3\">\n      <div class=\"h-[72px] w-[72px] shrink-0 rounded-xl bg-gradient-to-br from-rose-200 to-pink-300 dark:from-rose-500/40 dark:to-pink-500/40\"></div>\n      <div class=\"min-w-0 flex-1\">\n        <h3 class=\"text-[14.5px] font-medium leading-snug text-gray-900 dark:text-gray-100\">What we learned rewriting the editor</h3>\n        <p class=\"mt-1 line-clamp-2 text-[12.5px] leading-relaxed text-gray-500 dark:text-gray-400\">Three rewrites, one lesson: measure before you migrate.</p>\n        <span class=\"mt-1.5 block text-[11.5px] text-gray-400 dark:text-gray-500\">Priya Anand · 12 min</span>\n      </div>\n    </article>\n  </div>\n\n  <!-- Tab bar -->\n  <nav class=\"border-t border-gray-200 bg-white/90 px-6 pb-5 pt-2.5 backdrop-blur dark:border-white/10 dark:bg-neutral-950/90\">\n    <div class=\"flex items-center justify-between\">\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-900 dark:text-gray-100\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 11l9-8 9 8v9a2 2 0 01-2 2h-4v-7h-6v7H5a2 2 0 01-2-2z\" /></svg>\n        <span class=\"text-[10px] font-medium\">Home</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-400 dark:text-gray-500\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\" /><path d=\"M21 21l-4.3-4.3\" /></svg>\n        <span class=\"text-[10px]\">Search</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-400 dark:text-gray-500\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 21l-7-4-7 4V5a2 2 0 012-2h10a2 2 0 012 2z\" /></svg>\n        <span class=\"text-[10px]\">Saved</span>\n      </button>\n      <button type=\"button\" class=\"flex flex-1 flex-col items-center gap-1 text-gray-400 dark:text-gray-500\">\n        <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"3.5\" /><path d=\"M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6\" /></svg>\n        <span class=\"text-[10px]\">Profile</span>\n      </button>\n    </div>\n    <div class=\"mt-2 flex justify-center\">\n      <span class=\"h-1 w-32 rounded-full bg-gray-900/80 dark:bg-white/60\"></span>\n    </div>\n  </nav>\n</div>\n"
    }
  ]
}
