{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-features",
  "title": "Features",
  "description": "A six-item feature grid with icon tiles, an eyebrow label and a centred section heading.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "features",
    "grid",
    "marketing"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-features.html",
      "type": "html",
      "content": "<!-- Features Section — eyebrow, heading, three-column feature grid -->\n<section class=\"w-full bg-white px-6 py-24 dark:bg-neutral-950\">\n  <div class=\"mx-auto max-w-5xl\">\n    <div class=\"mx-auto max-w-2xl text-center\">\n      <p class=\"text-[12.5px] font-medium uppercase tracking-wide text-muted-foreground dark:text-muted-foreground\">Why teams switch</p>\n      <h2 class=\"mt-3 text-[38px] font-semibold leading-tight tracking-[-0.02em] text-foreground dark:text-gray-100\">\n        Everything the pipeline should have done already\n      </h2>\n      <p class=\"mt-4 text-[16px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n        Sensible defaults, no plugin archaeology, and the same behaviour on every machine.\n      </p>\n    </div>\n\n    <div class=\"mt-14 grid gap-x-8 gap-y-11 sm:grid-cols-2 lg:grid-cols-3\">\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2L4.5 13H11l-1 9 8.5-11H12z\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Builds in seconds</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          Content-addressed caching means only what actually changed gets rebuilt.\n        </p>\n      </div>\n\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 4v6c0 4.4-3.4 7.6-8 8-4.6-.4-8-3.6-8-8V7z\" /><path d=\"M9.5 12l2 2 3.5-4\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Preview every branch</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          A real URL per pull request, torn down automatically when you merge.\n        </p>\n      </div>\n\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 3v18h18\" /><path d=\"M7 15l4-4 3 3 5-6\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Regressions caught early</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          Bundle size and Core Web Vitals diffed against your base branch on every run.\n        </p>\n      </div>\n\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\" /><path d=\"M8 10V7a4 4 0 018 0v3\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Secrets stay secret</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          Encrypted at rest, scoped per environment, and never printed into a log.\n        </p>\n      </div>\n\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a9 9 0 11-3-6.7M21 4v5h-5\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Instant rollback</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          Every deploy is immutable, so going back is a pointer change, not a rebuild.\n        </p>\n      </div>\n\n      <div>\n        <span class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-gray-200\">\n          <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18z\" /></svg>\n        </span>\n        <h3 class=\"text-[16px] font-semibold text-foreground dark:text-gray-100\">Global by default</h3>\n        <p class=\"mt-2 text-[14px] leading-relaxed text-muted-foreground dark:text-muted-foreground\">\n          Assets served from 90 locations without a CDN to configure yourself.\n        </p>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
