{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "card",
  "title": "Card",
  "description": "A surface in three shapes: header/body/footer card, stat card with a bar sparkline, and a clickable link card.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "card",
    "surface",
    "layout"
  ],
  "files": [
    {
      "path": "card.html",
      "type": "html",
      "content": "<!-- Card — header, body, footer, and a compact stat variant -->\n<div class=\"mx-auto grid w-full max-w-2xl gap-4 sm:grid-cols-2\">\n  <!-- Standard card -->\n  <div class=\"overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-neutral-950\">\n    <div class=\"border-b border-gray-200 px-4 py-3 dark:border-white/10\">\n      <h3 class=\"text-[14px] font-semibold text-foreground dark:text-gray-100\">Deployment</h3>\n      <p class=\"mt-0.5 text-[12.5px] text-muted-foreground dark:text-muted-foreground\">Last shipped 14 minutes ago</p>\n    </div>\n    <div class=\"space-y-2.5 px-4 py-3.5\">\n      <div class=\"flex items-center justify-between text-[13px]\">\n        <span class=\"text-muted-foreground dark:text-muted-foreground\">Environment</span>\n        <span class=\"font-medium text-foreground dark:text-gray-100\">production</span>\n      </div>\n      <div class=\"flex items-center justify-between text-[13px]\">\n        <span class=\"text-muted-foreground dark:text-muted-foreground\">Commit</span>\n        <span class=\"font-mono text-[12px] font-medium text-foreground dark:text-gray-100\">a91f3c2</span>\n      </div>\n      <div class=\"flex items-center justify-between text-[13px]\">\n        <span class=\"text-muted-foreground dark:text-muted-foreground\">Status</span>\n        <span class=\"rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">Healthy</span>\n      </div>\n    </div>\n    <div class=\"flex items-center justify-end gap-2 border-t border-gray-200 px-4 py-2.5 dark:border-white/10\">\n      <button type=\"button\" class=\"rounded-lg px-2.5 py-1.5 text-[12.5px] font-medium text-muted-foreground transition hover:bg-gray-100 dark:text-muted-foreground dark:hover:bg-white/10\">Logs</button>\n      <button type=\"button\" class=\"rounded-lg bg-gray-900 px-2.5 py-1.5 text-[12.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Redeploy</button>\n    </div>\n  </div>\n\n  <div class=\"space-y-4\">\n    <!-- Stat card -->\n    <div class=\"rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-neutral-950\">\n      <div class=\"flex items-center justify-between\">\n        <span class=\"text-[12.5px] text-muted-foreground dark:text-muted-foreground\">Requests today</span>\n        <span class=\"flex items-center gap-0.5 text-[11.5px] font-medium text-emerald-600 dark:text-emerald-400\">\n          <svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7M9 7h8v8\" /></svg>\n          12.4%\n        </span>\n      </div>\n      <p class=\"mt-1.5 text-[26px] font-semibold tracking-tight text-foreground dark:text-gray-100\">184,203</p>\n      <div class=\"mt-3 flex h-8 items-end gap-1\">\n        <span class=\"w-full rounded-sm bg-gray-100 dark:bg-white/10\" style=\"height: 40%\"></span>\n        <span class=\"w-full rounded-sm bg-gray-100 dark:bg-white/10\" style=\"height: 65%\"></span>\n        <span class=\"w-full rounded-sm bg-gray-100 dark:bg-white/10\" style=\"height: 50%\"></span>\n        <span class=\"w-full rounded-sm bg-gray-100 dark:bg-white/10\" style=\"height: 80%\"></span>\n        <span class=\"w-full rounded-sm bg-gray-900 dark:bg-white\" style=\"height: 100%\"></span>\n      </div>\n    </div>\n\n    <!-- Interactive card -->\n    <a href=\"#\" class=\"block rounded-xl border border-gray-200 bg-white p-4 transition hover:border-gray-300 hover:bg-gray-50 dark:border-white/10 dark:bg-neutral-950 dark:hover:border-white/20 dark:hover:bg-white/5\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-muted-foreground dark:bg-white/10 dark:text-muted-foreground\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16M4 4h10l6 6v4\" /><path d=\"M14 4v6h6\" /></svg>\n        </span>\n        <span class=\"min-w-0 flex-1\">\n          <span class=\"block text-[13.5px] font-medium text-foreground dark:text-gray-100\">Browse the registry</span>\n          <span class=\"block text-[12.5px] text-muted-foreground dark:text-muted-foreground\">27 components, all HTML + Tailwind</span>\n        </span>\n        <svg class=\"h-4 w-4 shrink-0 text-muted-foreground/70 dark:text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7M9 7h8v8\" /></svg>\n      </div>\n    </a>\n  </div>\n</div>\n"
    }
  ]
}
