{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "switch-list",
  "title": "Switch List",
  "description": "Labeled toggle rows for a settings panel, including a disabled row managed by an admin.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "switch",
    "toggle",
    "settings"
  ],
  "files": [
    {
      "path": "switch-list.html",
      "type": "html",
      "content": "<!-- Switch List — Fluent UI style labeled toggle rows, restored with its own scoped theme -->\n<style>\n  .fswl-root { --bg-surface: #ffffff; --text-primary: #242424; --text-secondary: #616161; --text-muted: #707070; --border-color: #e0e0e0; --bg-hover: #f0f0f0; --fluent-brand: #0f6cbd; --fluent-switch-bg: #ffffff; --fluent-switch-border: #616161; --fluent-switch-thumb: #616161; --fluent-switch-hover-bg: #f5f5f5; }\n  .dark .fswl-root { --bg-surface: #333333; --text-primary: #ffffff; --text-secondary: #d1d1d1; --text-muted: #adadad; --border-color: #424242; --bg-hover: #3d3d3d; --fluent-brand: #479ef5; --fluent-switch-bg: #333333; --fluent-switch-border: #d1d1d1; --fluent-switch-thumb: #d1d1d1; --fluent-switch-hover-bg: #424242; }\n</style>\n\n<div class=\"fswl-root mx-auto w-full max-w-lg rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 shadow-sm\">\n  <h2 class=\"mb-2 text-[15px] font-semibold text-[var(--text-primary)]\">Notifications</h2>\n  <p class=\"mb-6 text-[13px] text-[var(--text-secondary)]\">Manage how you receive alerts and updates.</p>\n\n  <div class=\"flex flex-col rounded-lg border border-[var(--border-color)]\">\n    <div class=\"flex items-start justify-between border-b border-[var(--border-color)] p-4\">\n      <div class=\"flex flex-col gap-1 pr-6\">\n        <span class=\"text-[14px] font-medium text-[var(--text-primary)]\">Email notifications</span>\n        <span class=\"text-[13px] text-[var(--text-secondary)]\">Receive a daily summary of missed alerts in your inbox.</span>\n      </div>\n      <label class=\"fswl-track relative mt-1 inline-flex h-5 w-10 shrink-0 cursor-pointer items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)] transition-colors hover:bg-[var(--fluent-switch-hover-bg)] has-checked:hover:opacity-90\">\n        <input type=\"checkbox\" class=\"peer sr-only\" checked />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent transition-colors peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] transition-transform peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n\n    <div class=\"flex items-start justify-between border-b border-[var(--border-color)] p-4\">\n      <div class=\"flex flex-col gap-1 pr-6\">\n        <span class=\"text-[14px] font-medium text-[var(--text-primary)]\">Push notifications</span>\n        <span class=\"text-[13px] text-[var(--text-secondary)]\">Get real-time alerts pushed to your mobile device or browser.</span>\n      </div>\n      <label class=\"fswl-track relative mt-1 inline-flex h-5 w-10 shrink-0 cursor-pointer items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)] transition-colors hover:bg-[var(--fluent-switch-hover-bg)] has-checked:hover:opacity-90\">\n        <input type=\"checkbox\" class=\"peer sr-only\" />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent transition-colors peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] transition-transform peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n\n    <div class=\"flex items-start justify-between bg-[var(--bg-hover)] p-4\">\n      <div class=\"flex flex-col gap-1 pr-6\">\n        <span class=\"text-[14px] font-medium text-[var(--text-muted)]\">Marketing updates</span>\n        <span class=\"text-[13px] text-[var(--text-muted)]\">Receive promotional materials. (Managed by admin)</span>\n      </div>\n      <label class=\"fswl-track relative mt-1 inline-flex h-5 w-10 shrink-0 cursor-not-allowed items-center rounded-full border border-[var(--fluent-switch-border)] bg-[var(--fluent-switch-bg)] opacity-40\">\n        <input type=\"checkbox\" class=\"peer sr-only\" disabled />\n        <span class=\"pointer-events-none absolute inset-0 rounded-full bg-transparent peer-checked:border-[var(--fluent-brand)] peer-checked:bg-[var(--fluent-brand)]\"></span>\n        <span class=\"pointer-events-none relative h-3 w-3 translate-x-[3px] rounded-full bg-[var(--fluent-switch-thumb)] peer-checked:translate-x-[23px] peer-checked:bg-white\"></span>\n      </label>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
