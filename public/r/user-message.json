{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "user-message",
  "title": "User Message",
  "description": "The sent turn: a plain bubble and a richer variant with an attached file, timestamp, and edit/copy actions.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "message",
    "bubble",
    "user"
  ],
  "files": [
    {
      "path": "user-message.html",
      "type": "html",
      "content": "<!-- User Message — sent turn with attachment, edit affordance and timestamp -->\n<div class=\"mx-auto w-full max-w-2xl space-y-4\">\n  <!-- Plain -->\n  <div class=\"flex justify-end\">\n    <div class=\"max-w-[85%] rounded-2xl rounded-br-md bg-gray-100 px-3.5 py-2.5 text-[14px] leading-relaxed text-gray-900 dark:bg-white/10 dark:text-gray-100\">\n      Rewrite this endpoint to stream the response instead of buffering it.\n    </div>\n  </div>\n\n  <!-- With attachment and actions -->\n  <div class=\"flex flex-col items-end gap-1.5\">\n    <div class=\"max-w-[85%] space-y-2 rounded-2xl rounded-br-md bg-gray-100 px-3.5 py-3 dark:bg-white/10\">\n      <div class=\"flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 dark:border-white/10 dark:bg-neutral-900\">\n        <svg class=\"h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" /><path d=\"M14 2v6h6\" /></svg>\n        <span class=\"truncate text-[12.5px] font-medium text-gray-800 dark:text-gray-200\">handler.ts</span>\n        <span class=\"text-[11px] text-gray-400 dark:text-gray-500\">4.2 KB</span>\n      </div>\n      <p class=\"text-[14px] leading-relaxed text-gray-900 dark:text-gray-100\">\n        Here's the current handler — keep the error shape identical.\n      </p>\n    </div>\n    <div class=\"flex items-center gap-1.5\">\n      <span class=\"text-[11px] text-gray-400 dark:text-gray-500\">2:14 PM</span>\n      <button type=\"button\" class=\"rounded-md p-1 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200\" aria-label=\"Edit message\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z\" /></svg>\n      </button>\n      <button type=\"button\" class=\"rounded-md p-1 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200\" aria-label=\"Copy message\">\n        <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\" /><path d=\"M5 15V5a2 2 0 012-2h10\" /></svg>\n      </button>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
