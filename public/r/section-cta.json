{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-cta",
  "title": "CTA",
  "description": "A dark closing call-to-action banner with decorative gradients and dual actions.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "cta",
    "banner",
    "conversion"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-cta.html",
      "type": "html",
      "content": "<!-- CTA Section — a brand closing banner with dual actions -->\r\n<section class=\"w-full bg-background px-6 py-20\">\r\n  <div class=\"relative mx-auto max-w-4xl overflow-hidden rounded-3xl bg-brand px-10 py-16 text-center\">\r\n    <div class=\"pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-white/10\"></div>\r\n    <div class=\"pointer-events-none absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-white/10\"></div>\r\n\r\n    <div class=\"relative\">\r\n      <h2 class=\"mx-auto max-w-xl text-[34px] font-semibold leading-tight tracking-[-0.02em] text-white\">\r\n        Ready to stop babysitting deploys?\r\n      </h2>\r\n      <p class=\"mx-auto mt-4 max-w-md text-[15.5px] leading-relaxed text-white/80\">\r\n        Start free, no credit card required. Upgrade only once your team actually needs to.\r\n      </p>\r\n\r\n      <div class=\"mt-8 flex flex-wrap items-center justify-center gap-3\">\r\n        <a href=\"#\" class=\"rounded-xl bg-white px-5 py-3 text-[14.5px] font-medium text-brand transition hover:bg-white/90\">\r\n          Start building free\r\n        </a>\r\n        <a href=\"#\" class=\"rounded-xl border border-white/30 px-5 py-3 text-[14.5px] font-medium text-white transition hover:bg-white/10\">\r\n          Talk to sales\r\n        </a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\n"
    }
  ]
}
