{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "section-cta",
  "title": "CTA",
  "description": "A dark closing call-to-action banner with decorative gradients and dual actions.",
  "category": "sites",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "cta",
    "banner",
    "conversion"
  ],
  "surface": "section",
  "files": [
    {
      "path": "section-cta.html",
      "type": "html",
      "content": "<!-- CTA Section — a dark closing banner with dual actions -->\n<section class=\"w-full bg-white px-6 py-20 dark:bg-neutral-950\">\n  <div class=\"relative mx-auto max-w-4xl overflow-hidden rounded-3xl bg-gray-900 px-10 py-16 text-center dark:bg-neutral-900\">\n    <div class=\"pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-white/5\"></div>\n    <div class=\"pointer-events-none absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-white/5\"></div>\n\n    <div class=\"relative\">\n      <h2 class=\"mx-auto max-w-xl text-[34px] font-semibold leading-tight tracking-[-0.02em] text-white\">\n        Ready to stop babysitting deploys?\n      </h2>\n      <p class=\"mx-auto mt-4 max-w-md text-[15.5px] leading-relaxed text-white/60\">\n        Start free, no credit card required. Upgrade only once your team actually needs to.\n      </p>\n\n      <div class=\"mt-8 flex flex-wrap items-center justify-center gap-3\">\n        <a href=\"#\" class=\"rounded-xl bg-white px-5 py-3 text-[14.5px] font-medium text-neutral-900 transition hover:bg-gray-100\">\n          Start building free\n        </a>\n        <a href=\"#\" class=\"rounded-xl border border-white/20 px-5 py-3 text-[14.5px] font-medium text-white transition hover:bg-white/10\">\n          Talk to sales\n        </a>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ]
}
