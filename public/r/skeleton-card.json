{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "skeleton-card",
  "title": "Skeleton Card",
  "description": "A pulsing placeholder for a card — avatar, image, text lines and action buttons — shown while real content loads.",
  "category": "ui",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "skeleton",
    "loading",
    "placeholder"
  ],
  "files": [
    {
      "path": "skeleton-card.html",
      "type": "html",
      "content": "<!-- Skeleton Card — Fluent UI style, restored with its own warm-gray \"skeleton base\" theme -->\n<style>\n  .fsc-root { --bg-surface: #ffffff; --border-color: #e0e0e0; --fluent-skeleton-base: #e1dfdd; }\n  .dark .fsc-root { --bg-surface: #333333; --border-color: #424242; --fluent-skeleton-base: #484644; }\n  @keyframes fsc-pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }\n  .fsc-root .fsc-block { animation: fsc-pulse 2s cubic-bezier(0.4, 0, 0.2, 1) infinite; background-color: var(--fluent-skeleton-base); border-radius: 4px; }\n</style>\n\n<div class=\"fsc-root mx-auto w-full max-w-sm min-w-[320px] rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-4 shadow-sm\">\n  <div class=\"flex items-center gap-3\">\n    <div class=\"fsc-block h-12 w-12 shrink-0 !rounded-full\"></div>\n    <div class=\"flex flex-1 flex-col gap-2\">\n      <div class=\"fsc-block h-4 w-3/4\"></div>\n      <div class=\"fsc-block h-3 w-1/2\"></div>\n    </div>\n  </div>\n\n  <div class=\"fsc-block mt-4 aspect-video w-full !rounded-md\"></div>\n\n  <div class=\"mt-4 flex flex-col gap-2\">\n    <div class=\"fsc-block h-3 w-full\"></div>\n    <div class=\"fsc-block h-3 w-[90%]\"></div>\n    <div class=\"fsc-block h-3 w-[80%]\"></div>\n  </div>\n\n  <div class=\"mt-4 flex items-center gap-2 border-t border-[var(--border-color)] pt-4\">\n    <div class=\"fsc-block h-8 w-20 !rounded\"></div>\n    <div class=\"fsc-block h-8 w-24 !rounded\"></div>\n  </div>\n</div>\n"
    }
  ]
}
