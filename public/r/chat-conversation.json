{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "chat-conversation",
  "title": "Chat Conversation",
  "description": "A full-page thread with a user message, an expanded tool-call log, a rendered code block, and a split artifact document panel.",
  "category": "agent",
