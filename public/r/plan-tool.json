  "files": [
    {
      "path": "plan-tool.html",
      "type": "html",
      "content": "<!-- Plan Tool — proposed plan awaiting approval -->\n<div class=\"mx-auto w-full max-w-lg overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n  <div class=\"flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-3.5 py-2.5 dark:border-white/10 dark:bg-white/5\">\n    <svg class=\"h-3.5 w-3.5 shrink-0 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16v5H4zM4 13h16v7H4z\" /><path d=\"M8 6.5h.01M8 16.5h.01\" /></svg>\n    <span class=\"flex-1 text-[12.5px] font-medium text-gray-800 dark:text-gray-200\">Proposed plan</span>\n    <span class=\"rounded-full bg-amber-50 px-2 py-0.5 text-[10.5px] font-medium text-amber-700 dark:bg-amber-400/10 dark:text-amber-300\">needs approval</span>\n  </div>\n\n  <div class=\"px-3.5 py-3.5\">\n    <h4 class=\"mb-1 text-[14px] font-semibold text-gray-900 dark:text-gray-100\">Move session rotation server-side</h4>\n    <p class=\"mb-3.5 text-[12.5px] leading-relaxed text-gray-500 dark:text-gray-400\">\n      Four steps, touching three files. No schema migration required.\n    </p>\n\n    <ol class=\"space-y-3\">\n      <li class=\"flex gap-3\">\n        <span class=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gray-200 text-[10.5px] font-medium text-gray-500 dark:border-white/15 dark:text-gray-400\">1</span>\n        <div class=\"min-w-0\">\n          <p class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Add a rotation helper</p>\n          <p class=\"text-[12px] text-gray-500 dark:text-gray-400\"><code class=\"font-mono\">src/server/session.ts</code> — issue a new sid and revoke the previous one.</p>\n        </div>\n      </li>\n      <li class=\"flex gap-3\">\n        <span class=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gray-200 text-[10.5px] font-medium text-gray-500 dark:border-white/15 dark:text-gray-400\">2</span>\n        <div class=\"min-w-0\">\n          <p class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Call it from the login route</p>\n          <p class=\"text-[12px] text-gray-500 dark:text-gray-400\"><code class=\"font-mono\">src/routes/login.ts</code> — replace the client-side rotation call.</p>\n        </div>\n      </li>\n      <li class=\"flex gap-3\">\n        <span class=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gray-200 text-[10.5px] font-medium text-gray-500 dark:border-white/15 dark:text-gray-400\">3</span>\n        <div class=\"min-w-0\">\n          <p class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Drop the legacy cookie fallback</p>\n          <p class=\"text-[12px] text-gray-500 dark:text-gray-400\">Breaking for clients older than 3.2 — gated behind a flag.</p>\n        </div>\n      </li>\n      <li class=\"flex gap-3\">\n        <span class=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gray-200 text-[10.5px] font-medium text-gray-500 dark:border-white/15 dark:text-gray-400\">4</span>\n        <div class=\"min-w-0\">\n          <p class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Extend the session tests</p>\n          <p class=\"text-[12px] text-gray-500 dark:text-gray-400\"><code class=\"font-mono\">tests/session.test.ts</code> — cover rotation and revocation.</p>\n        </div>\n      </li>\n    </ol>\n  </div>\n\n  <div class=\"flex items-center justify-end gap-2 border-t border-gray-200 px-3.5 py-2.5 dark:border-white/10\">\n    <button type=\"button\" class=\"rounded-lg px-2.5 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10\">Edit plan</button>\n    <button type=\"button\" class=\"rounded-lg bg-gray-900 px-3 py-1.5 text-[12.5px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Approve &amp; run</button>\n  </div>\n</div>\n"
    }
  ]
}
