{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "image-urban-street-portrait",
  "title": "Urban Street Portrait",
  "description": "Street portrait with visible tattoos and glasses, city backdrop",
  "category": "images",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "portrait",
    "street",
    "urban",
    "menswear"
  ],
  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Head and shoulders square to camera, hair short and dyed, visible neck and hand tattoos",
      "expression": "Neutral, direct, slightly wary",
      "clothing": "Clear-framed glasses, layered jacket, chain jewellery"
    },
    "composition": {
      "shotType": "Medium close, head and shoulders",
      "angle": "Eye-level",
      "placement": "Centred",
      "distance": "Medium",
      "depthOfField": "Shallow; backdrop plain",
      "focus": "The eyes behind the glasses"
    },
    "framing": {
      "subjectScale": "Head and shoulders fill ~65% of frame width, lower three-quarters",
      "subjectBox": "Head x≈28–72%, y≈10–52%; shoulders widen to x≈5–95% by y≈78%",
      "anchors": "Eyeline at ~28% from top; chin ~48%",
      "edges": "Shoulders exit the bottom edge",
      "negativeSpace": "Upper ~10% clean backdrop"
    },
    "environment": {
      "setting": "Studio",
      "background": "Flat warm-grey backdrop",
      "depth": "Subject only"
    },
    "lighting": {
      "quality": "Soft, directional",
      "direction": "Key from camera-left, moderate fill",
      "temperature": "Neutral-warm",
      "shadows": "Moderate contrast; gentle cheek shadow"
    },
    "camera": {
      "lens": "85mm",
      "quality": "Clean, detailed skin and fabric texture, natural grade",
      "artifacts": "None",
      "aesthetic": "Portrait, street, studio, character"
    },
    "atmosphere": {
      "mood": "Self-possessed",
      "story": "A straight portrait of someone with a look already decided.",
      "micro": "Level, unhurried gaze"
    }
  },
  "files": [
    {
      "path": "image-urban-street-portrait.html",
      "type": "html",
      "content": "<!--\n  Urban Street Portrait — 928×1152 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2032256273782358153-1.jpg\"\n    alt=\"Street portrait with visible tattoos and glasses, city backdrop\"\n    width=\"928\"\n    height=\"1152\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Urban Street Portrait · 928×1152</figcaption>\n</figure>\n"
    }
  ]
}
