{
  "$schema": "https://xnsteam-ai.github.io/Html-library/r/schema.json",
  "name": "agent-chat",
  "title": "Agent Chat",
  "description": "A complete conversation shell: header with agent status, scrollable thread with an inline tool call, and a composer.",
  "category": "agent",
  "type": "html",
  "version": "0.1.0",
  "tailwind": "^4.0.0",
  "tags": [
    "chat",
    "shell",
    "conversation"
  ],
  "files": [
    {
      "path": "agent-chat.html",
      "type": "html",
      "content": "<!-- Agent Chat — full conversation shell: header, thread, composer -->\n<div class=\"mx-auto flex h-[560px] w-full max-w-3xl flex-col overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-neutral-950\">\n  <!-- Header -->\n  <header class=\"flex items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-white/10\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"flex h-6 w-6 items-center justify-center rounded-md bg-gray-900 text-[11px] font-semibold text-white dark:bg-white dark:text-neutral-900\">A</span>\n      <div class=\"flex flex-col leading-tight\">\n        <span class=\"text-[13px] font-medium text-gray-900 dark:text-gray-100\">Support agent</span>\n        <span class=\"text-[11px] text-gray-500 dark:text-gray-400\">Connected · 4 tools</span>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-1\">\n      <button type=\"button\" class=\"rounded-md p-1.5 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-gray-100\" aria-label=\"New conversation\">\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\" /></svg>\n      </button>\n      <button type=\"button\" class=\"rounded-md p-1.5 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-gray-100\" aria-label=\"Conversation settings\">\n        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"1.4\" /><circle cx=\"19\" cy=\"12\" r=\"1.4\" /><circle cx=\"5\" cy=\"12\" r=\"1.4\" /></svg>\n      </button>\n    </div>\n  </header>\n\n  <!-- Thread -->\n  <div class=\"flex-1 space-y-5 overflow-y-auto px-4 py-5\">\n    <!-- User turn -->\n    <div class=\"flex justify-end\">\n      <div class=\"max-w-[85%] rounded-2xl rounded-br-md bg-gray-100 px-3.5 py-2.5 text-[14px] leading-relaxed text-gray-900 dark:bg-white/10 dark:text-gray-100\">\n        Can you check why the nightly build started failing?\n      </div>\n    </div>\n\n    <!-- Assistant turn -->\n    <div class=\"flex gap-3\">\n      <span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-gray-200 dark:border-white/15\">\n        <svg class=\"h-3.5 w-3.5 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1.5l1.6 8.9 6.3-4.8-4.8 6.3 8.9 1.6-8.9 1.6 4.8 6.3-6.3-4.8-1.6 8.9-1.6-8.9-6.3 4.8 4.8-6.3L-.5 13.5l8.9-1.6-4.8-6.3 6.3 4.8z\" /></svg>\n      </span>\n      <div class=\"min-w-0 flex-1 space-y-3\">\n        <p class=\"text-[14px] leading-relaxed text-gray-800 dark:text-gray-200\">\n          Looking at the last three runs now — I'll check the workflow logs first.\n        </p>\n\n        <!-- Inline tool call -->\n        <div class=\"overflow-hidden rounded-lg border border-gray-200 dark:border-white/10\">\n          <div class=\"flex items-center gap-2 bg-gray-50 px-3 py-2 dark:bg-white/5\">\n            <svg class=\"h-3.5 w-3.5 text-gray-500 dark:text-gray-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17l6-6-6-6M12 19h8\" /></svg>\n            <span class=\"font-mono text-[12px] text-gray-700 dark:text-gray-300\">gh run list --limit 3</span>\n            <span class=\"ml-auto rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">done</span>\n          </div>\n          <pre class=\"overflow-x-auto bg-white px-3 py-2 font-mono text-[11.5px] leading-relaxed text-gray-600 dark:bg-neutral-950 dark:text-gray-400\">failure  nightly  main  18m ago\nfailure  nightly  main  1d ago\nsuccess  nightly  main  2d ago</pre>\n        </div>\n\n        <p class=\"text-[14px] leading-relaxed text-gray-800 dark:text-gray-200\">\n          Both failures are in the <span class=\"rounded bg-gray-100 px-1 py-0.5 font-mono text-[12.5px] text-gray-800 dark:bg-white/10 dark:text-gray-200\">e2e</span> job, at the same step. The runner image bumped Node to 22 and one dependency still pins 20.\n        </p>\n\n        <div class=\"flex items-center gap-1 pt-0.5\">\n          <button type=\"button\" class=\"rounded-md p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200\" aria-label=\"Copy response\">\n            <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\" /><path d=\"M5 15V5a2 2 0 012-2h10\" /></svg>\n          </button>\n          <button type=\"button\" class=\"rounded-md p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200\" aria-label=\"Good response\">\n            <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 11v9H4a1 1 0 01-1-1v-7a1 1 0 011-1h3zm0 0l4.5-8a2 2 0 013.7 1.3L14.5 8H19a2 2 0 012 2.3l-1.2 7A2 2 0 0117.8 19H7\" /></svg>\n          </button>\n          <button type=\"button\" class=\"rounded-md p-1.5 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/10 dark:hover:text-gray-200\" aria-label=\"Bad response\">\n            <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 13V4h3a1 1 0 011 1v7a1 1 0 01-1 1h-3zm0 0l-4.5 8a2 2 0 01-3.7-1.3L9.5 16H5a2 2 0 01-2-2.3l1.2-7A2 2 0 016.2 5H17\" /></svg>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Composer -->\n  <div class=\"border-t border-gray-200 p-3 dark:border-white/10\">\n    <div class=\"rounded-xl border border-gray-200 bg-white focus-within:border-gray-300 dark:border-white/10 dark:bg-neutral-950 dark:focus-within:border-white/20\">\n      <label for=\"agent-chat-input\" class=\"sr-only\">Message the agent</label>\n      <textarea id=\"agent-chat-input\" rows=\"2\" placeholder=\"Reply to the agent…\" class=\"w-full resize-none bg-transparent px-3.5 pt-3 text-[14px] text-gray-900 placeholder:text-gray-400 focus:outline-none dark:text-gray-100 dark:placeholder:text-gray-500\"></textarea>\n      <div class=\"flex items-center justify-between px-2.5 pb-2.5\">\n        <div class=\"flex items-center gap-1\">\n          <button type=\"button\" class=\"rounded-md p-1.5 text-gray-500 transition hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-white/10\" aria-label=\"Add attachment\">\n            <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\" /></svg>\n          </button>\n          <button type=\"button\" class=\"flex items-center gap-1 rounded-md px-2 py-1.5 text-[12.5px] font-medium text-gray-600 transition hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10\">\n            Sonnet\n            <svg class=\"h-3 w-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\" /></svg>\n          </button>\n        </div>\n        <button type=\"button\" class=\"flex h-7 w-7 items-center justify-center rounded-full bg-gray-900 text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\" aria-label=\"Send message\">\n          <svg class=\"h-3.5 w-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5 12l7-7 7 7\" /></svg>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ]
}
