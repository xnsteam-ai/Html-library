    {
      "path": "section-pricing.html",
      "type": "html",
      "content": "<!--\r\n  Pricing Section — three tiers with a working monthly/yearly toggle.\r\n  A hidden radio pair holds the billing period; the prices swap via\r\n  `group-has-[#id:checked]`. No JavaScript.\r\n-->\r\n<section class=\"group/pricing w-full bg-white px-6 py-24 dark:bg-neutral-950\">\r\n  <input type=\"radio\" name=\"section-pricing-billing\" id=\"section-pricing-monthly\" class=\"sr-only\" />\r\n  <input type=\"radio\" name=\"section-pricing-billing\" id=\"section-pricing-yearly\" class=\"sr-only\" checked />\r\n\r\n  <div class=\"mx-auto max-w-5xl\">\r\n    <div class=\"text-center\">\r\n      <h2 class=\"text-[38px] font-semibold leading-tight tracking-[-0.02em] text-gray-900 dark:text-gray-100\">\r\n        Simple, predictable pricing\r\n      </h2>\r\n      <p class=\"mx-auto mt-4 max-w-lg text-[16px] leading-relaxed text-gray-500 dark:text-gray-400\">\r\n        Every plan includes unlimited preview deploys. Upgrade when your team does.\r\n      </p>\r\n\r\n      <div class=\"mt-8 inline-flex items-center gap-3\">\r\n        <div class=\"flex rounded-full bg-gray-100 p-[3px] dark:bg-white/10\" role=\"radiogroup\" aria-label=\"Billing period\">\r\n          <label for=\"section-pricing-monthly\" class=\"cursor-pointer rounded-full px-4 py-1.5 text-[13px] font-medium text-gray-500 transition group-has-[#section-pricing-monthly:checked]/pricing:bg-white group-has-[#section-pricing-monthly:checked]/pricing:text-gray-900 group-has-[#section-pricing-monthly:checked]/pricing:shadow-sm dark:text-gray-400 dark:group-has-[#section-pricing-monthly:checked]/pricing:bg-neutral-900 dark:group-has-[#section-pricing-monthly:checked]/pricing:text-gray-100\">Monthly</label>\r\n          <label for=\"section-pricing-yearly\" class=\"cursor-pointer rounded-full px-4 py-1.5 text-[13px] font-medium text-gray-500 transition group-has-[#section-pricing-yearly:checked]/pricing:bg-white group-has-[#section-pricing-yearly:checked]/pricing:text-gray-900 group-has-[#section-pricing-yearly:checked]/pricing:shadow-sm dark:text-gray-400 dark:group-has-[#section-pricing-yearly:checked]/pricing:bg-neutral-900 dark:group-has-[#section-pricing-yearly:checked]/pricing:text-gray-100\">Yearly</label>\r\n        </div>\r\n        <span class=\"rounded-full bg-emerald-50 px-2.5 py-1 text-[11.5px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400\">Save 20%</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"mt-12 grid gap-5 lg:grid-cols-3\">\r\n      <!-- Hobby -->\r\n      <div class=\"rounded-2xl border border-gray-200 p-7 dark:border-white/10\">\r\n        <h3 class=\"text-[16px] font-semibold text-gray-900 dark:text-gray-100\">Hobby</h3>\r\n        <p class=\"mt-1.5 text-[13.5px] text-gray-500 dark:text-gray-400\">For side projects and experiments.</p>\r\n        <p class=\"mt-6 flex items-baseline gap-1\">\r\n          <span class=\"text-[40px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">$0</span>\r\n          <span class=\"text-[13.5px] text-gray-500 dark:text-gray-400\">/month</span>\r\n        </p>\r\n        <a href=\"#\" class=\"mt-6 block rounded-xl border border-gray-200 py-2.5 text-center text-[14px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">Get started</a>\r\n        <ul class=\"mt-7 space-y-3\">\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            1 concurrent build\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            100 GB bandwidth\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            Community support\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- Pro, featured -->\r\n      <div class=\"relative rounded-2xl border-2 border-gray-900 p-7 dark:border-white\">\r\n        <span class=\"absolute -top-3 left-7 rounded-full bg-gray-900 px-2.5 py-1 text-[11px] font-medium text-white dark:bg-white dark:text-neutral-900\">Most popular</span>\r\n        <h3 class=\"text-[16px] font-semibold text-gray-900 dark:text-gray-100\">Pro</h3>\r\n        <p class=\"mt-1.5 text-[13.5px] text-gray-500 dark:text-gray-400\">For teams shipping every day.</p>\r\n        <p class=\"mt-6 flex items-baseline gap-1\">\r\n          <span class=\"hidden text-[40px] font-semibold tracking-tight text-gray-900 group-has-[#section-pricing-monthly:checked]/pricing:inline dark:text-gray-100\">$30</span>\r\n          <span class=\"hidden text-[40px] font-semibold tracking-tight text-gray-900 group-has-[#section-pricing-yearly:checked]/pricing:inline dark:text-gray-100\">$24</span>\r\n          <span class=\"text-[13.5px] text-gray-500 dark:text-gray-400\">/user /month</span>\r\n        </p>\r\n        <a href=\"#\" class=\"mt-6 block rounded-xl bg-gray-900 py-2.5 text-center text-[14px] font-medium text-white transition hover:bg-gray-700 dark:bg-white dark:text-neutral-900 dark:hover:bg-gray-200\">Start 14-day trial</a>\r\n        <ul class=\"mt-7 space-y-3\">\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            12 concurrent builds\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            1 TB bandwidth\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            Performance budgets\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            Priority support\r\n          </li>\r\n        </ul>\r\n      </div>\r\n\r\n      <!-- Enterprise -->\r\n      <div class=\"rounded-2xl border border-gray-200 p-7 dark:border-white/10\">\r\n        <h3 class=\"text-[16px] font-semibold text-gray-900 dark:text-gray-100\">Enterprise</h3>\r\n        <p class=\"mt-1.5 text-[13.5px] text-gray-500 dark:text-gray-400\">Compliance, SSO and a named contact.</p>\r\n        <p class=\"mt-6 flex items-baseline gap-1\">\r\n          <span class=\"text-[40px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Custom</span>\r\n        </p>\r\n        <a href=\"#\" class=\"mt-6 block rounded-xl border border-gray-200 py-2.5 text-center text-[14px] font-medium text-gray-800 transition hover:bg-gray-50 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5\">Talk to sales</a>\r\n        <ul class=\"mt-7 space-y-3\">\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            Unlimited builds\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            SAML SSO &amp; audit log\r\n          </li>\r\n          <li class=\"flex gap-2.5 text-[13.5px] text-gray-600 dark:text-gray-300\">\r\n            <svg class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-gray-900 dark:text-gray-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\" /></svg>\r\n            99.99% uptime SLA\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</section>\n"
    }
  ]
}
