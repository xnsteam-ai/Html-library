  "prompt": {
    "subject": {
      "age": "Adult, apparent 20s",
      "descent": "Not asserted — synthetic subject; specify explicitly when recreating.",
      "physical": "Standing in an open field, arms crossed loosely, hair tied back",
      "expression": "Neutral, looking off-camera",
      "clothing": "Black athletic crop top and leggings"
    },
    "composition": {
      "shotType": "Medium-full figure outdoors",
      "angle": "Slightly low",
      "placement": "Centred, horizon low",
      "distance": "Medium-far",
      "depthOfField": "Moderate; the field softens behind",
      "focus": "The torso and face"
    },
    "framing": {
      "subjectScale": "Figure spans ~30% of frame width, lower three-quarters",
      "subjectBox": "Figure x≈35–68%, y≈18–100%; treeline x≈0–100%, y≈25–38%",
      "anchors": "Eyeline at ~25% from top; horizon ~35%; grass from ~55%",
      "edges": "Figure exits the bottom edge; field fills both side edges",
      "negativeSpace": "Upper ~25% is overcast sky"
    },
    "environment": {
      "setting": "Open grass field",
      "background": "Tall grass, distant treeline and overcast sky",
      "depth": "Full scene — foreground grass, subject, treeline"
    },
    "lighting": {
      "quality": "Soft, broad overcast",
      "direction": "Dome light with no distinct key",
      "temperature": "Cool-neutral with green field tones",
      "shadows": "Low contrast; open shadows"
    },
    "camera": {
      "lens": "85mm",
      "quality": "Clean, natural, lightly cool grade",
      "artifacts": "None",
      "aesthetic": "Fitness, outdoor, natural light, athletic"
    },
    "atmosphere": {
      "mood": "Composed and outdoors",
      "story": "A pause during training in an open field."
    }
  },
  "files": [
    {
      "path": "image-athletic-field-portrait.html",
      "type": "html",
      "content": "<!--\n  Athletic Field Portrait — 670×1200 JPEG from the HTML Library image set.\n  The width/height attributes reserve the box so the page does not shift\n  while the file downloads.\n-->\n<figure class=\"mx-auto w-full max-w-2xl\">\n  <img\n    src=\"https://xnsteam-ai.github.io/Html-library/images/2064018946446225558-1.jpg\"\n    alt=\"Outdoor athletic portrait shot in a golden-lit open field\"\n    width=\"670\"\n    height=\"1200\"\n    class=\"h-auto w-full rounded-xl\"\n  />\n  <figcaption class=\"mt-2 text-[12px] text-gray-600 dark:text-gray-400\">Athletic Field Portrait · 670×1200</figcaption>\n</figure>\n"
    }
  ]
