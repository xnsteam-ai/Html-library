  "surface": "app",
  "files": [
    {
      "path": "app-profile-settings.html",
      "type": "html",
      "content": "<!-- App Profile & Settings — account header, stats, grouped rows, 390×844 -->\n<div class=\"flex h-[844px] w-[390px] flex-col bg-gray-50 dark:bg-neutral-950\">\n  <!-- Status bar -->\n  <div class=\"flex items-center justify-between px-6 pb-1 pt-3.5\">\n    <span class=\"text-[13px] font-semibold text-gray-900 dark:text-gray-100\">9:41</span>\n    <div class=\"flex items-center gap-1.5 text-gray-900 dark:text-gray-100\">\n      <svg class=\"h-3 w-4\" viewBox=\"0 0 18 12\" fill=\"currentColor\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\" /><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"1\" /><rect x=\"10\" y=\"2\" width=\"3\" height=\"10\" rx=\"1\" /><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\" opacity=\"0.35\" /></svg>\n      <svg class=\"h-3 w-6\" viewBox=\"0 0 26 12\" fill=\"none\"><rect x=\"0.5\" y=\"0.5\" width=\"21\" height=\"11\" rx=\"3\" stroke=\"currentColor\" opacity=\"0.4\" /><rect x=\"2\" y=\"2\" width=\"15\" height=\"8\" rx=\"1.5\" fill=\"currentColor\" /></svg>\n    </div>\n  </div>\n\n  <header class=\"flex items-center justify-between px-5 py-3\">\n    <h1 class=\"text-[19px] font-semibold tracking-tight text-gray-900 dark:text-gray-100\">Profile</h1>\n    <button type=\"button\" class=\"rounded-full p-2 text-gray-500 transition hover:bg-gray-200/60 dark:text-gray-400 dark:hover:bg-white/10\" aria-label=\"Settings\">\n      <svg class=\"h-4.5 w-4.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\" /><path d=\"M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.7 1.7 0 008 19.4a1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H2a2 2 0 110-4h.1A1.7 1.7 0 004.6 8a1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V2a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H22a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z\" /></svg>\n    </button>\n  </header>\n\n  <div class=\"flex-1 space-y-4 overflow-hidden px-5\">\n    <!-- Identity -->\n    <div class=\"flex flex-col items-center rounded-2xl bg-white px-5 py-6 dark:bg-neutral-900\">\n      <span class=\"flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-indigo-500 text-[26px] font-semibold text-white\">R</span>\n      <h2 class=\"mt-3 text-[18px] font-semibold text-gray-900 dark:text-gray-100\">Rina Delgado</h2>\n      <p class=\"text-[13px] text-gray-500 dark:text-gray-400\">rina@example.com</p>\n      <span class=\"mt-2 rounded-full bg-gray-900 px-3 py-1 text-[11.5px] font-medium text-white dark:bg-white dark:text-neutral-900\">Pro member</span>\n\n      <div class=\"mt-5 flex w-full\">\n        <div class=\"flex-1 text-center\">\n          <p class=\"text-[17px] font-semibold text-gray-900 dark:text-gray-100\">248</p>\n          <p class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">Projects</p>\n        </div>\n        <div class=\"w-px bg-gray-100 dark:bg-white/10\"></div>\n        <div class=\"flex-1 text-center\">\n          <p class=\"text-[17px] font-semibold text-gray-900 dark:text-gray-100\">1.2k</p>\n          <p class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">Followers</p>\n        </div>\n        <div class=\"w-px bg-gray-100 dark:bg-white/10\"></div>\n        <div class=\"flex-1 text-center\">\n          <p class=\"text-[17px] font-semibold text-gray-900 dark:text-gray-100\">86</p>\n          <p class=\"text-[11.5px] text-gray-500 dark:text-gray-400\">Following</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Preferences group -->\n    <div class=\"overflow-hidden rounded-2xl bg-white dark:bg-neutral-900\">\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M18 8a6 6 0 10-12 0c0 7-3 8-3 8h18s-3-1-3-8M13.7 21a2 2 0 01-3.4 0\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] text-gray-900 dark:text-gray-100\">Notifications</span>\n        <span class=\"flex h-6 w-10 items-center rounded-full bg-gray-900 p-0.5 dark:bg-white\">\n          <span class=\"ml-auto h-5 w-5 rounded-full bg-white dark:bg-neutral-900\"></span>\n        </span>\n      </div>\n      <div class=\"h-px bg-gray-100 dark:bg-white/5\"></div>\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M12 3a6 6 0 000 12 9 9 0 11-9-9 6 6 0 019-3z\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] text-gray-900 dark:text-gray-100\">Dark appearance</span>\n        <span class=\"flex h-6 w-10 items-center rounded-full bg-gray-200 p-0.5 dark:bg-white/15\">\n          <span class=\"h-5 w-5 rounded-full bg-white shadow-sm dark:bg-neutral-700\"></span>\n        </span>\n      </div>\n      <div class=\"h-px bg-gray-100 dark:bg-white/5\"></div>\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M3 12h18M12 3a15 15 0 010 18 15 15 0 010-18z\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] text-gray-900 dark:text-gray-100\">Language</span>\n        <span class=\"text-[13px] text-gray-400 dark:text-gray-500\">English</span>\n        <svg class=\"h-4 w-4 text-gray-300 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n      </div>\n    </div>\n\n    <!-- Account group -->\n    <div class=\"overflow-hidden rounded-2xl bg-white dark:bg-neutral-900\">\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\" /><path d=\"M8 10V7a4 4 0 018 0v3\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] text-gray-900 dark:text-gray-100\">Privacy &amp; security</span>\n        <svg class=\"h-4 w-4 text-gray-300 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n      </div>\n      <div class=\"h-px bg-gray-100 dark:bg-white/5\"></div>\n      <div class=\"flex items-center gap-3 px-4 py-3.5\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-600 dark:bg-white/10 dark:text-gray-300\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M9.1 9a3 3 0 015.8 1c0 2-3 2.5-3 4M12 17h.01\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] text-gray-900 dark:text-gray-100\">Help centre</span>\n        <svg class=\"h-4 w-4 text-gray-300 dark:text-gray-600\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\" /></svg>\n      </div>\n      <div class=\"h-px bg-gray-100 dark:bg-white/5\"></div>\n      <button type=\"button\" class=\"flex w-full items-center gap-3 px-4 py-3.5 text-left\">\n        <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-500/15 dark:text-rose-400\">\n          <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9\" /></svg>\n        </span>\n        <span class=\"flex-1 text-[14px] font-medium text-rose-600 dark:text-rose-400\">Sign out</span>\n      </button>\n    </div>\n  </div>\n\n  <div class=\"flex justify-center pb-2 pt-3\">\n    <span class=\"h-1 w-32 rounded-full bg-gray-900/80 dark:bg-white/60\"></span>\n  </div>\n</div>\n"
    }
  ]
}
