{
  "name": "html-library-mcp",
  "version": "0.2.4",
  "description": "MCP server for the HTML Library registry — 191 copy-paste components in plain HTML + Tailwind. Discovery, retrieval, portability checking, composition recipes. No React, no JavaScript.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://xnsteam-ai.github.io/Html-library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnsteam-ai/Html-library.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "html",
    "tailwind",
    "components",
    "registry"
  ],
  "bin": {
    "html-library-mcp": "./bin/html-library-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "build": "npm run sync:core && tsc -p tsconfig.json",
    "verify": "node scripts/sync-core.mjs --check && tsc --noEmit -p tsconfig.json && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node bin/html-library-mcp.mjs",
    "start:http": "node bin/html-library-mcp-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
